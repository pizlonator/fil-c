                   0, NULL, NULL, NULL,
                   G_TYPE_NONE,
                   1,
-                  G_TYPE_POINTER | G_SIGNAL_TYPE_STATIC_SCOPE);
+                  /* Fil-C: GType is a pointer in the pizlonated glib, so G_TYPE_* | G_SIGNAL_TYPE_STATIC_SCOPE
+                 is computed in uintptr_t arithmetic and cast back (the mutter/clutter pattern). */
+                  (GType) ((uintptr_t) G_TYPE_POINTER | (uintptr_t) G_SIGNAL_TYPE_STATIC_SCOPE));

 /**
  * EphyHistoryService::urls-visited:
@@ -270,8 +272,8 @@
                   0, NULL, NULL, NULL,
                   G_TYPE_NONE,
                   2,
-                  G_TYPE_STRING | G_SIGNAL_TYPE_STATIC_SCOPE,
-                  G_TYPE_STRING | G_SIGNAL_TYPE_STATIC_SCOPE);
+                  (GType) ((uintptr_t) G_TYPE_STRING | (uintptr_t) G_SIGNAL_TYPE_STATIC_SCOPE),
+                  (GType) ((uintptr_t) G_TYPE_STRING | (uintptr_t) G_SIGNAL_TYPE_STATIC_SCOPE));

   signals[URL_DELETED] =
     g_signal_new ("url-deleted",
@@ -280,7 +282,7 @@
                   0, NULL, NULL, NULL,
                   G_TYPE_NONE,
                   1,
-                  G_TYPE_POINTER | G_SIGNAL_TYPE_STATIC_SCOPE);
+                  (GType) ((uintptr_t) G_TYPE_POINTER | (uintptr_t) G_SIGNAL_TYPE_STATIC_SCOPE));

   signals[HOST_DELETED] =
     g_signal_new ("host-deleted",
@@ -289,7 +291,7 @@
                   0, NULL, NULL, NULL,
                   G_TYPE_NONE,
                   1,
-                  G_TYPE_STRING | G_SIGNAL_TYPE_STATIC_SCOPE);
+                  (GType) ((uintptr_t) G_TYPE_STRING | (uintptr_t) G_SIGNAL_TYPE_STATIC_SCOPE));

   obj_properties[PROP_HISTORY_FILENAME] =
     g_param_spec_string ("history-filename",
diff --git a/epiphany/meson.build b/epiphany/meson.build
--- a/epiphany/meson.build
+++ b/epiphany/meson.build
@@ -76,7 +76,10 @@
 webkitgtk_requirement = '>= 2.43.4'

 conf.set('GLIB_VERSION_MIN_REQUIRED', 'GLIB_VERSION_2_74')
-conf.set('GLIB_VERSION_MAX_ALLOWED', 'GLIB_VERSION_2_74')
+# Fil-C: GType is a pointer in the pizlonated glib, so the max allowed
+# GLib API level must be 2.80 or newer (the established house pattern;
+# this also enables the GLib 2.80 g_once_init_enter_pointer used below).
+conf.set('GLIB_VERSION_MAX_ALLOWED', 'GLIB_VERSION_2_80')
 conf.set('GDK_VERSION_MIN_REQUIRED', 'GDK_VERSION_4_10')
 conf.set('GDK_VERSION_MAX_ALLOWED', 'GDK_VERSION_4_12')
 conf.set('ADW_VERSION_MIN_REQUIRED', 'ADW_VERSION_1_4')
@@ -158,7 +161,8 @@
                       language: 'c')

 subdir('data')
-subdir('help')
+# Fil-C: the help docs need itstool, which the Pizlix chroot does not
+# carry (docs are not needed), so the help subdir is dropped here.
 subdir('po')
 subdir('third-party')
 subdir('lib')
