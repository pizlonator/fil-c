URL: https://dist.libuv.org/dist/v1.53.0/libuv-v1.53.0-dist.tar.gz bac496ea32e638733e559bda45ccb80b31f01d262c366795cc7034ab1fbe1a8e
Origname: libuv-1.53.0
Name: libuv

    libuv 1.53.0 rebased from 1.52.1 and converted from the deprecated
    legacy-directory mode to a URL-based projeny project.  The Fil-C
    patch is carried over from projects/libuv-1.52.1 (initial commit
    6578dde696de).  The -dist tarball is used because it is the real
    source distribution with the prebuilt configure script; the plain
    libuv-v1.53.0.tar.gz on the same server is a raw repository
    snapshot without configure.
diff --git a/libuv/src/unix/fs.c b/libuv/src/unix/fs.c
--- a/libuv/src/unix/fs.c
+++ b/libuv/src/unix/fs.c
@@ -458,30 +458,29 @@
                                  const struct iovec* bufs,
                                  size_t nbufs,
                                  off_t off,
-                                 _Atomic uintptr_t* cache,
+                                 void*_Atomic* cache,
                                  int is_pread) {
-  union {
-    int (*f)(int, const struct iovec*, uv__iovcnt, off_t);
-    void* p;
-  } u;
+  int (*f)(int, const struct iovec*, uv__iovcnt, off_t);
+  void* p;

-  u.p = (void*) atomic_load_explicit(cache, memory_order_relaxed);
-  if (u.p == NULL) {
+  p = (void*) atomic_load_explicit(cache, memory_order_relaxed);
+  if (p == NULL) {
 #ifdef RTLD_DEFAULT
     /* Try _LARGEFILE_SOURCE version of preadv/pwritev first,
      * then fall back to the plain version, for libcs like musl.
      */
-    u.p = dlsym(RTLD_DEFAULT, is_pread ? "preadv64" : "pwritev64");
-    if (u.p == NULL)
-      u.p = dlsym(RTLD_DEFAULT, is_pread ? "preadv" : "pwritev");
+    p = dlsym(RTLD_DEFAULT, is_pread ? "preadv64" : "pwritev64");
+    if (p == NULL)
+      p = dlsym(RTLD_DEFAULT, is_pread ? "preadv" : "pwritev");
     dlerror();  /* Clear errors. */
 #endif  /* RTLD_DEFAULT */
-    if (u.p == NULL)
-      u.f = is_pread ? uv__preadv_emul : uv__pwritev_emul;
-    atomic_store_explicit(cache, (uintptr_t) u.p, memory_order_relaxed);
+    if (p == NULL)
+      p = is_pread ? uv__preadv_emul : uv__pwritev_emul;
+    atomic_store_explicit(cache, p, memory_order_relaxed);
   }

-  return u.f(fd, bufs, nbufs, off);
+  f = p;
+  return f(fd, bufs, nbufs, off);
 }


@@ -489,7 +488,7 @@
                           const struct iovec* bufs,
                           size_t nbufs,
                           off_t off) {
-  static _Atomic uintptr_t cache;
+  static void*_Atomic cache;
   return uv__preadv_or_pwritev(fd, bufs, nbufs, off, &cache, /*is_pread*/1);
 }

@@ -498,7 +497,7 @@
                        const struct iovec* bufs,
                        size_t nbufs,
                        off_t off) {
-  static _Atomic uintptr_t cache;
+  static void*_Atomic cache;
   return uv__preadv_or_pwritev(fd, bufs, nbufs, off, &cache, /*is_pread*/0);
 }

diff --git a/libuv/src/unix/linux.c b/libuv/src/unix/linux.c
--- a/libuv/src/unix/linux.c
+++ b/libuv/src/unix/linux.c
@@ -516,6 +516,9 @@
 #elif defined(__powerpc64__) || defined(__ppc64__)
   /* See https://github.com/libuv/libuv/issues/4283. */
   return 0; /* Random SIGSEGV in signal handler. */
+#elif defined(__FILC__)
+  /* The io_uring API is not yet supported by Fil-C, and may never be. */
+  return 0;
 #else
   /* Ternary: unknown=0, yes=1, no=-1 */
   static _Atomic int use_io_uring;
diff --git a/libuv/src/unix/process.c b/libuv/src/unix/process.c
--- a/libuv/src/unix/process.c
+++ b/libuv/src/unix/process.c
@@ -100,7 +100,9 @@
   uv__wait_children(handle->loop);
 }

+#include <stdfil.h>

+
 int uv__process_init(uv_loop_t* loop) {
   int err;

@@ -342,7 +344,7 @@
    * them internally.
    */
   for (n = 1; n < 32; n += 1) {
-    if (n == SIGKILL || n == SIGSTOP)
+    if (n == SIGKILL || n == SIGSTOP || zis_unsafe_signal_for_handlers(n))
       continue;  /* Can't be changed. */

 #if defined(__HAIKU__)
@@ -492,6 +494,11 @@
    */
 #else
 #if !defined(__linux__) && !defined(_AIX) && !defined(__PASE__)
+  posix_spawn_works = 1;
+#elif defined(__FILC__)
+  /* FIXME: Fil-C does not support vfork (see the dash port), so skip the
+     vfork() probe below and assume posix_spawn() works.  This matches
+     libuv 1.52.1, which used posix_spawn() unconditionally on Linux. */
   posix_spawn_works = 1;
 #elif !defined(__ANDROID__)
   pid_t pid;
