URL: https://ftp.postgresql.org/pub/source/v19.0/postgresql-19.0.tar.bz2 92964fdc88d7c13efc9ca014964a73a43bb9115a62210e900a98170b65965bec
URL: https://ftp.postgresql.org/pub/source/v19.0/postgresql-19.0.tar.gz b1d663d45a4a39b10ae84f20305709bbad182129488cd801019c27246192da14
Origname: postgresql-19.0
Name: postgresql

    Just allowlist filc_allocate_without_exiting in the check that libpq doesn't call exit.
diff --git a/postgresql/src/interfaces/libpq/libpq_check.pl b/postgresql/src/interfaces/libpq/libpq_check.pl
--- a/postgresql/src/interfaces/libpq/libpq_check.pl
+++ b/postgresql/src/interfaces/libpq/libpq_check.pl
@@ -64,6 +64,12 @@
 	# builds.
 	next if /pthread_exit/;

+	# Excluding filc_allocate_without_exiting is necessary when building
+	# with Fil-C, which routes memory allocation through that function of
+	# the Fil-C runtime, and libpq may legitimately reference it since it
+	# does not terminate the host application.
+	next if /filc_allocate_without_exiting/;
+
 	# Anything containing "exit" is suspicious.
 	# (Ideally we should reject abort() too, but there are various scenarios
 	# where build toolchains insert abort() calls, e.g. to implement
