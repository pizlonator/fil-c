+	# on pizlonated_nl_get_user_hz).  glib, which has no version
+	# script, exports its forwarders by default -- that is the working
+	# pattern this matches.
+	pizlonated_*;
 	nl_cli_addr_alloc;
 	nl_cli_addr_parse;
 	nl_cli_addr_parse_broadcast;
