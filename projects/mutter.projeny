diff --git a/mutter/clutter/clutter/clutter-enum-types.c.in b/mutter/clutter/clutter/clutter-enum-types.c.in
--- a/mutter/clutter/clutter/clutter-enum-types.c.in
+++ b/mutter/clutter/clutter/clutter-enum-types.c.in
@@ -14,9 +14,9 @@
 GType
 @enum_name@_get_type (void)
 {
-  static size_t g_enum_type_id = 0;
+  static gpointer g_enum_type_id = 0; /* Fil-C: GType is pointer-sized; use the pointer variants. */

-  if (g_once_init_enter (&g_enum_type_id))
+  if (g_once_init_enter_pointer (&g_enum_type_id))
     {
       static const G@Type@Value values[] = {
 /*** END value-header ***/
@@ -32,9 +32,9 @@

       id = g_@type@_register_static (g_intern_static_string ("@EnumName@"), values);

-      g_once_init_leave (&g_enum_type_id, id);
+      g_once_init_leave_pointer (&g_enum_type_id, id);
     }

-  return g_enum_type_id;
+  return (GType) g_enum_type_id;
 }
 /*** END value-tail ***/
