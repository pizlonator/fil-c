     break;
   case CURLINFO_CAINFO:
-#ifdef CURL_CA_BUNDLE
-    *param_charp = CURL_CA_BUNDLE;
-#else
-    *param_charp = NULL;
-#endif
+    *param_charp = Curl_ca_bundle();
     break;
   default:
     return CURLE_UNKNOWN_OPTION;
