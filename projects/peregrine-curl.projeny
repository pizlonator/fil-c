   NULL, /* Hyper version */
@@ -671,6 +664,9 @@

   feature_names[n] = NULL;  /* Terminate array. */
   version_info.features = features;
+
+  version_info.cainfo = Curl_ca_bundle();
+  version_info.capath = Curl_ca_path();

   return &version_info;
 }
