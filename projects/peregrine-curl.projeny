URL: https://curl.se/download/curl-8.23.0.tar.xz c048df2e61382c619b609f94156ea73d29c96f536ff2de5abb8e9a1a871c63ac
URL: https://github.com/curl/curl/releases/download/curl-8_23_0/curl-8.23.0.tar.xz c048df2e61382c619b609f94156ea73d29c96f536ff2de5abb8e9a1a871c63ac
Origname: curl-8.23.0
Name: peregrine-curl

    curl with the Fil-C patch, plus the Peregrine (cosmo) fix: cosmo's AF_INET6 is an extern const variable whose value is selected at runtime per host OS, so it cannot be a case label; the unguarded switches in lib/curlx/inet_ntop.c and lib/curlx/inet_pton.c compare instead.  (The cosmo build configures curl with --disable-ipv6, which keeps the remaining AF_INET6 case labels out of the build; lifting that would mean hoisting the same comparison for the USE_IPV6-guarded switches in curl_addrinfo.c, ftp.c, hostip.c, doh.c, cf-socket.c and vquic.c.)

        Copyright (c) 2026 Filip Pizlo.
diff --git a/peregrine-curl/configure b/peregrine-curl/configure
--- a/peregrine-curl/configure
+++ b/peregrine-curl/configure
@@ -10710,7 +10710,7 @@
 symcode='[BCDEGRST]'

 # Regexp to match symbols that can be accessed directly from C.
-sympat='\([_A-Za-z][_A-Za-z0-9]*\)'
+sympat='\(pizlonated_[_A-Za-z][_A-Za-z0-9]*\)'

 # Define system-specific variables.
 case $host_os in
@@ -10776,14 +10776,14 @@
 # so use this general approach.
 lt_cv_sys_global_symbol_to_cdecl="$SED -n"\
 $lt_cdecl_hook\
-" -e 's/^T .* \(.*\)$/extern int \1();/p'"\
-" -e 's/^$symcode$symcode* .* \(.*\)$/extern char \1;/p'"
+" -e 's/^T .* pizlonated_\(.*\)$/extern int \1();/p'"\
+" -e 's/^$symcode$symcode* .* pizlonated_\(.*\)$/extern char \1;/p'"

 # Transform an extracted symbol line into symbol name and symbol address
 lt_cv_sys_global_symbol_to_c_name_address="$SED -n"\
 $lt_c_name_hook\
 " -e 's/^: \(.*\) .*$/  {\"\1\", (void *) 0},/p'"\
-" -e 's/^$symcode$symcode* .* \(.*\)$/  {\"\1\", (void *) \&\1},/p'"
+" -e 's/^$symcode$symcode* .* pizlonated_\(.*\)$/  {\"\1\", (void *) \&\1},/p'"

 # Transform an extracted symbol line into symbol name with lib prefix and
 # symbol address.
@@ -10791,7 +10791,7 @@
 $lt_c_name_lib_hook\
 " -e 's/^: \(.*\) .*$/  {\"\1\", (void *) 0},/p'"\
 " -e 's/^$symcode$symcode* .* \(lib.*\)$/  {\"\1\", (void *) \&\1},/p'"\
-" -e 's/^$symcode$symcode* .* \(.*\)$/  {\"lib\1\", (void *) \&\1},/p'"
+" -e 's/^$symcode$symcode* .* pizlonated_\(.*\)$/  {\"lib\1\", (void *) \&\1},/p'"

 # Handle CRLF in mingw tool chain
 opt_cr=
@@ -10867,8 +10867,8 @@
       fi

       # Make sure that we snagged all the symbols we need.
-      if $GREP ' nm_test_var$' "$nlist" >/dev/null; then
-	if $GREP ' nm_test_func$' "$nlist" >/dev/null; then
+      if $GREP ' pizlonated_nm_test_var$' "$nlist" >/dev/null; then
+	if $GREP ' pizlonated_nm_test_func$' "$nlist" >/dev/null; then
 	  cat <<_LT_EOF > conftest.$ac_ext
 /* Keep this code in sync between libtool.m4, ltmain, lt_system.h, and tests.  */
 #if defined _WIN32 || defined __CYGWIN__ || defined _WIN32_WCE
@@ -10901,7 +10901,7 @@
 {
   { "@PROGRAM@", (void *) 0 },
 _LT_EOF
-	  $SED "s/^$symcode$symcode* .* \(.*\)$/  {\"\1\", (void *) \&\1},/" < "$nlist" | $GREP -v main >> conftest.$ac_ext
+	  $SED "s/^$symcode$symcode* .* pizlonated_\(.*\)$/  {\"\1\", (void *) \&\1},/" < "$nlist" | $GREP -v main >> conftest.$ac_ext
 	  cat <<\_LT_EOF >> conftest.$ac_ext
   {0, (void *) 0}
 };
@@ -31220,7 +31220,10 @@
 fi


-  if test "$USE_LIBPSL" != "1"; then
+  # Fil-C: only error out when libpsl was explicitly requested; when
+  # auto-detecting (OPT_LIBPSL=off) a missing libpsl just means building
+  # without it, like curl 8.9.1 did.
+  if test "$OPT_LIBPSL" != "off" && test "$USE_LIBPSL" != "1"; then
     as_fn_error $? "libpsl libs and/or directories were not found!" "$LINENO" 5
   fi
 fi
diff --git a/peregrine-curl/configure.ac b/peregrine-curl/configure.ac
--- a/peregrine-curl/configure.ac
