 	signals[DEVICE_CHANGED] =
 		g_signal_new ("device-changed",
@@ -389,7 +391,7 @@
 			      G_STRUCT_OFFSET (GsdDeviceManagerClass, device_changed),
 			      NULL, NULL, NULL,
 			      G_TYPE_NONE, 1,
-			      GSD_TYPE_DEVICE | G_SIGNAL_TYPE_STATIC_SCOPE);
