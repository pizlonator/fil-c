+#ifdef GDK_WINDOWING_X11
 #include <gdk/x11/gdkx.h>

 #include <sys/types.h>
 #include <X11/Xatom.h>
 #include <X11/extensions/XInput2.h>
+#endif

 #include "gsd-input-helper.h"
 #include "gsd-device-manager.h"
@@ -57,6 +62,7 @@
         return device_type_is_present (GSD_DEVICE_TYPE_MOUSE);
 }

+#ifdef GDK_WINDOWING_X11
 char *
 xdevice_get_device_node (int deviceid)
 {
@@ -106,3 +112,4 @@
         XFree (data);
         return NULL;
 }
+#endif /* GDK_WINDOWING_X11 */
diff --git a/gnome-control-center/panels/meson.build b/gnome-control-center/panels/meson.build
--- a/gnome-control-center/panels/meson.build
+++ b/gnome-control-center/panels/meson.build
@@ -1,36 +1,33 @@
 subdir('common')

+# Fil-C: panels whose external dependencies are not part of the pizlonated
+# system are dropped here (the panel-loader entries in
+# shell/cc-panel-loader.c are guarded by the same HAVE_* macros):
+# - color             (colord-gtk4)
+# - online-accounts   (goa-1.0 / goa-backend-1.0)
+# - printers          (cups, smbclient)
+# - privacy           (libgtop-2.0)
+# - sound             (gsound)
+# - system            (libgtop-2.0, udisks2, libpwquality, krb5)
+# - wwan              (mm-glib -- ModemManager is not pizlonated; the
+#                      network panel is BACK since Sprint C: libnm +
+#                      libnma-gtk4 are, with the panel's mobile-broadband
+#                      rows patched out)
+# - bluetooth / wacom (gnome-bluetooth-ui-3.0, libwacom)
 panels = [
   'applications',
   'background',
-  'color',
   'display',
   'keyboard',
   'mouse',
   'multitasking',
+  'network',
   'notifications',
-  'online-accounts',
   'power',
-  'printers',
-  'privacy',
   'search',
   'sharing',
-  'sound',
-  'system',
   'universal-access',
- 'wwan',
 ]
-
-if host_is_linux
-  panels += ['network']
-endif
-
-if host_is_linux_not_s390
-  panels += [
-    'bluetooth',
-    'wacom'
-  ]
-endif

 panels_list = []
 panels_libs = []
diff --git a/gnome-control-center/panels/mouse/cc-mouse-caps-helper.c b/gnome-control-center/panels/mouse/cc-mouse-caps-helper.c
--- a/gnome-control-center/panels/mouse/cc-mouse-caps-helper.c
+++ b/gnome-control-center/panels/mouse/cc-mouse-caps-helper.c
@@ -18,12 +18,21 @@
  * Author: Felipe Borges <feborges@redhat.com>
  */

+/* Fil-C: the pizlonated gtk4 is built without the X11 backend
+ * (-D x11-backend=false; pizlix is Wayland-only), so gdk/x11/gdkx.h and the
+ * XInput2 helpers do not exist.  The X11 capability checks are compiled only
+ * when GDK_WINDOWING_X11 is defined (i.e. when gtk4 has the X11 backend);
+ * on Wayland the touchpad knobs are shown unconditionally, which is what
+ * the non-X11 fallback below already did. */
+#ifdef GDK_WINDOWING_X11
 #include <gdk/x11/gdkx.h>
 #include <X11/Xatom.h>
 #include <X11/extensions/XInput2.h>
+#endif

 #include "cc-mouse-caps-helper.h"

+#ifdef GDK_WINDOWING_X11
 static gboolean
 touchpad_check_capabilities_x11 (gboolean *have_two_finger_scrolling,
                                  gboolean *have_edge_scrolling,
@@ -87,16 +96,19 @@

 	return TRUE;
 }
+#endif /* GDK_WINDOWING_X11 */

 gboolean
 cc_touchpad_check_capabilities (gboolean *have_two_finger_scrolling,
                                 gboolean *have_edge_scrolling,
                                 gboolean *have_tap_to_click)
 {
+#ifdef GDK_WINDOWING_X11
 	if (GDK_IS_X11_DISPLAY (gdk_display_get_default ()))
 		return touchpad_check_capabilities_x11 (have_two_finger_scrolling,
                                                         have_edge_scrolling,
                                                         have_tap_to_click);
+#endif /* GDK_WINDOWING_X11 */
 	/* else we unconditionally show all touchpad knobs */
         *have_two_finger_scrolling = TRUE;
         *have_edge_scrolling = TRUE;
@@ -107,6 +119,11 @@
 gboolean
 cc_synaptics_check (void)
 {
+        gboolean have_synaptics = FALSE;
+
+#ifndef GDK_WINDOWING_X11
+        return FALSE;
+#else
         GdkDisplay *gdisplay;
         Display *display;
         g_autoptr(GList) devicelist = NULL;
@@ -115,7 +132,6 @@
         int realformat;
         unsigned long nitems, bytes_after;
         unsigned char *data;
-        gboolean have_synaptics = FALSE;

         if (!GDK_IS_X11_DISPLAY (gdk_display_get_default ()))
                 return FALSE;
@@ -145,4 +161,5 @@
