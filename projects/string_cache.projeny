 // NOTE: Deriving PartialEq requires that a given string must always be interned the same way.
 pub struct Atom<Static> {
     unsafe_data: NonZeroU64,
+    // Fil-C port: for DYNAMIC_TAG atoms the heap Entry pointer is packed
+    // into unsafe_data as a plain integer, and every use of it (Clone, Drop,
+    // Deref, get_hash) cast that integer back with `as *const Entry`.
+    // Under Fil-C an integer-to-pointer cast has no pointer capability, so
+    // the first dereference of such a pointer panics the runtime ("cannot
+    // read/write pointer with null object").  First seen with librsvg's
+    // markup5ever Namespace/LocalName atoms: the XInclude namespace string
+    // is not in the static atom set, so the temporary atom built by
+    // xinclude_name!() is dynamic and its Drop refcount fetch_sub trapped.
+    // Keep a real, capability-carrying copy of the Entry pointer alongside;
+    // unsafe_data keeps the same packed value, so equality, ordering and
+    // hashing keep comparing the interned identity exactly as before.
+    dynamic_entry: *mut Entry,
     phantom: PhantomData<Static>,
 }

 // FIXME: bound removed from the struct definition before of this error for pack_static:
 // "error[E0723]: trait bounds other than `Sized` on const fn parameters are unstable"
 // https://github.com/rust-lang/rust/issues/57563
+//
+// Fil-C port: the packed-u64 representation made Atom Send+Sync
+// automatically; restore that for the dynamic_entry pointer field.  This is
+// exactly as (thread-)safe as the old representation: dynamic entries live
+// in the global DYNAMIC_SET, their refcounts are AtomicIsize, and their
+// string/hash fields are immutable after insert, so sharing an &Entry across
+// threads was already happening through the set's mutexes.
+unsafe impl<Static> Send for Atom<Static> {}
+unsafe impl<Static> Sync for Atom<Static> {}
+
 impl<Static> Atom<Static> {
     /// For the atom!() macros
     #[inline(always)]
