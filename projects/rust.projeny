+        // does not survive the trip: the read syscall then sees a pointer
+        // with a null object ("cannot write pointer with null object" from
+        // zsys_read).  Reading through a well-typed local buffer (whose
+        // pointer comes straight from the allocator) and appending the bytes
+        // into the cursor (a memcpy, which moves payload + shadow) keeps
+        // everything the pizlonator tracks consistent.  This mirrors the
+        // usermusl house pattern: bytes that the KERNEL fills stay in plain
+        // byte storage, and byte copies of possibly-pointer data go through
+        // memcpy-shaped operations.  Reads may legitimately return fewer
+        // bytes than requested, so capping the transfer at the size of the
+        // scratch buffer is within the `Read` contract; callers loop.
+        const FILC_READ_BUF_SCRATCH: usize = 8192;
+        let want = cmp::min(cursor.capacity(), READ_LIMIT);
+        let mut scratch = [0u8; FILC_READ_BUF_SCRATCH];
+        let n = self.read(&mut scratch[..cmp::min(want, FILC_READ_BUF_SCRATCH)])?;
+        cursor.append(&scratch[..n]);
         Ok(())
     }

