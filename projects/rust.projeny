-        match self.opts.optimize {
-            config::OptLevel::No => config::Lto::No,
-            _ => config::Lto::ThinLocal,
-        }
+        // Fil-C: upstream would enable "auto" ThinLTO here for optimized
+        // compiles (anything greater than O0), but ThinLTO is incompatible
+        // with the Fil-Pizlonator: the ThinLTO pre-link (bitcode writer) +
+        // post-link round-trip happens across the pizlonation boundary, and
+        // rustc's export-symbol lists handed to the LTO internalizer still
+        // use pre-pizlonation names, while the FilPizlonator has renamed every
+        // symbol in the module (`pizlonated*`).  The post-link internalizer
+        // then strips the wrong (pizlonated) entry points and codegen units
+        // come out hollow (`.text 0x0` objects, "undefined reference to
+        // `pizlonated_main'").  Default to no LTO; the Fil-Pizlonator already
+        // runs a full inliner inside every pipeline, so no-LTO codegen is
+        // still fully optimized.  An explicit `-C lto=...` still overrides
+        // this (and produces the broken link described above).
+        config::Lto::No
     }

     /// Returns the panic strategy for this compile session. If the user explicitly selected one
