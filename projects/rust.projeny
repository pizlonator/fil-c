+
+// Fil-C: Rust's aggregates (structs, enums, unions, tuples, closures,
+// coroutines) are moved around in MIR codegen exclusively with memcpys and
+// byte-offset GEPs, and their stack slots are untyped byte-array allocas.
+// Under GIMSO semantics an `llvm.memcpy` carries the pointer capabilities in
+// the shadow of the copied bytes, but an integer-typed load/store pair does
+// not: SROA widens memcpy-only alloca partitions into integer load/store
+// pairs when the alloca type gives it no better candidate, which silently
+// drops the capabilities of any pointer living in those bytes (this used to
+// miscompile `std::thread::spawn` + `join` at -O: the `pthread_t` inside
+// `std::thread::JoinHandle` was carried by memcpys only, and the capability
+// of the flight pointer handed to `pthread_join` came back null).  Clang
+// avoids this whole class of bugs because its allocas are *typed*: commit
+// 4a54ae4076b4 ("Have clang convert unions that have any pointers into
+// pointer structs") makes clang represent any union which may contain
+// pointers as an all-pointer struct, from which SROA derives pointer-typed
+// partitions for memcpy-only slices.  Since rustc's allocas are untyped,
+// there are no field types for SROA to inherit, so the Fil-C rustc must
+// create the opportunity itself: give the *alloca* an all-pointer struct
+// type (`{ ptr x N }`, packed, size- and alignment-preserving -- the clang
+// construction's byte-array tail is always empty here because size must be
+// a multiple of 8) whenever the Rust type may contain pointers.  This is
+// done at the alloca level only:
+// the aggregate's own LLVM IR type (LayoutLlvmExt::llvm_type below) is left
+// alone, since loads/stores/memcpys against the alloca are all done through
+// opaque pointers and per-field typed accesses, so the alloca type is only
+// consulted by SROA's type-driven partitioning -- exactly the clang hack's
+// mechanism.  Constants and statics keep their byte-based representation
+// (SROA only cares about allocas).
+//
+// The predicate deliberately covers *every* aggregate that may contain
+// pointers, not just unions: Rust's `union` is rare, but enums are unions in
+// all but name (each variant is a disjoint view of the same bytes, exactly
+// like a C union), and the `pthread_t` miscompile was carried by the *enum*
+// `io::Result<JoinHandle<()>>`'s payload, not by a union.
+
+/// Fil-C: does the memory representation of this layout possibly contain
+/// pointers?  This is a conservative transitive predicate over the layout's
+/// fields (and, for enums and coroutines, over every variant's fields): raw
+/// pointers, references, function pointers and `Box` make it true, and any
+/// aggregate containing such a field transitively makes it true.  Results are
+/// cached in the `CodegenCx` to bound the compile-time cost.
+pub(crate) fn filc_may_contain_pointers<'a, 'tcx>(
+    cx: &CodegenCx<'a, 'tcx>,
+    layout: TyAndLayout<'tcx>,
+) -> bool {
+    // The cache is keyed like `type_lowering`: by the `Ty` plus the variant
+    // index when the layout is a specific variant of that `Ty`.  This matters
+    // because a variant layout (from `for_variant`) still carries the *enum's*
+    // `Ty` -- keying by the `Ty` alone would let one variant's answer poison
+    // the cache for the enum itself and for the other variants.  Copy out of
+    // the RefCell before recursing so that re-entrant calls cannot conflict.
+    let key = (
+        layout.ty,
+        match layout.variants {
+            Variants::Single { index } => Some(index),
+            Variants::Multiple { .. } | Variants::Empty => None,
+        },
+    );
+    if let Some(&b) = cx.filc_ptr_maybe.borrow().get(&key) {
+        return b;
+    }
+    let b = filc_may_contain_pointers_uncached(cx, layout);
+    cx.filc_ptr_maybe.borrow_mut().insert(key, b);
+    b
+}
+
+fn filc_may_contain_pointers_uncached<'a, 'tcx>(
+    cx: &CodegenCx<'a, 'tcx>,
+    layout: TyAndLayout<'tcx>,
+) -> bool {
+    // Uninhabited types (e.g. an enum all of whose variants are uninhabited)
+    // have `Variants::Empty`: their layout has no fields, and
+    // `TyAndLayout::field` panics on them ("there is no field in
+    // Variants::Empty types").  A value of an uninhabited type never exists,
+    // so no alloca of this type can ever hold a pointer.  (change #21 never
+    // noticed this because `filc_ptr_struct_type`'s zero-size guard rejected
+    // these layouts before the predicate ran; the zhas_union annotation
+    // queries the predicate for every alloca, including uninhabited locals.)
+    if matches!(layout.variants, Variants::Empty) {
+        return false;
+    }
+    match layout.backend_repr {
+        // Scalars: pointers (including references, `Box` and function
+        // pointers) yes; integers and floats no.  SIMD vectors are always
+        // integer/float in Rust, so they never contain pointers.
+        BackendRepr::Scalar(scalar) => matches!(scalar.primitive(), Primitive::Pointer(_)),
+        BackendRepr::ScalarPair(a, b) => {
+            matches!(a.primitive(), Primitive::Pointer(_))
+                || matches!(b.primitive(), Primitive::Pointer(_))
+        }
+        BackendRepr::SimdVector { .. } => false,
+        // Memory-backed aggregates: recurse over the fields.
+        BackendRepr::Memory { .. } => {
+            // Unsized types cannot be alloca'd (and the trailing unsized
+            // field of a DST is not part of any sized aggregate), so there is
+            // no need to descend into them; note that TyAndLayout::field
+            // bugs out on some unsized type shapes, e.g. `dyn Trait`.
+            if !layout.is_sized() {
+                return false;
+            }
+            if layout.fields.index_by_increasing_offset().any(|i| {
+                filc_may_contain_pointers(cx, layout.field(cx, i))
+            }) {
+                return true;
+            }
+            // Enums (and coroutines) keep their variants' fields out of the
+            // top-level field list -- for a multi-variant enum the top-level
+            // fields contain only the tag (which `field()` reports as the
+            // discriminant scalar, possibly a pointer niche, as in
+            // `Option<&T>`); the payload fields live in the variant layouts.
+            match &layout.variants {
+                Variants::Multiple { variants, .. } => variants
+                    .indices()
+                    .any(|v| filc_may_contain_pointers(cx, layout.for_variant(cx, v))),
+                Variants::Single { .. } | Variants::Empty => false,
+            }
+        }
+    }
+}
+
+/// Fil-C: the LLVM type to use for an alloca that will hold a value of
+/// `layout`, where `size` is the size of the allocation being made (the
+/// caller may have rounded it up past `layout.size`, in which case there is
+/// no all-pointer struct of exactly that size and we keep the untyped
+/// byte-array alloca).  Returns `Some(all-pointer struct)` if and only if the
+/// type may contain pointers and it is word-multiples-of-8 sized and 8-byte
+/// aligned; otherwise the caller falls back to the untyped byte array (this
+/// is what keeps `repr(packed)` aggregates with pointers and every pure
+/// numeric aggregate on their current representation, and it is why this
+/// fix, unlike re-typing memcpy-only partitions inside SROA, cannot slow
+/// down numeric code like simdutf).
+pub(crate) fn filc_ptr_struct_type<'a, 'tcx>(
+    cx: &CodegenCx<'a, 'tcx>,
+    layout: TyAndLayout<'tcx>,
+    size: Size,
+) -> Option<&'a Type> {
+    // Guards, mirroring the constraints that make the clang hack safe:
+    //
+    // - The allocation must be exactly the value's size: a smaller typed
+    //   alloca would make SROA's out-of-type slices ill-defined, and a
+    //   larger one would lose the tail bytes.
+    // - Word multiples of the pointer size only: the all-pointer struct's
+    //   fields are `ptr`s, so a trailing remainder would have to be a byte
+    //   array tail -- which the clang hack handles, but which also means a
+    //   pointer could not live in the tail; requiring an exact word multiple
+    //   keeps every partition aligned with a `ptr` field (and is the shape
+    //   the pthread_t/slice cases actually need).
+    // - 8-byte ABI alignment or better: `repr(packed)` aggregates can have
+    //   pointers at non-8-byte-aligned offsets, for which the all-pointer
+    //   struct would produce nonsense partitions (SROA falls back to
+    //   integers for those anyway; skipping them here keeps their allocas
+    //   exactly as they were).
+    if size != layout.size
+        || size.bytes() == 0
+        || size.bytes() % 8 != 0
+        || layout.align.abi.bytes() < 8
+    {
+        return None;
+    }
+    if !filc_may_contain_pointers(cx, layout) {
+        return None;
+    }
+    // This is clang's construction from CGRecordLayoutBuilder.cpp, verbatim:
+    // `words` pointers followed by the byte-array tail, packed, with the
+    // total size asserted to equal the layout size.  The tail is always
+    // empty here because size is required to be a multiple of 8.
+    let words = size.bytes() / 8;
+    let fields: Vec<&'a Type> = (0..words).map(|_| cx.type_ptr()).collect();
+    let ty = cx.type_struct(&fields, /*Packed=*/ true);
+    // clang: assert(LayoutSize == getSize(NewStorageType)).  The struct is
+    // packed with exactly `words` pointers, so its size is words*8 == size.
+    assert_eq!(words * 8, size.bytes());
+    Some(ty)
 }

 impl<'a, 'tcx> CodegenCx<'a, 'tcx> {
