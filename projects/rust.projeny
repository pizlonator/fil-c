+    // LLVM's libunwind does when the precise information is unavailable).
+    //
+    // Fil-C: `_Unwind_FindEnclosingFunction` is not provided by libpizlo
+    // either, so it is stubbed out like the ARM EHABI branch below (nothing
+    // calls it under panic=abort).
+
+    // Fil-C: derive _Unwind_GetIPInfo from _Unwind_GetIP.
+    pub unsafe fn _Unwind_GetIPInfo(
+        ctx: *mut _Unwind_Context,
+        ip_before_insn: *mut c_int,
+    ) -> _Unwind_Word {
+        unsafe { *ip_before_insn = 0 };
+        unsafe { _Unwind_GetIP(ctx) }
+    }
+
+    // Fil-C: no-op for the same reason as in the ARM EHABI branch; libpizlo
+    // does not provide `_Unwind_FindEnclosingFunction`.
+    pub unsafe fn _Unwind_FindEnclosingFunction(pc: *mut c_void) -> *mut c_void {
+        let _ = pc;
+        core::ptr::null_mut()
     }

 } else {
diff --git a/rust/src/bootstrap/src/core/build_steps/llvm.rs b/rust/src/bootstrap/src/core/build_steps/llvm.rs
--- a/rust/src/bootstrap/src/core/build_steps/llvm.rs
+++ b/rust/src/bootstrap/src/core/build_steps/llvm.rs
@@ -1473,12 +1473,13 @@
             }
         }

-        cc_cfg.compiler(builder.cc(self.target));
-        if let Ok(cxx) = builder.cxx(self.target) {
-            cpp_cfg.compiler(cxx);
-        } else {
-            cc_cfg.compiler(builder.cc(self.target));
-        }
+        // Fil-C: build libunwind with the Fil-C compilers so that it is
+        // pizlonated like all the other code that goes into Fil-C binaries
+        // (pizlonated code calls unwinding routines through pizlonated symbol
+        // names and with the Fil-C ABI).  filcc/fil++ are found on PATH (see
+        // build_rustc.sh).
+        cc_cfg.compiler(std::path::PathBuf::from("filcc"));
+        cpp_cfg.compiler(std::path::PathBuf::from("fil++"));

         // Don't set this for clang
         // By default, Clang builds C code in GNU C17 mode.
