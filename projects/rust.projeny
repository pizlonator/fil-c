-        base.link_self_contained = crate::spec::LinkSelfContainedDefault::with_linker();
-    }
-
+    // Fil-C provides its own safety, so the sanitizer runtimes (which don't
+    // exist under Fil-C) must not be used.
+    base.supported_sanitizers = SanitizerSet::empty();
+    base.supports_xray = false;
+    // Delegate linking to the Fil-C clang driver (`filcc`), which performs the
+    // full Fil-C link: pizfix CRT (Scrt1.o/crti.o/crtbegin.o/crtend.o/crtn.o)
+    // + filc_crt.o before user objects + -L/-rpath pizfix/lib + the ld-fil1
+    // dynamic linker + -lc -lpizlo -lyolort -lyoloc -lyolom -lyolounwind.
+    // rustc resolves the bare name `filcc` itself (see filc_resolve_linker in
+    // rustc_codegen_ssa): from the directory baked in at build time
+    // (FILC_LINKER_DIR -- <fil-c-checkout>/build/bin in pizfix mode,
+    // /opt/fil/bin in optfil mode), else by walking up from the rustc binary
+    // for <checkout>/build/bin/filcc, else /opt/fil/bin/filcc, and only then
+    // falls back to the PATH (pizlix mode).  Putting Fil-C's build/bin on
+    // PATH still works too, it just no longer has to be the mechanism.
+    base.linker = Some("filcc".into());
+    // Fil-C: unwinding is implemented on the Fil-C runtime's unwinder.
+    // libpizlo (the Fil-C runtime that filcc links into every binary) provides
+    // _Unwind_RaiseException and a pizlonated landing-pad LSDA (see
+    // filc/include/pizlonated_eh_landing_pad.h), and the personality routine
+    // in library/std/src/sys/personality/gcc.rs is written against that API
+    // (it never touches _Unwind_GetIP/_Unwind_SetIP, which libpizlo does not
+    // implement).  So the panic strategy stays the default, unwind: panics
+    // print their message and unwind out of the panicking frame, catch_unwind
+    // catches them, Drop glue runs while unwinding, a panic out of main
+    // exits 101, and -C panic=abort is still available to force the abort
+    // strategy.
