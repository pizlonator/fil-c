+    // Fil-C: rustc always links with -nodefaultlibs, which makes Fil-C's
+    // driver (filcc) pick filc_mincrt.o, whose `main` starts the program
+    // without running glibc's __libc_start_main.  Without __libc_start_main
+    // the main thread's Fil-C thread state (the thread-descriptor flight
+    // pointer that every filc frame carries) is never initialized, so
+    // pthread_self() returns null and everything touching pthreads breaks
+    // (e.g. std's startup calls pthread_getattr_np, which then trips a filc
+    // safety check).  -normalcrt tells filcc to use the full filc_crt.o (which
+    // runs pizlonated __libc_start_main) even under -nodefaultlibs.
+    base.add_pre_link_args(LinkerFlavor::Gnu(Cc::Yes, Lld::No), &["-m64", "-normalcrt"]);
+    // Fil-C's pizlonator cannot accept the inline-asm stack probes and Fil-C
+    // clang does not probe stacks, so stack probing must stay off for Fil-C
+    // Rust.
+    base.stack_probes = StackProbeType::None;
     base.static_position_independent_executables = true;
