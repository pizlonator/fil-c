+        .unwrap_or(false);
+    if is_intel && !value.test(Feature::avx as u32) {
         value.unset(Feature::bmi1 as u32);
         value.unset(Feature::bmi2 as u32);
     }
+}
+
+#[allow(clippy::similar_names)]
+pub(crate) fn detect_features() -> cache::Initializer {
+    let mut value = cache::Initializer::default();
+
+    // Fil-C: fill the cache from /proc/cpuinfo (see the module documentation
+    // for why the upstream CPUID/xgetbv inline assembly cannot be used).
+    #[cfg(all(target_os = "linux", feature = "std_detect_file_io"))]
+    detect_features_from_cpuinfo(&mut value);

     value
 }
