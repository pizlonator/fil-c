+/// Fil-C: when the linker is the bare name "filcc" (the Fil-C clang driver,
+/// set by the Fil-C x86_64-unknown-linux-gnu target), resolve it to an
+/// absolute path ourselves instead of relying on PATH, trying in order:
+///
+///   1. The directory baked into the compiler at build time as
+///      FILC_LINKER_DIR (composed and exported by build_rustc_impl.sh).  In
+///      pizfix mode -- the normal Fil-C checkout -- that is
+///      <fil-c-checkout>/build/bin; in optfil mode it is /opt/fil/bin; in
+///      pizlix mode it is wherever the chroot had filcc when the compiler
+///      was built.
+///   2. Walking up from the running rustc binary looking for a sibling
+///      build/bin/filcc -- the Fil-C checkout layout (filcc lives in
+///      <checkout>/build/bin, next to the <checkout>/pizfix it drives; this
+///      is the "../build/bin relative to pizfix" rule).  This finds filcc
+///      even when the checkout is moved or reinstalled after this compiler
+///      was built.
+///   3. /opt/fil/bin/filcc, the optfil install location.
+///
+/// If none of those exist, return None and let the bare name fall through to
+/// rustc's normal PATH lookup: that is pizlix mode (filcc provided only via
+/// PATH), or -- if there is no filcc anywhere -- rustc's usual
+/// "linker `filcc` not found" error.
+///
+/// Only the EXACT bare name "filcc" is resolved (no parent component, no
+/// other file name, so `-C linker=...` and absolute paths are untouched).
+/// An existing-but-not-executable candidate is still returned: the spawn
+/// error rustc then reports for it is more informative than silently
+/// falling through to some other filcc.
+///
+/// Note the precedence when multiple filcc candidates exist: a baked or
+/// discovered filcc wins over whatever is on PATH.  That is correct by
+/// construction -- the baked filcc is the one from the checkout that built
+/// this rustc and the std it links against -- but it means that a compiler
+/// built in pizfix or optfil mode ignores a pizlix-style PATH-provided
+/// filcc (use -C linker=/path/to/filcc to override explicitly).
+fn filc_resolve_linker(linker_path: &Path) -> Option<PathBuf> {
+    if linker_path != Path::new("filcc") {
+        return None;
+    }
+
+    // 1. The directory baked at build time.  option_env! expands to None
+    //    when the compiler is built without FILC_LINKER_DIR in the
+    //    environment (e.g. a vanilla rustc build), so this arm is then
+    //    simply absent.
+    if let Some(dir) = option_env!("FILC_LINKER_DIR") {
+        let candidate = Path::new(dir).join("filcc");
+        if candidate.exists() {
+            return Some(candidate);
+        }
+    }
+
+    // 2. The Fil-C checkout layout, found by walking up from the running
+    //    rustc binary.  current_exe() canonicalizes rust-build/rustc to the
+    //    real stage1 binary under rust-build/rust/build/...; walking up from
+    //    there passes through rust-build/rust and then the checkout root,
+    //    whose build/bin/filcc we take -- wherever the checkout now lives.
+    if let Ok(exe) = env::current_exe() {
+        if let Some(exe_dir) = exe.parent() {
+            for ancestor in exe_dir.ancestors() {
+                let candidate = ancestor.join("build").join("bin").join("filcc");
+                if candidate.exists() {
+                    return Some(candidate);
+                }
+            }
+        }
+    }
+
+    // 3. The optfil install location.
+    let candidate = Path::new("/opt/fil/bin/filcc");
+    if candidate.exists() {
+        return Some(candidate.to_path_buf());
+    }
+
+    // 4. Nothing found: fall through with the bare name (PATH semantics).
+    None
+}
+
 /// This functions tries to determine the appropriate linker (and corresponding LinkerFlavor) to use
 pub fn linker_and_flavor(sess: &Session) -> (PathBuf, LinkerFlavor) {
     fn infer_from(
@@ -1962,6 +2046,41 @@
     if symbols.is_empty() {
         return;
     }
+
+    // Fil-C: the FilPizlonator renames every symbol to pizlonated variants
+    // (`pizlonatedFI<sig>_<name>`, `pizlonatedFIP<sig>_<name>`, ...) and
+    // additionally defines a `pizlonated_<name>` getter for every function
+    // and global.  The undefined references created by this synthetic object
+    // (whose purpose is to pull rlib archive members that define
+    // `#[no_mangle]`/`#[used]`/exported symbols, and to wire up the
+    // weak-lang-item circular dependency between core and std) must therefore
+    // use names that actually exist after pizlonation: the original names no
+    // longer exist, so with the original names these references can never be
+    // resolved -- they silently turn into phantom undefined imports in the
+    // dynamic symbol table of every dylib, which then fails any executable
+    // that links the dylib (`--no-allow-shlib-undefined` is the default for
+    // executables).  Reference the getters instead: a getter lives in the
+    // same object file as the renamed definition it exposes, so archive
+    // member pull-in keeps working exactly as before, and the references
+    // resolve both at dylib link time (the getters are exported by the
+    // version script, see the `pizlonated*` wildcard in linker.rs) and at
+    // final-link time for symbols provided by the allocator shim or the
+    // panic runtime.  The getters are always plain functions (even the getter
+    // of a thread-local global), so every entry becomes Text.  Exception:
+    // `rust_metadata_<crate>` symbols live in the raw metadata object, which
+    // is not compiled through LLVM and is therefore never pizlonated (no
+    // getter exists), so those keep their original names -- which resolve
+    // against the local definition in the same link.
+    let symbols: Vec<(String, SymbolExportKind)> = symbols
+        .iter()
+        .map(|(sym, _kind)| {
+            if sym.starts_with("rust_metadata_") {
+                (sym.clone(), SymbolExportKind::Text)
+            } else {
+                (format!("pizlonated_{sym}"), SymbolExportKind::Text)
+            }
+        })
+        .collect();

     let Some(mut file) = super::metadata::create_object_file(sess) else {
         return;
diff --git a/rust/compiler/rustc_codegen_ssa/src/back/linker.rs b/rust/compiler/rustc_codegen_ssa/src/back/linker.rs
--- a/rust/compiler/rustc_codegen_ssa/src/back/linker.rs
+++ b/rust/compiler/rustc_codegen_ssa/src/back/linker.rs
@@ -851,9 +851,34 @@
                     writeln!(f, "  global:")?;
                     for (sym, _) in symbols {
                         debug!("    {sym};");
-                        writeln!(f, "    {sym};")?;
+                        // Fil-C: the FilPizlonator renames every symbol to
+                        // pizlonated variants (`pizlonatedFI<sig>_<name>`,
+                        // `pizlonatedFIP<sig>_<name>`, etc.), so the version
+                        // script must list the pizlonated names instead of the
+                        // original ones (`--no-undefined-version` would fail
+                        // the link on the original names, since they no longer
+                        // exist after pizlonation).  We use wildcard patterns
+                        // because the numeric signature embedded in the names
+                        // isn't known here.
+                        writeln!(f, "    pizlonatedFI*_{sym};")?;
+                        writeln!(f, "    pizlonatedFIP*_{sym};")?;
                     }
                 }
+                // Fil-C: the FilPizlonator also emits a `pizlonated_<name>`
+                // getter for every exported function and global (cross-DSO
+                // callers reference those getters to obtain the Fil-C frame
+                // pointer), and generates per-signature weak entry thunks
+                // (pizlonated1ET*/pizlonated2ET*) that function-pointer calls
+                // may reference.  Export all pizlonated names with a single
+                // wildcard: it covers the getters, the pizlonatedFI*/
+                // pizlonatedFIP* patterns above, and the entry thunks in one
+                // line (this mirrors Fil-C's own convention, e.g. the
+                // `pizlonated*;` wildcard in projects/dbus.projeny's version
+                // script).  The explicit patterns are kept for readability;
+                // wildcards that match nothing are harmless.
+                writeln!(f, "    pizlonated*;")?;
+                writeln!(f, "    pizlonated1ET*;")?;
+                writeln!(f, "    pizlonated2ET*;")?;
                 writeln!(f, "\n  local:\n    *;\n}};")?;
             };
             if let Err(error) = res {
