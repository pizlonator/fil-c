-            enable(extended_proc_info_ecx, 21, Feature::tbm);
-            enable(extended_proc_info_ecx, 11, Feature::xop);
+    for token in flags.split(|&b| b == b' ') {
+        if token.is_empty() {
+            continue;
         }
+        for (name, feature) in FLAG_TO_FEATURE {
+            if token == name.as_bytes() {
+                value.set(*feature as u32);
+            }
+        }
     }

