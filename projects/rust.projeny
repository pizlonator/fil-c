diff --git a/rust/vendor/libc-0.2.174/src/unix/linux_like/linux/gnu/mod.rs b/rust/vendor/libc-0.2.174/src/unix/linux_like/linux/gnu/mod.rs
--- a/rust/vendor/libc-0.2.174/src/unix/linux_like/linux/gnu/mod.rs
+++ b/rust/vendor/libc-0.2.174/src/unix/linux_like/linux/gnu/mod.rs
@@ -1,7 +1,11 @@
 use crate::off64_t;
 use crate::prelude::*;

-pub type pthread_t = c_ulong;
+// Fil-C: pizfix's headers define `pthread_t` as `void *`, and under the
+// Fil-C ABI pointer-typed values cross FFI boundaries as flight-pointer
+// pairs, so the integer typedef from upstream would corrupt the thread
+// handle at every pthread_* call site.
+pub type pthread_t = *mut crate::c_void;
 pub type __priority_which_t = c_uint;
 pub type __rlimit_resource_t = c_uint;
 pub type Lmid_t = c_long;
