+        // Fil-C: the copied bytes may hold pointers, so the copy must move
+        // payload + capability shadow together.  Emit a call to the runtime's
+        // `zmemmove_builtin(dst, src, count)` -- the exact function clang
+        // emits for `memcpy`/`memmove`/`mempcpy` builtin calls (CGBuiltin.cpp)
+        // -- instead of an `llvm.memcpy`/`llvm.memmove` intrinsic.  The
+        // runtime function is a memmove (it handles overlap, so callers do not
+        // have to distinguish), it is lowered by the pizlonator like any other
+        // memmove (FilPizlonator.cpp lowers calls to it and its
+        // functionWillReturn knows it), and being an opaque call it is
+        // untouchable by the pre-pizlonation pipeline: no pass can widen it
+        // into integer-typed load/store pairs (which under GIMSO move only the
+        // payload and would drop the capabilities of the copied pointers) or
+        // into pointer-typed accesses at non-word-aligned offsets (the
+        // pizlonator requires word alignment for every pointer-typed access).
+        // A side benefit: the call's pointer arguments are plain uses of the
+        // endpoint allocas, so an alloca participating in a pointer-maybe
+        // copy escapes SROA even when its own LLVM type does not reveal
+        // pointer-ness.  The pizlonator inlines constant-count calls of this
+        // shape itself (isCallToInlineableMemmove), so small constant copies
+        // still scalarize -- capability-correctly -- at pizlonation time.
+        assert!(!flags.contains(MemFlags::NONTEMPORAL), "non-temporal memcpy not supported");
+        let size = self.intcast(size, self.type_isize(), false);
+        let ptr_ty = self.cx().type_ptr();
+        let (fty, llfn) =
+            filc_declare_void_fn(self.cx(), "zmemmove_builtin", &[ptr_ty, ptr_ty, self.cx().type_isize()]);
+        self.call(fty, None, None, llfn, &[dst, src, size], None, None);
+    }
+
