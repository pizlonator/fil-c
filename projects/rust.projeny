+#[cfg(all(target_os = "linux", feature = "std_detect_file_io"))]
+fn detect_features_from_cpuinfo(value: &mut cache::Initializer) {
+    let data = match read_file("/proc/cpuinfo") {
+        Some(data) => data,
+        None => return,
+    };
+    let flags = match first_line_value(&data, b"flags") {
+        Some(flags) => flags,
+        None => return,
+    };

