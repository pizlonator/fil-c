+    /// Fil-C: aggregates that may contain pointers get typed allocas whose
+    /// LLVM type is an all-pointer struct (`{ ptr x N }`, packed,
+    /// size/alignment preserving) -- clang's union representation hack from
+    /// CGRecordLayoutBuilder.cpp (commit 4a54ae4076b4), applied to the stack
+    /// slots rustc allocates for MIR locals and scratch spaces, which are
+    /// otherwise untyped byte arrays (see PlaceValue::alloca).  The struct
+    /// has exactly one `ptr` field per 8 bytes and never a byte-array tail:
+    /// `filc_ptr_struct_type` only fires when the allocation is exactly the
+    /// value's size, a non-zero multiple of 8 bytes, and 8-byte ABI-aligned,
+    /// so a tail would always be empty anyway -- and any aggregate that
+    /// fails those guards or the may-contain-pointers test falls back to the
+    /// plain untyped byte-array alloca.  Numeric aggregates fail the
+    /// may-contain-pointers test and keep the byte-array alloca, so this
+    /// cannot add pointer checks to numeric code.
+    ///
+    /// Since the known-issue #13 fix (clang-parity union handling) the
+    /// all-pointer struct type itself is belt-and-braces rather than the
+    /// load-bearing mechanism: every pointer-maybe aggregate alloca is ALSO
+    /// annotated with a `zhas_union` call below, which makes the alloca an
+    /// opaque escape for SROA, so SROA never partitions or re-types it at
+    /// all.  The type keeps the representation document-able and protects
+    /// the alloca should the annotation ever be optimized away; the
+    /// annotation is what actually keeps SROA's type-driven partitioning
+    /// (whose integer widening drops GIMSO capabilities and whose
+    /// pointer-typed widening could manufacture non-word-aligned capability
+    /// accesses) away from the pointer-maybe bytes.
+    fn alloca_for_layout(&mut self, size: Size, align: Align, layout: TyAndLayout<'tcx>) -> &'ll Value {
+        let may_contain_pointers = crate::type_of::filc_may_contain_pointers(self.cx(), layout);
+        // clang's `Ty.hasUnion()` only fires for aggregates that carry a
+        // union: a scalar pointer's alloca is not union-carrying, and SROA
+        // must stay free to promote it to a register (a pointer VALUE in a
+        // register carries its capability under GIMSO; only pointers AT REST
+        // in memory need conservative treatment).  ScalarPairs stay in scope:
+        // their two words rest at fixed offsets in one alloca, so a memcpy
+        // piece covering the pointer half could be widened into a
+        // non-word-aligned pointer access exactly like the aggregate shape.
+        let is_aggregate = !matches!(layout.backend_repr, abi::BackendRepr::Scalar(_));
+        let may_hold_union = may_contain_pointers && is_aggregate;
+        let llval = if let Some(ty) = filc_ptr_struct_type(self.cx(), layout, size) {
+            let mut bx = Builder::with_cx(self.cx);
+            bx.position_at_start(unsafe { llvm::LLVMGetFirstBasicBlock(self.llfn()) });
+            unsafe {
+                let alloca = llvm::LLVMBuildAlloca(bx.llbuilder, ty, UNNAMED);
+                llvm::LLVMSetAlignment(alloca, align.bytes() as c_uint);
+                // Cast to default addrspace if necessary
+                llvm::LLVMBuildPointerCast(bx.llbuilder, alloca, self.cx().type_ptr(), UNNAMED)
+            }
+        } else {
+            self.alloca(size, align)
+        };
+        if may_hold_union && size.bytes() >= 8 {
+            // Fil-C: annotate the alloca with `zhas_union(ptr)`, exactly like
+            // clang annotates every temp alloca of a union-carrying type of
+            // at least 8 bytes (CodeGenFunction::CreateTempAlloca and
+            // EmitVarAnnotations).  Rust enums are unions in all but name, so
+            // the aggregate portion of `filc_may_contain_pointers` is the
+            // union-carrying analog of clang's `QualType::hasUnion()`.  The
+            // call is a no-op at run time -- the pizlonator just erases it --
+            // but it is an opaque call use of the alloca pointer, which stops
+            // SROA (and every other pre-pizlonation optimization) from
+            // partitioning, promoting, or re-typing the alloca: an alloca
+            // that might hold pointers must never be split into pieces whose
+            // types the optimizer chose, because GIMSO memory transfers move
+            // payload + capability shadow together while typed (especially
+            // integer-typed) accesses move only the payload, and a
+            // pointer-typed widening could manufacture capability accesses at
+            // non-word-aligned offsets.  This is what broke
+            // UnixListener::bind/TcpListener::accept at -O (known-issue #13 in
+            // build_rustc-notes.md); the pizlonator's own escape analysis
+            // deliberately ignores these calls (FilPizlonator.cpp), so they
+            // only block the LLVM optimizations and cost nothing at run time.
+            // The >= 8 bytes test mirrors clang's
+            // `getTypeAllocSize(Ty) >= 8` condition (smaller objects cannot
+            // hold a pointer word anyway).  The call is inserted past the
+            // entry block's static allocas, so it necessarily comes after
+            // this alloca (which is itself a static alloca) no matter which
+            // alloca construction path was taken above.
+            let mut bx = Builder::with_cx(self.cx);
+            unsafe {
+                llvm::LLVMRustPositionBuilderPastAllocas(bx.llbuilder, self.llfn());
+            }
+            let (fty, llfn) = filc_declare_void_fn(self.cx(), "zhas_union", &[self.cx().type_ptr()]);
+            bx.call(fty, None, None, llfn, &[llval], None, None);
+        }
+        llval
+    }
