diff --git a/rust/compiler/rustc_session/src/session.rs b/rust/compiler/rustc_session/src/session.rs
--- a/rust/compiler/rustc_session/src/session.rs
+++ b/rust/compiler/rustc_session/src/session.rs
@@ -689,12 +689,20 @@
             return config::Lto::No;
         }

-        // Now we're in "defaults" territory. By default we enable ThinLTO for
