+/// Fil-C: does the memory representation of this layout possibly contain
+/// pointers?
+///
+/// This is the `rustc_ty_utils` twin of `filc_may_contain_pointers` in
+/// rustc_codegen_llvm's type_of.rs (same transitive predicate over the
+/// layout's fields and, for enums and coroutines, over every variant's
+/// fields; raw pointers, references, function pointers and `Box` make it
+/// true, and any aggregate containing such a field transitively makes it
+/// true).  It lives here because the layout *decision* below needs the
+/// answer before the layout exists for codegen to look at.
+fn filc_layout_may_contain_pointers<'tcx>(
+    cx: &LayoutCx<'tcx>,
+    layout: TyAndLayout<'tcx>,
+) -> bool {
+    match layout.backend_repr {
+        BackendRepr::Scalar(scalar) => matches!(scalar.primitive(), Primitive::Pointer(_)),
+        BackendRepr::ScalarPair(a, b) => {
+            matches!(a.primitive(), Primitive::Pointer(_))
+                || matches!(b.primitive(), Primitive::Pointer(_))
+        }
+        BackendRepr::SimdVector { .. } => false,
+        BackendRepr::Memory { .. } => {
+            if !layout.is_sized() {
+                return false;
+            }
+            // Uninhabited types (zero-variant enums and the like) have no
+            // fields to walk -- and no values, so no pointers either.
+            if matches!(layout.variants, Variants::Empty) {
+                return false;
+            }
+            if layout
+                .fields
+                .index_by_increasing_offset()
+                .any(|i| filc_layout_may_contain_pointers(cx, layout.field(cx, i)))
+            {
+                return true;
+            }
+            match &layout.variants {
+                Variants::Multiple { variants, .. } => variants
+                    .indices()
+                    .any(|v| filc_layout_may_contain_pointers(cx, layout.for_variant(cx, v))),
+                Variants::Single { .. } | Variants::Empty => false,
+            }
+        }
+    }
+}
