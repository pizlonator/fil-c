diff --git a/rust/compiler/rustc_driver_impl/src/lib.rs b/rust/compiler/rustc_driver_impl/src/lib.rs
--- a/rust/compiler/rustc_driver_impl/src/lib.rs
+++ b/rust/compiler/rustc_driver_impl/src/lib.rs
@@ -882,7 +882,23 @@
         release = &tmp;
     }

-    safe_println!("{binary} {version}");
+    // Fil-C: identify the Fil-C toolchain in the version output, exactly like
+    // clang does (clang/lib/Basic/Version.cpp's getClangFullRepositoryVersion()
+    // appends " (Fil-C 0.687 git@github.com:pizlonator/fil-c.git <hash>)" to
+    // "clang version ...").  build_rustc.sh composes the full
+    // "Fil-C <version> <repo-url> <commit-hash>" string -- the version number
+    // comes from clang's FILC_VERSION #define, the single source of truth for
+    // the Fil-C version (see versioning-checklist.md) -- exports it as the
+    // FILC_VERSION environment variable, and we bake it into the compiler here
+    // at compile time with option_env!.  When this tree is built without
+    // FILC_VERSION set (a vanilla, non-Fil-C build) nothing is appended and the
+    // output matches upstream rustc.
+    let filc_suffix = match option_env!("FILC_VERSION") {
+        Some(filc_version) => format!(" ({filc_version})"),
+        None => String::new(),
+    };
+
+    safe_println!("{binary} {version}{filc_suffix}");

     if verbose {
         safe_println!("binary: {binary}");
