+/// Fil-C (GIMSO): conservative transitive "may this layout contain a pointer
+/// word" predicate, written against `TyAbiInterface` so it can be used from
+/// the target-independent Rust-ABI adjustment.  This mirrors the codegen
+/// predicate of the same name in rustc_codegen_llvm (filc_may_contain_pointers
+/// in type_of.rs): pointers (raw pointers, references, `Box`, function
+/// pointers) make it true, `ScalarPair` if either half is a pointer, SIMD
+/// vectors never, and memory-backed aggregates recurse over their fields --
+/// with multi-variant enums (and coroutines) also checking every variant's
+/// layout, since a variant's payload fields do not appear in the top-level
+/// field list.  Unsized layouts answer false (they are never passed by value).
+fn filc_layout_may_contain_pointers<'a, Ty, C>(cx: &C, layout: TyAndLayout<'a, Ty>) -> bool
+where
+    Ty: TyAbiInterface<'a, C> + Copy,
+    C: HasDataLayout,
+{
+    match layout.backend_repr {
+        BackendRepr::Scalar(scalar) => matches!(scalar.primitive(), Primitive::Pointer(_)),
+        BackendRepr::ScalarPair(a, b) => {
+            matches!(a.primitive(), Primitive::Pointer(_))
+                || matches!(b.primitive(), Primitive::Pointer(_))
+        }
+        BackendRepr::SimdVector { .. } => false,
+        BackendRepr::Memory { .. } => {
+            if !layout.is_sized() {
+                return false;
+            }
+            let fields = layout
+                .fields
+                .index_by_increasing_offset()
+                .any(|i| filc_layout_may_contain_pointers(cx, layout.field(cx, i)));
+            if fields {
+                return true;
+            }
+            // Enums (and coroutines) keep their variants' payload fields out
+            // of the top-level field list.
+            match &layout.variants {
+                Variants::Multiple { variants, .. } => variants.indices().any(|v| {
+                    filc_layout_may_contain_pointers(cx, layout.for_variant(cx, v))
+                }),
+                Variants::Single { .. } | Variants::Empty => false,
+            }
+        }
+    }
+}
