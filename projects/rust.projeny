     // add the verifier, instrumentation, etc passes if they were requested
+    //
+    // Fil-C: no PassBuilder-built pipeline runs here, so the extension-point
+    // callbacks registered above never fire.  Apply the Fil-C pipeline-start
+    // passes (including the FilPizlonator) directly to the fresh pipeline --
+    // allocator-shim modules and the like must still pizlonate -- and then
+    // the optimizer-last pollcheck cleanup ("optimizer last" is the same
+    // place when the pipeline is otherwise empty).  rustc's own callbacks
+    // below then apply around them in the same order they would have on a
+    // PassBuilder-built pipeline (Fil-C pipeline start, rustc's pipeline
+    // start, the Fil-C optimizer-last, rustc's optimizer-last).
+    llvm::FilCAddPipelineStartPasses(MPM, OptLevel, /*IsRust=*/true);
     for (const auto &C : PipelineStartEPCallbacks)
       C(MPM, OptLevel);
+    MPM.addPass(DeleteRedundantPollchecksPass());
     for (const auto &C : OptimizerLastEPCallbacks)
 #if LLVM_VERSION_GE(20, 0)
