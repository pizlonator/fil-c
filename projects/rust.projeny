+// Fil-C: the pizlonated landing-pad data API, provided by libpizlo (the Fil-C
+// runtime).  See filc/include/pizlonated_eh_landing_pad.h.  The format is
+// private to the Fil-C compiler/runtime; only these accessors are public.
+// `_Unwind_GetLanguageSpecificData` (above) hands the personality routine a
+// `pizlonated_eh_landing_pad`; the Fil-C personality routine in
+// library/std/src/sys/personality/gcc.rs walks its action list through the
+// accessors below.  Both structs are opaque: the pizlonator emits the data,
+// libpizlo interprets it, and Rust only ever sees the accessors.  (The
+// accessor symbols are exported by libpizlo under the pizlonator's renamed
+// names -- `pizlonated_pizlonated_eh_*` -- which plain `extern "C"`
+// declarations resolve to after pizlonation, like every other `_Unwind_*`
+// declaration in this crate.)
+#[repr(C)]
+pub struct pizlonated_eh_landing_pad {
+    _private: [u8; 0],
+}
+#[repr(C)]
+pub struct pizlonated_eh_filter {
+    _private: [u8; 0],
+}
+unsafe extern "C" {
+    pub fn pizlonated_eh_landing_pad_get_num_actions(pad: *const pizlonated_eh_landing_pad) -> u32;
+    pub fn pizlonated_eh_landing_pad_get_encoded_action(
+        pad: *const pizlonated_eh_landing_pad,
+        action_index: u32,
+    ) -> i32;
+    pub fn pizlonated_eh_landing_pad_get_caught_type_by_encoded_action(
+        pad: *const pizlonated_eh_landing_pad,
+        encoded_action: i32,
+    ) -> *const c_void;
+    pub fn pizlonated_eh_landing_pad_get_filter_by_encoded_action(
+        pad: *const pizlonated_eh_landing_pad,
+        encoded_action: i32,
+    ) -> *const pizlonated_eh_filter;
+    pub fn pizlonated_eh_filter_get_num_types(filter: *const pizlonated_eh_filter) -> u32;
+    pub fn pizlonated_eh_filter_get_type(
+        filter: *const pizlonated_eh_filter,
+        index: u32,
+    ) -> *const c_void;
+}
+
+// Fil-C: libpizlo (the Fil-C runtime) does not provide these deprecated
+// libgcc APIs.  Provide the same trivial stubs that LLVM's libunwind has.
+pub unsafe fn _Unwind_GetTextRelBase(ctx: *mut _Unwind_Context) -> _Unwind_Ptr {
+    let _ = ctx;
+    core::ptr::null()
+}
+pub unsafe fn _Unwind_GetDataRelBase(ctx: *mut _Unwind_Context) -> _Unwind_Ptr {
+    let _ = ctx;
+    core::ptr::null()
+}
