+/// Fil-C: declare (or find, if already declared) a void-returning runtime
+/// helper function like `zhas_union` or `zmemmove_builtin` in the module,
+/// returning its LLVM function type and value (the call builder needs both).
+/// These are the functions clang declares via CreateRuntimeFunction
+/// (CGExpr.cpp / CGBuiltin.cpp); the pizlonator recognizes them by name plus
+/// signature (`isHasUnionFT` / `isMemmoveFT` in FilPizlonator.cpp), so the
+/// signature must be exactly `(ptr...) -> void` with an i64 for the memmove
+/// count (the pizlonator asserts IntPtrTy == i64).
+fn filc_declare_void_fn<'ll, 'tcx>(
+    cx: &CodegenCx<'ll, 'tcx>,
+    name: &str,
+    param_tys: &[&'ll Type],
+) -> (&'ll Type, &'ll Value) {
+    let fty = cx.type_func(param_tys, cx.type_void());
+    let llfn = crate::declare::declare_raw_fn(
+        cx,
+        name,
+        llvm::CallConv::CCallConv,
+        llvm::UnnamedAddr::Global,
+        llvm::Visibility::Default,
+        fty,
+    );
+    (fty, llfn)
+}
+
 impl<'a, 'll, 'tcx> BuilderMethods<'a, 'tcx> for Builder<'a, 'll, 'tcx> {
