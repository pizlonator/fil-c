+    return zexact_ptrtable_decode(lexbor_hash_entry_ids, id);
+}
+#endif
+
 #ifndef LEXBOR_DISABLE_INTERNAL_EXTERN
     LXB_EXTERN const lxb_char_t lexbor_str_res_map_lowercase[256];
     LXB_EXTERN const lxb_char_t lexbor_str_res_map_uppercase[256];
diff --git a/php/ext/lexbor/lexbor/core/hash.h b/php/ext/lexbor/lexbor/core/hash.h
--- a/php/ext/lexbor/lexbor/core/hash.h
+++ b/php/ext/lexbor/lexbor/core/hash.h
@@ -210,6 +210,31 @@
     return lexbor_dobject_allocated(hash->entries);
 }

+/*
+ * Tag, attribute and namespace IDs above the static ranges are the address of
+ * their data, static or hashed. Fil-C drops a pointer's capability when it
+ * becomes an integer, so it records each such pointer and looks it up again.
+ */
+#ifdef __FILC__
+LXB_API uintptr_t
+lexbor_hash_entry_id(const void *entry);
+
+LXB_API void *
+lexbor_hash_entry_by_id(uintptr_t id);
+#else
+lxb_inline uintptr_t
+lexbor_hash_entry_id(const void *entry)
+{
+    return (uintptr_t) entry;
+}
+
+lxb_inline void *
+lexbor_hash_entry_by_id(uintptr_t id)
+{
+    return (void *) id;
+}
+#endif
+

 #ifdef __cplusplus
 } /* extern "C" */
