diff --git a/php/Zend/zend_weakrefs.c b/php/Zend/zend_weakrefs.c
--- a/php/Zend/zend_weakrefs.c
+++ b/php/Zend/zend_weakrefs.c
@@ -52,8 +52,23 @@
 #define ZEND_WEAKREF_TAG_HT      2
 #define ZEND_WEAKREF_TAG_BARE_HT 3
 #define ZEND_WEAKREF_GET_TAG(p) (((uintptr_t) (p)) & 3)
+#ifdef __FILC__
+/* Tag with pointer arithmetic, which keeps the capability that an integer
+ * round trip would drop. Tagged pointers are aligned, so this matches | t. */
+#define ZEND_WEAKREF_GET_PTR(p) ((void *) ((char *) (p) - ZEND_WEAKREF_GET_TAG(p)))
+#define ZEND_WEAKREF_ENCODE(p, t) ((void *) ((char *) (p) + (t)))
+
+ZEND_API zexact_ptrtable *zend_weakref_objects;
+
+__attribute__((constructor)) static void zend_weakref_objects_init(void)
+{
+	/* Weak: weak references must not keep their objects alive. */
+	zend_weakref_objects = zexact_ptrtable_new_weak();
+}
+#else
 #define ZEND_WEAKREF_GET_PTR(p) ((void *) (((uintptr_t) (p)) & ~3))
 #define ZEND_WEAKREF_ENCODE(p, t) ((void *) (((uintptr_t) (p)) | (t)))
+#endif

 zend_class_entry *zend_ce_weakref;
