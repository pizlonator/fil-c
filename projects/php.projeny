diff --git a/php/Zend/zend_weakrefs.h b/php/Zend/zend_weakrefs.h
--- a/php/Zend/zend_weakrefs.h
+++ b/php/Zend/zend_weakrefs.h
@@ -57,9 +57,27 @@
