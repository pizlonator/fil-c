+{
+	/* Weak: the document keeps its nodes alive. */
+	dom_ns_decl_nodes = zexact_ptrtable_new_weak();
+}
+
+static zend_ulong dom_ns_decl_node_key(xmlNodePtr node)
+{
+	return zexact_ptrtable_encode(dom_ns_decl_nodes, node);
