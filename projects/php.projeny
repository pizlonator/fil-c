diff --git a/php/ext/opcache/shared_alloc_mmap.c b/php/ext/opcache/shared_alloc_mmap.c
--- a/php/ext/opcache/shared_alloc_mmap.c
+++ b/php/ext/opcache/shared_alloc_mmap.c
@@ -44,6 +44,14 @@
 #if defined(MAP_ANON) && !defined(MAP_ANONYMOUS)
 # define MAP_ANONYMOUS MAP_ANON
 #endif
+#ifdef __FILC__
+/* Fil-C keeps pointer capabilities per process, so a pointer one process
+ * stores in a shared mapping has none in another: an FPM worker trapped
+ * reading the hash entry of a script another worker had cached. Map the
+ * cache privately; forked workers still start from what the parent cached. */
+# undef MAP_SHARED
+# define MAP_SHARED MAP_PRIVATE
+#endif
 #if defined(MAP_ALIGNED_SUPER)
 # include <sys/types.h>
 # include <sys/sysctl.h>
@@ -241,7 +249,7 @@
 	 * (boot time config only, but enabled by default on most arches).
 	 */
 	if (requested_size >= huge_page_size && requested_size % huge_page_size == 0) {
-# if defined(__x86_64__) && defined(MAP_32BIT)
+# if defined(__x86_64__) && defined(MAP_32BIT) && !defined(__FILC__)
 		/* to got HUGE PAGES in low 32-bit address we have to reserve address
 		   space and then remap it using MAP_HUGETLB */

diff --git a/php/ext/opcache/zend_persist.c b/php/ext/opcache/zend_persist.c
--- a/php/ext/opcache/zend_persist.c
+++ b/php/ext/opcache/zend_persist.c
@@ -30,6 +30,18 @@
 #include "zend_interfaces.h"
 #include "zend_attributes.h"

+#ifdef __FILC__
+#include <stdfil.h>
+
+/* The permanent interned-string arena owns the pending class names. */
+static zexact_ptrtable *pending_ce_cache_names;
+
+__attribute__((constructor)) static void pending_ce_cache_names_init(void)
+{
+	pending_ce_cache_names = zexact_ptrtable_new_weak();
+}
+#endif
+
 #ifdef HAVE_JIT
 # include "Optimizer/zend_func_info.h"
 # include "jit/zend_jit.h"
@@ -360,7 +372,11 @@
 	ZEND_ASSERT(ZCSG(map_ptr_last) == CG(map_ptr_last));

 	ZEND_HASH_FOREACH_NUM_KEY_VAL(ZCG(pending_ce_cache), zend_ulong h, zval *zv) {
+#ifdef __FILC__
+		zend_string *type_name = zexact_ptrtable_decode(pending_ce_cache_names, h);
+#else
 		zend_string *type_name = (zend_string*)(uintptr_t)h;
+#endif

 		ZEND_ASSERT(!ZSTR_HAS_CE_CACHE(type_name));
 		GC_SET_REFCOUNT(type_name, (uint32_t)Z_LVAL_P(zv));
@@ -397,7 +413,11 @@
 	if ((GC_FLAGS(type_name) & GC_IMMUTABLE)
 	 && (GC_FLAGS(type_name) & IS_STR_PERMANENT)) {
 		ZEND_ASSERT(ZCG(pending_ce_cache) && "Must be called inside a persist window");
+#ifdef __FILC__
+		slot = zend_hash_index_lookup(ZCG(pending_ce_cache), zexact_ptrtable_encode(pending_ce_cache_names, type_name));
+#else
 		slot = zend_hash_index_lookup(ZCG(pending_ce_cache), (zend_ulong)(uintptr_t)type_name);
+#endif
 		if (Z_TYPE_P(slot) != IS_NULL) {
 			/* Already allocated earlier in this window */
 			return;
diff --git a/php/ext/shmop/shmop.c b/php/ext/shmop/shmop.c
--- a/php/ext/shmop/shmop.c
