URL: https://www.php.net/distributions/php-8.5.12.tar.xz 3707c0836a2e4c711c382814c2116c41ea7bb97f89c780da4b79a228ab45cfa9
Origname: php-8.5.12
Name: php

    PHP 8.5.12 with the Fil-C port.  (1) Capabilities: Fil-C drops a
    pointer's capability when it becomes an integer.  Weak references tag
    their payload pointers through uintptr_t, and WeakMap keys are object
    addresses shifted into integers; tag with pointer arithmetic and recover
    key objects from a weak zexact_ptrtable, which keeps the integer
    values.  Typed-property references tag their source list through the
    integer member of a union; make that member a pointer.  Lexbor, which
    PHP 8.5 builds into ext/lexbor for ext/dom and ext/uri, gives tag,
    attribute, namespace and prefix names IDs that are small integers for
    built-in names and the address of the name's data otherwise; convert
    those addresses through a weak zexact_ptrtable so Dom\HTMLDocument can
    read parsed names.  The C14N and schema namespace fixups key a
    HashTable by node address; register those nodes the same way.
    OPcache's deferred class-cache slots are keyed by interned-string
    address and cast back at commit; register those strings the same way.
    (2) Inline assembly: take Zend's portable paths for string comparison
    and zend_safe_address, use the overflow builtins instead of the asm
    goto fast_long_* arithmetic (configure's asm goto probe passes, but
    FilPizlonatorPass crashes on that callbr), use the x87 control-word asm
    in zend_float.h only on i386, spell xgetbv as the instruction instead
    of raw opcode bytes, and drop the .debug_gdb_scripts section.
    (3) Fibers: build_php.sh passes --disable-fiber-asm, so fibers use
    ucontext, which Fil-C runs on a native stack its runtime allocates; the
    fiber trampoline records where that stack starts, and
    zend_fiber_stack_base() and zend_fiber_stack_limit() measure from there
    instead of from the memory PHP allocated, for Fiber and for
    zend_test's custom fibers alike.  Fil-C's ucontext is in user glibc
    only, so this needs the glibc build.  (4) OPcache, which PHP 8.5 always
    builds in: Fil-C keeps capabilities per process, so a pointer one FPM
    worker stores in the MAP_SHARED cache has none in another; map the
    cache privately (workers inherit what the parent cached before forking;
    opcache_reset()/opcache_invalidate() become per-process).  Also skip
    the MAP_32BIT huge-page remap, which unmaps a region and maps it again
    at the same address, which Fil-C refuses.  (5) Allocator: Zend's
    allocator carves request memory out of 2 MiB chunks, so Fil-C bounds a
    PHP value only by its chunk and reuses freed values' memory inside it,
    and use after free between values goes unnoticed (the var_destroy use
    after free in unserialize() runs to completion).  Default to the
    tracked system allocator, as PHP's ASan CI uses, so each value has its
    own capability and memory_limit still works; USE_ZEND_ALLOC=1 restores
    Zend's.  Its end-of-request free recovers addresses from integer hash
    keys, which have no capability, so leave that memory to the collector,
    and it never recorded peaks, so record them for
    memory_get_peak_usage().  zend_str_tolower_dup_ex() and
    zend_str_toupper_dup_ex() wrote the copy through the source string's
    capability (source + (copy - source)), which per-value bounds catch;
    offset the copy instead.  (6) realloc: Fil-C's realloc() always
    allocates a new object and copies, and zend_string_extend() asks for
    the exact new length, so each `$s .= ...` copied the whole string and
    building a string took quadratic time (Zend/tests/concat_003.phpt ran
    for minutes).  __zend_realloc() now grows past 1 KiB by half again and
    reuses the capacity that zgetupper() reports, as Zend's allocator and
    glibc's in-place realloc do.  (7) shmop: when shmop_open() fails before
    or at shmat(), the free handler passed a NULL or (char *) -1 address to
    shmdt(), which Fil-C's wrapper rejects; skip shmdt() for those.
diff --git a/php/Zend/zend_alloc.c b/php/Zend/zend_alloc.c
--- a/php/Zend/zend_alloc.c
+++ b/php/Zend/zend_alloc.c
@@ -64,6 +64,9 @@
 #include "zend_string.h"
 #include "zend_exceptions.h"
 #include <signal.h>
+#ifdef __FILC__
+# include <stdfil.h>
+#endif

 #ifdef HAVE_UNISTD_H
 # include <unistd.h>
@@ -3332,6 +3335,17 @@
 	return SUCCESS;
 }

+#if defined(__FILC__) && ZEND_MM_STAT
+/* PHP's tracked allocator never recorded peaks, so memory_get_peak_usage()
+ * reported 0; it is the default here, and monitoring code reads it. */
+# define TRACKED_PEAK(heap) do { \
+		if ((heap)->size > (heap)->peak) (heap)->peak = (heap)->size; \
+		if ((heap)->real_size > (heap)->real_peak) (heap)->real_peak = (heap)->real_size; \
+	} while (0)
+#else
+# define TRACKED_PEAK(heap) do { } while (0)
+#endif
+
 static void *tracked_malloc(size_t size ZEND_FILE_LINE_DC ZEND_FILE_LINE_ORIG_DC)
 {
 	zend_mm_heap *heap = AG(mm_heap);
@@ -3353,6 +3367,7 @@
 	heap->size += size;
 	heap->real_size = heap->size;
 #endif
+	TRACKED_PEAK(heap);
 	return ptr;
 }

@@ -3401,10 +3416,18 @@
 	heap->size += new_size - old_size;
 	heap->real_size = heap->size;
 #endif
+	TRACKED_PEAK(heap);
 	return ptr;
 }

 static void tracked_free_all(zend_mm_heap *heap) {
+#ifdef __FILC__
+	/* The keys are addresses, and an integer cast back to a pointer has no
+	 * capability, so free() would trap. Fil-C's collector reclaims the
+	 * request's leftover allocations once nothing refers to them. */
+	(void) heap;
+	return;
+#endif
 	HashTable *tracked_allocs = heap->tracked_allocs;
 	zend_ulong h;
 	ZEND_HASH_FOREACH_NUM_KEY(tracked_allocs, h) {
@@ -3614,8 +3637,20 @@

 #if ZEND_MM_CUSTOM
 	tmp = getenv("USE_ZEND_ALLOC");
+#ifdef __FILC__
+	/* Zend's allocator carves request memory out of 2 MiB chunks, so Fil-C
+	 * bounds every PHP value only by its chunk and a freed value's memory is
+	 * reused inside it: use after free and overflows between values go
+	 * undetected. Default to the system allocator, which gives each value
+	 * its own capability, tracked so that memory_limit and
+	 * memory_get_usage() still work. USE_ZEND_ALLOC=1 selects Zend's
+	 * allocator and USE_TRACKED_ALLOC=0 untracked malloc. */
+	if (!tmp || !ZEND_ATOL(tmp)) {
+		bool tracked = !(tmp = getenv("USE_TRACKED_ALLOC")) || ZEND_ATOL(tmp);
+#else
 	if (tmp && !ZEND_ATOL(tmp)) {
 		bool tracked = (tmp = getenv("USE_TRACKED_ALLOC")) && ZEND_ATOL(tmp);
+#endif
 		zend_mm_heap *mm_heap = alloc_globals->mm_heap = malloc(sizeof(zend_mm_heap));
 		memset(mm_heap, 0, sizeof(zend_mm_heap));
 		mm_heap->use_custom_heap = ZEND_MM_CUSTOM_HEAP_STD;
@@ -3964,6 +3999,24 @@

 ZEND_API void * __zend_realloc(void *p, size_t len ZEND_FILE_LINE_DC ZEND_FILE_LINE_ORIG_DC)
 {
+#ifdef __FILC__
+	/* Fil-C's realloc() always moves the object, so growing a string one
+	 * append at a time (zend_string_extend() asks for the exact length)
+	 * copied the whole string each time: building an n-byte string took
+	 * O(n^2). Grow by half again past 1 KiB and reuse the slack, as Zend's
+	 * allocator and glibc's in-place realloc do. The capability then spans
+	 * the slack, which is zeroed, or after a shrink to no less than half the
+	 * capacity, the old contents. */
+	if (p && len) {
+		size_t cap = (char *) zgetupper(p) - (char *) p;
+		if (len <= cap && len >= cap / 2) {
+			return p;
+		}
+		if (len > cap && len > 1024 && len < cap + cap / 2) {
+			len = cap + cap / 2;
+		}
+	}
+#endif
 	p = realloc(p, len);
 	if (EXPECTED(p || !len)) {
 		return p;
diff --git a/php/Zend/zend_cpuinfo.c b/php/Zend/zend_cpuinfo.c
--- a/php/Zend/zend_cpuinfo.c
+++ b/php/Zend/zend_cpuinfo.c
@@ -81,7 +81,7 @@
 	// directly because older assemblers do not include support for xgetbv and
 	// there is no easy way to conditionally compile based on the assembler used.
 	unsigned eax, edx;
-	__asm__(".byte 0x0f, 0x01, 0xd0" : "=a"(eax), "=d"(edx) : "c"(0));
+	__asm__("xgetbv" : "=a"(eax), "=d"(edx) : "c"(0));
 	return eax;
 # elif defined(ZEND_WIN32) && defined(_XCR_XFEATURE_ENABLED_MASK)
 	return _xgetbv(_XCR_XFEATURE_ENABLED_MASK);
diff --git a/php/Zend/zend_fibers.c b/php/Zend/zend_fibers.c
--- a/php/Zend/zend_fibers.c
+++ b/php/Zend/zend_fibers.c
@@ -84,6 +84,13 @@
 	void *pointer;
 	size_t size;

+#ifdef __FILC__
+	/* Fil-C runs a ucontext on a native stack of the requested size that its
+	 * runtime allocates, not on pointer. The trampoline records where that
+	 * stack starts. */
+	void *filc_base;
+#endif
+
 #ifdef HAVE_VALGRIND
 	unsigned int valgrind_stack_id;
 #endif
@@ -348,13 +355,21 @@
 	reserve = reserve * 2;
 #endif

+#ifdef __FILC__
+	return (int8_t*)stack->filc_base - stack->size + reserve;
+#else
 	/* stack->pointer is the end of the stack */
 	return (int8_t*)stack->pointer + reserve;
+#endif
 }

 ZEND_API void* zend_fiber_stack_base(zend_fiber_stack *stack)
 {
+#ifdef __FILC__
+	return stack->filc_base;
+#else
 	return (void*)((uintptr_t)stack->pointer + stack->size);
+#endif
 }
 #endif

@@ -388,6 +403,10 @@
 	}

 	zend_fiber_context *context = EG(current_fiber_context);
+
+#ifdef __FILC__
+	context->stack->filc_base = __builtin_frame_address(0);
+#endif

 	context->function(&transfer);
 	context->status = ZEND_FIBER_STATUS_DEAD;
