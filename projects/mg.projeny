URL: https://github.com/troglobit/mg/releases/download/v4.6/mg-4.6.tar.gz cf771188b246bd3ba4e99ec74e7f317cbbe0ac60fefc7e4b0836f3466eb473d0
Origname: mg-4.6
Name: mg

    mg 4.6. The keyname() → keyseqname() build fix that mg 4.4 needed
    (ncurses' curses.h already declares keyname(int), so the prototypes
    collided) was upstreamed before 4.5, in commit
    a62108264e05f4f41047f01fa1034f21ad562c08 ("Fix #47: build failure
    with ncurses curses.h"), so the old patch rebased away to empty.

    Local patch: same disease, one release later. mg 4.5 (and still
    4.6) declares insstr() in def.h (for the comment and rectangle
    commands), and ncurses' curses.h defines insstr(s) as a macro for
    winsstr(stdscr, (s)), so the declaration expands to
    "int winsstr(stdscr,(const char *));" and every file that includes
    both headers dies with "error: expected identifier". Rename mg's
    insstr() (def.h declaration, line.c definition, comment.c and
    rect.c call sites) to insstring(), mirroring the keyname() fix.
diff --git a/mg/src/comment.c b/mg/src/comment.c
--- a/mg/src/comment.c
+++ b/mg/src/comment.c
@@ -62,13 +62,13 @@
 static int
 opencomment(void)
 {
-	return (insstr(cstart) && insstr(" "));
+	return (insstring(cstart) && insstring(" "));
 }

 static int
 closecomment(void)
 {
-	return (*cend == '\0' || (insstr(" ") && insstr(cend)));
+	return (*cend == '\0' || (insstring(" ") && insstring(cend)));
 }

 /*
diff --git a/mg/src/def.h b/mg/src/def.h
--- a/mg/src/def.h
+++ b/mg/src/def.h
@@ -515,7 +515,7 @@
 void		 lfree(struct line *);
 void		 lchange(int);
 int		 linsert(int, int);
-int		 insstr(const char *);
+int		 insstring(const char *);
 int		 insbytes(const char *, int);
 int		 lnewline_at(struct line *, int);
 int		 lnewline(void);
diff --git a/mg/src/line.c b/mg/src/line.c
--- a/mg/src/line.c
+++ b/mg/src/line.c
@@ -206,7 +206,7 @@
 }

 int
-insstr(const char *s)
+insstring(const char *s)
 {
 	return (insbytes(s, strlen(s)));
 }
diff --git a/mg/src/rect.c b/mg/src/rect.c
--- a/mg/src/rect.c
+++ b/mg/src/rect.c
@@ -236,7 +236,7 @@
 	for (i = 0; i < nrows; i++) {
 		setdot(lp, 0, lineno + i);
 		(void)tocol(col, 1);
-		if (insstr(rows[i]) != TRUE)
+		if (insstring(rows[i]) != TRUE)
 			break;
 		if (i + 1 == nrows)
 			break;
@@ -321,7 +321,7 @@
 	undo_boundary_enable(FFRAND, 0);
 	for (i = 0, lp = r.lp; i < r.nlines; i++, lp = lforw(lp)) {
 		w = span(lp, r.lineno + i, &r, 1);
-		if (ldelete(w, KNONE) != TRUE || insstr(s) != TRUE)
+		if (ldelete(w, KNONE) != TRUE || insstring(s) != TRUE)
 			break;
 	}
 	return (rect_done(&r));
