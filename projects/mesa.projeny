diff --git a/mesa/include/EGL/eglplatform.h b/mesa/include/EGL/eglplatform.h
--- a/mesa/include/EGL/eglplatform.h
+++ b/mesa/include/EGL/eglplatform.h
@@ -121,9 +121,13 @@

 #elif defined(__unix__)

-typedef void             *EGLNativeDisplayType;
-typedef khronos_uintptr_t EGLNativePixmapType;
-typedef khronos_uintptr_t EGLNativeWindowType;
+/* Fil-C: these must be real pointers.  The upstream integer-typed handles
+ * (khronos_uintptr_t) force callers to round-trip pointers through integers,
+ * which loses the pointer's object metadata and makes every EGL entry point
+ * that takes a native window/pixmap dereference a null-object pointer. */
+typedef void *EGLNativeDisplayType;
+typedef void *EGLNativePixmapType;
+typedef void *EGLNativeWindowType;

 #elif defined(__APPLE__)

