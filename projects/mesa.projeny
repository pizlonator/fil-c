+ * gallivm and the Fil-C LLVM JIT session API (filc_llvm_jit.h).
+ *
  * some shaders use function pointers incorrectly so can't be relinked
  * properly. (mostly the fallback fetch shaders).
  * We should fix them, but the dont_cache flag can be set for now,
  * so they don't end up getting cached at all.
+ *
+ * Under the Fil-C JIT there is no object cache at all, so lp_cached_code
+ * stays structurally (fields are referenced across the tree) but is always
+ * empty and the shader disk cache silently disables.
  */
 struct lp_cached_code {
    void *data;
@@ -55,39 +61,41 @@

