diff --git a/mesa/src/gallium/auxiliary/gallivm/lp_bld_misc.c b/mesa/src/gallium/auxiliary/gallivm/lp_bld_misc.c
new file mode 100644
--- /dev/null
+++ b/mesa/src/gallium/auxiliary/gallivm/lp_bld_misc.c
@@ -0,0 +1,213 @@
+/**************************************************************************
+ *
+ * Copyright 2010 VMware, Inc.
+ * All Rights Reserved.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
+ * copy of this software and associated documentation files (the
+ * "Software"), to deal in the Software without restriction, including
+ * without limitation the rights to use, copy, modify, merge, publish,
+ * distribute, sub license, and/or sell copies of the Software, and to
+ * permit persons to whom the Software is furnished to do so, subject to
+ * the following conditions:
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NON-INFRINGEMENT. IN NO EVENT SHALL
+ * THE COPYRIGHT HOLDERS, AUTHORS AND/OR ITS SUPPLIERS BE LIABLE FOR ANY CLAIM,
+ * DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR
+ * OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE
+ * USE OR OTHER DEALINGS IN THE SOFTWARE.
+ *
+ * The above copyright notice and this permission notice (including the
+ * next paragraph) shall be included in all copies or substantial portions
+ * of the Software.
+ *
+ **************************************************************************/
+
+
+/*
+ * Fil-C port: this used to be lp_bld_misc.cpp, the only C++ file in
+ * gallivm, which drove MCJIT through the LLVM C++ API (EngineBuilder,
+ * MAttrs/MCPU, SectionMemoryManager, LPObjectCache, ...).  Under the
+ * Fil-C LLVM JIT none of that machinery exists or is needed:
+ *
+ * - the JIT targets detectHost() (march=native) itself, so the MAttrs /
+ *   MCPU logic is gone;
+ * - code sections are allocated by the Fil-C runtime (GC-visible),
+ *   so the memory manager / lp_generated_code bookkeeping is gone;
+ * - there is no object cache: lp_cached_code stays structurally but is
+ *   always empty and mesa's shader disk cache silently disables;
+ * - the LLVM C++ API cannot be reached from Fil-C code, so this file is
+ *   now plain C speaking only the curated LLVM-C subset from
+ *   filc_llvm_jit.h plus the FilLLVMJIT_* session API.
+ */
+
+#include <stdio.h>
+#include <string.h>
+
+#include "util/u_debug.h"
+#include "util/u_memory.h"
+#include "util/os_time.h"
+
+#include "lp_bld_misc.h"
+#include "lp_bld_init.h"
+
+#include <filc_llvm_jit.h>
+
+
+void
+lp_set_target_options(void)
+{
+   /* Fil-C: the JIT shim initializes the native target itself
+    * (initOnce() inside the shim, on first compile).  Nothing to do. */
+}
+
+
+unsigned
+lp_gallivm_add_hook(struct gallivm_state *gallivm, const char *name,
+                    const void *ptr)
+{
+   unsigned i;
+
+   for (i = 0; i < gallivm->num_hooks; i++) {
+      if (strcmp(gallivm->hooks[i].name, name) == 0) {
+         assert(gallivm->hooks[i].ptr == ptr);
+         return i;
+      }
+   }
+   assert(gallivm->num_hooks < LP_GALLIVM_MAX_HOOKS);
+   gallivm->hooks[gallivm->num_hooks].name = name;
+   gallivm->hooks[gallivm->num_hooks].ptr = ptr;
+   gallivm->num_hooks++;
+   return gallivm->num_hooks - 1;
+}
+
+
+/* Fil-C: declare a call target for a HOST function in the module.
+ *
+ * Upstream built an inttoptr-of-constant "function pointer constant" for
+ * this (lp_build_const_func_pointer), which MCJIT resolved by raw address.
+ * The Fil-C JIT cannot bless such a constant: an inttoptr of a plain
+ * integer constant yields a pointer without a capability, and calling
+ * through it panics.  Instead we declare a named extern function and map
+ * the name to the host pointer via FilLLVMJIT_SetGlobalMapping at compile
+ * time (see lp_build_jit_compile_for_module).  Same call ABI, capability-
+ * checked by the runtime like any mapped hook. */
+LLVMValueRef
+lp_build_decl_mapped_fn(struct gallivm_state *gallivm, const char *name,
+                        const void *host_fn, LLVMTypeRef function_type)
+{
+   LLVMValueRef fn = LLVMGetNamedFunction(gallivm->module, name);
+
+   if (fn) {
+      /* Same host function declared twice in this module (e.g. two call
+       * sites hitting the same fetch function). */
+      lp_gallivm_add_hook(gallivm, name, host_fn);
+      return fn;
+   }
+
+   fn = LLVMAddFunction(gallivm->module, name, function_type);
+   LLVMSetFunctionCallConv(fn, LLVMCCallConv);
+   lp_gallivm_add_hook(gallivm, name, host_fn);
+   return fn;
+}
+
+
+
+/* Fil-C: one JIT session per gallivm_state.  Sessions are cheap and keep
+ * the global mappings of the module they compiled; the session object is
+ * GC-managed by the Fil-C runtime (there is no Dispose API). */
+
+int
+lp_build_jit_compile_for_module(struct gallivm_state *gallivm,
+                                unsigned OptLevel)
+{
+   char opt[2];
+   unsigned i;
+
+   if (!gallivm->jit) {
+      gallivm->jit = FilLLVMJIT_Create();
+      if (!gallivm->jit)
+         return 1;
+   }
+
+   opt[0] = (char)('0' + (OptLevel > 3 ? 3 : OptLevel));
+   opt[1] = 0;
+   FilLLVMJIT_SetOption(gallivm->jit, "opt-level", opt);
+
+   /* Every extern declaration in the module must be mapped before
+    * compilation (the shim panics on unmapped declarations, intrinsics
+    * exempt).  Register the module's hooks: the per-gallivm table built by
+    * lp_gallivm_add_hook(), plus the hooks every module declares. */
+   for (i = 0; i < gallivm->num_hooks; i++)
+      FilLLVMJIT_SetGlobalMapping(gallivm->jit, gallivm->hooks[i].name,
+                                  gallivm->hooks[i].ptr);
+
+   if (gallivm->debug_printf_hook)
+      FilLLVMJIT_SetGlobalMapping(gallivm->jit, "debug_printf", debug_printf);
+
+   if (gallivm->get_time_hook)
+      FilLLVMJIT_SetGlobalMapping(gallivm->jit, "get_time_hook",
+                                  os_time_get_nano);
+
+   /* CompileModule clones the module; the caller's module (and its
+    * context) stay valid until gallivm_free_ir drops the references, so
+    * name lookups after compile keep working. */
+   gallivm->jit_module = FilLLVMJIT_CompileModule(gallivm->jit,
+                                                  gallivm->module);
+   if (!gallivm->jit_module)
+      return 1;
+
+   /* lp_generated_code is opaque under the JIT: the returned module ref
+    * owns the code (GC-managed).  gallivm->code keeps it alive until
+    * gallivm_free_ir. */
+   gallivm->code = (struct lp_generated_code *)gallivm->jit_module;
+
+   return 0;
+}
+
+
+void
+lp_free_generated_code(struct lp_generated_code *code)
+{
+   /* Fil-C: the FilLLVMJITModuleRef is GC-managed; dropping the last
+    * reference (gallivm_free_ir NULLs gallivm->code) lets the runtime
+    * reclaim the module's code sections.  Nothing to free here. */
+   (void)code;
+}
+
+
+void *
+lp_get_default_memory_manager(void)
+{
+   /* Fil-C: no engine-side memory manager exists.  Kept as a symbol for
+    * gallivm_free_code; the field stays NULL. */
+   return NULL;
+}
+
+
+void
+lp_free_memory_manager(void *memorymgr)
+{
+   (void)memorymgr;
+}
+
+
+void
+lp_free_objcache(void *objcache)
+{
+   /* Fil-C: no object cache (see file comment). */
+   (void)objcache;
+}
+
+
+void
+lp_set_module_stack_alignment_override(LLVMModuleRef M, unsigned align)
+{
+   /* Fil-C: x86-32 only upstream; the JIT defines its own stack layout. */
+   (void)M;
+   (void)align;
+}
+
+
diff --git a/mesa/src/gallium/auxiliary/gallivm/lp_bld_misc.cpp b/mesa/src/gallium/auxiliary/gallivm/lp_bld_misc.cpp
deleted file mode 100644
--- a/mesa/src/gallium/auxiliary/gallivm/lp_bld_misc.cpp
+++ /dev/null
@@ -1,653 +0,0 @@
-/**************************************************************************
- *
