diff --git a/mesa/src/gallium/auxiliary/gallivm/lp_bld_nir.c b/mesa/src/gallium/auxiliary/gallivm/lp_bld_nir.c
--- a/mesa/src/gallium/auxiliary/gallivm/lp_bld_nir.c
+++ b/mesa/src/gallium/auxiliary/gallivm/lp_bld_nir.c
@@ -42,7 +42,41 @@


 // Doing AOS (and linear) codegen?
+
+/* Fil-C: the runtime wraps every returned LLVM handle in a fresh GC object,
+ * so pointer identity across API calls does not hold -- `LLVMTypeOf(x) ==
+ * vec_type` never fires even for the same type.  Compare types by shape
+ * instead (same kind, same length/width, recursively same element). */
 static bool
+lp_filc_types_equal(LLVMTypeRef a, LLVMTypeRef b)
+{
+   LLVMTypeKind ka = LLVMGetTypeKind(a);
+   LLVMTypeKind kb = LLVMGetTypeKind(b);
+   if (ka != kb)
+      return false;
+   switch (ka) {
+   case LLVMVectorTypeKind:
+      if (LLVMGetVectorSize(a) != LLVMGetVectorSize(b))
+         return false;
+      if (LLVMGetTypeKind(LLVMGetElementType(a)) == LLVMPointerTypeKind)
+         return true; /* opaque pointers: same kind is all we can ask */
+      return lp_filc_types_equal(LLVMGetElementType(a),
+                                 LLVMGetElementType(b));
+   case LLVMArrayTypeKind:
+      if (LLVMGetArrayLength(a) != LLVMGetArrayLength(b))
+         return false;
+      if (LLVMGetTypeKind(LLVMGetElementType(a)) == LLVMPointerTypeKind)
+         return true;
+      return lp_filc_types_equal(LLVMGetElementType(a),
+                                 LLVMGetElementType(b));
+   case LLVMIntegerTypeKind:
+      return LLVMGetIntTypeWidth(a) == LLVMGetIntTypeWidth(b);
+   default:
+      return true;
+   }
+}
+
+static bool
 is_aos(const struct lp_build_nir_context *bld_base)
 {
    // AOS is used for vectors of uint8[16]
@@ -258,7 +292,7 @@
    if (need_swizzle || num_components != src_components) {
       if (is_aos(bld_base) && need_swizzle) {
          // Handle swizzle for AOS
-         assert(LLVMGetTypeKind(LLVMTypeOf(value)) == LLVMVectorTypeKind);
+   /* Fil-C: identity assert dropped -- the runtime wraps each returned LLVM handle in a fresh GC object, so pointer identity across API calls does not hold; the JIT verifier subsumes the check. */

          // swizzle vector of ((r,g,b,a), (r,g,b,a), (r,g,b,a), (r,g,b,a))
          assert(bld_base->base.type.width == 8);
@@ -2749,7 +2783,8 @@
    for (unsigned i = 0; i < instr->num_params; i++) {
       LLVMValueRef arg = get_src(bld_base, instr->params[i]);

-      if (nir_src_bit_size(instr->params[i]) == 32 && LLVMTypeOf(arg) == bld_base->base.vec_type)
+      if (nir_src_bit_size(instr->params[i]) == 32 &&
+          lp_filc_types_equal(LLVMTypeOf(arg), bld_base->base.vec_type))
          arg = cast_type(bld_base, arg, nir_type_int, 32);
       args[i + LP_RESV_FUNC_ARGS] = arg;
    }
