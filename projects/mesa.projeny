diff --git a/mesa/src/gallium/auxiliary/gallivm/lp_bld_struct.h b/mesa/src/gallium/auxiliary/gallivm/lp_bld_struct.h
--- a/mesa/src/gallium/auxiliary/gallivm/lp_bld_struct.h
+++ b/mesa/src/gallium/auxiliary/gallivm/lp_bld_struct.h
@@ -44,13 +44,17 @@
 #include "util/u_memory.h"


+/* Fil-C: the layout asserts ran LLVMABISizeOfType/LLVMOffsetOfElement against
+ * a TargetData, which the curated LLVM-C subset does not expose.  The JIT
+ * forces the standard x86_64 data layout for its clones, so the asserts
+ * would hold; they are stubbed to no-ops instead of porting the queries.
