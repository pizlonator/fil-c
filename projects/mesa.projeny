 #include <sys/types.h>
@@ -111,7 +112,10 @@
     */
    for (i = 0; i < dri2_dpy->gbm_dri->num_visuals; i++) {
       visual = &dri2_dpy->gbm_dri->visual_table[i];
-      if (visual->gbm_format == surface->v0.format)
+      /* Fil-C: read the surface format through gbm's own accessor rather
+       * than dereferencing the (libgbm-allocated) surface object directly
+       * from libEGL - the direct read loses its object metadata. */
+      if (visual->gbm_format == gbm_surface_get_format(surface))
          break;
    }

@@ -622,8 +626,15 @@
       dri2_dpy->fd_render_gpu =
          get_fd_render_gpu_drm(dri2_dpy->gbm_dri, dri2_dpy->fd_display_gpu);
       if (dri2_dpy->fd_render_gpu < 0) {
-         err = "DRI2: failed to get compatible render device";
-         goto cleanup;
+         /* Fil-C: KMS display devices without a render node (QEMU's
+          * bochs-drm does not set DRIVER_RENDER, so /dev/dri/renderD128
+          * never exists) are display-only PCI devices, for which
+          * queryCompatibleRenderOnlyDeviceFd rightly refuses to guess a
+          * render device.  But the rendering here is kms_swrast on the
+          * display fd's gbm screen anyway, so upstream's hard failure is
+          * wrong for this class of devices: fall back to the display fd
+          * instead of aborting eglInitialize. */
+         dri2_dpy->fd_render_gpu = dri2_dpy->fd_display_gpu;
       }
    }

diff --git a/mesa/src/egl/main/eglapi.c b/mesa/src/egl/main/eglapi.c
--- a/mesa/src/egl/main/eglapi.c
+++ b/mesa/src/egl/main/eglapi.c
@@ -2767,7 +2767,8 @@

    switch (attribute) {
    case EGL_DEVICE_EXT:
-      *value = (EGLAttrib)disp->Device;
+      /* Fil-C: encode the device handle; see _eglEncodeDeviceHandle. */
+      *value = _eglEncodeDeviceHandle(disp->Device);
       break;
    default:
       RETURN_EGL_ERROR(disp, EGL_BAD_ATTRIBUTE, EGL_FALSE);
diff --git a/mesa/src/egl/main/egldevice.c b/mesa/src/egl/main/egldevice.c
--- a/mesa/src/egl/main/egldevice.c
+++ b/mesa/src/egl/main/egldevice.c
@@ -96,11 +96,41 @@
    return (cur != NULL);
 }

+#include <stdfil.h>
+
+/* Fil-C: EGLAttrib is an integer type, so handing out an _EGLDevice pointer
+ * as an EGLAttrib (eglQueryDisplayAttrib(EGL_DEVICE_EXT)) and casting it
+ * back in the client would lose the pointer's object metadata; the client's
+ * next libEGL call would then dereference a null-object pointer.  Encode
+ * device handles for that round trip in a zptrtable, which restores the
+ * object metadata on decode.  Handles obtained from eglQueryDevicesEXT are
+ * real pointers and are passed through unchanged. */
+static zptrtable *device_handle_table;
+
+EGLAttrib
+_eglEncodeDeviceHandle(_EGLDevice *device)
+{
+   if (!device_handle_table)
+      device_handle_table = zptrtable_new();
+   return (EGLAttrib) zptrtable_encode(device_handle_table, device);
+}
+
+_EGLDevice *
+_eglDecodeDeviceHandle(EGLDeviceEXT device)
+{
+   if ((uintptr_t)device < 0x10000 && device_handle_table)
+      return zptrtable_decode(device_handle_table, (uintptr_t)device);
+   return (_EGLDevice *)device;
+}
+
 _EGLDevice _eglSoftwareDevice = {
-   /* TODO: EGL_EXT_device_drm support for KMS + llvmpipe */
-   .extensions = "EGL_MESA_device_software EGL_EXT_device_drm_render_node",
+   /* Fil-C: do not advertise EGL_EXT_device_drm_render_node here.  The
+    * software device has no drmDevice, so querying the render node on it
+    * dereferences a NULL device pointer (upstream TODO already notes that
+    * EGL_EXT_device_drm support for KMS + llvmpipe is missing).  Compositors
+    * like mutter probe that extension and then query the render node. */
+   .extensions = "EGL_MESA_device_software",
    .MESA_device_software = EGL_TRUE,
-   .EXT_device_drm_render_node = EGL_TRUE,
 };

 #ifdef HAVE_LIBDRM
diff --git a/mesa/src/egl/main/egldevice.h b/mesa/src/egl/main/egldevice.h
--- a/mesa/src/egl/main/egldevice.h
+++ b/mesa/src/egl/main/egldevice.h
@@ -48,11 +48,21 @@
 EGLBoolean
 _eglCheckDeviceHandle(EGLDeviceEXT device);

+EGLAttrib
+_eglEncodeDeviceHandle(_EGLDevice *device);
+
+_EGLDevice *
+_eglDecodeDeviceHandle(EGLDeviceEXT device);
+
 static inline _EGLDevice *
 _eglLookupDevice(EGLDeviceEXT device)
 {
-   _EGLDevice *dev = (_EGLDevice *)device;
-   if (!_eglCheckDeviceHandle(device))
+   /* Fil-C: handles obtained via eglQueryDisplayAttrib(EGL_DEVICE_EXT) are
+    * EGLAttrib integers (encoded in a zptrtable, since a raw pointer loses
+    * its object metadata when round-tripped through an integer).  Handles
+    * from eglQueryDevicesEXT are real pointers. */
+   _EGLDevice *dev = _eglDecodeDeviceHandle(device);
+   if (!_eglCheckDeviceHandle((EGLDeviceEXT)dev))
       dev = NULL;
    return dev;
 }
