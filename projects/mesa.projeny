diff --git a/mesa/src/compiler/glsl_types.c b/mesa/src/compiler/glsl_types.c
--- a/mesa/src/compiler/glsl_types.c
+++ b/mesa/src/compiler/glsl_types.c
@@ -24,6 +24,34 @@
 #include <stdio.h>
 #include <string.h>
 #include "glsl_types.h"
+
+/* Fil-C: glsl_type stores type names as integers (uintptr_t name_id).  For
+ * builtin types that is an offset into glsl_type_builtin_names, but for all
+ * other types it is a raw pointer stored as an integer - and converting it
+ * back to a pointer in glsl_get_type_name() yields a pointer without object
+ * metadata, which Fil-C rejects on use.  Encode the name pointers in a
+ * zptrtable instead, which restores the object metadata on decode.  (The
+ * builtin-name offsets never go through the encode/decode path.) */
+#include <stdfil.h>
+
+static zptrtable *glsl_name_table;
+
+static uintptr_t
+filc_encode_type_name(const char *name)
+{
+   if (!glsl_name_table)
+      glsl_name_table = zptrtable_new();
+   return zptrtable_encode(glsl_name_table, (void *)name);
+}
+
+static const char *
+filc_decode_type_name(uintptr_t id)
+{
+   if (!glsl_name_table)
+      glsl_name_table = zptrtable_new();
+   return (const char *) zptrtable_decode(glsl_name_table, id);
+}
+
 #include "util/compiler.h"
 #include "util/glheader.h"
 #include "util/hash_table.h"
@@ -80,7 +108,7 @@
    t->matrix_columns = matrix_columns;
    t->explicit_stride = explicit_stride;
    t->explicit_alignment = explicit_alignment;
-   t->name_id = (uintptr_t)linear_strdup(lin_ctx, name);
+   t->name_id = filc_encode_type_name(linear_strdup(lin_ctx, name));

    return t;
 }
@@ -94,7 +122,7 @@
    t->sampled_type = GLSL_TYPE_VOID;
    t->packed = packed;
    t->length = num_fields;
-   t->name_id = (uintptr_t)name;
+   t->name_id = filc_encode_type_name(name);
    t->explicit_alignment = explicit_alignment;
    t->fields.structure = fields;
 }
@@ -133,7 +161,7 @@
    t->interface_packing = (unsigned)packing;
    t->interface_row_major = (unsigned)row_major;
    t->length = num_fields;
-   t->name_id = (uintptr_t)name;
+   t->name_id = filc_encode_type_name(name);
    t->fields.structure = fields;
 }

@@ -172,7 +200,7 @@
    t->sampled_type = GLSL_TYPE_VOID;
    t->vector_elements = 1;
    t->matrix_columns = 1;
-   t->name_id = (uintptr_t)linear_strdup(lin_ctx, subroutine_name);
+   t->name_id = filc_encode_type_name(linear_strdup(lin_ctx, subroutine_name));

    return t;
 }
@@ -541,7 +569,7 @@
       memcpy(base + array_part, pos, element_part);
    }

-   t->name_id = (uintptr_t)n;
+   t->name_id = filc_encode_type_name(n);

    return t;
 }
@@ -1299,11 +1327,11 @@
    t->cmat_desc = desc;

    const glsl_type *element_type = glsl_simple_type(desc.element_type, 1, 1);
-   t->name_id = (uintptr_t ) linear_asprintf(lin_ctx, "coopmat<%s, %s, %u, %u, %s>",
+   t->name_id = filc_encode_type_name(linear_asprintf(lin_ctx, "coopmat<%s, %s, %u, %u, %s>",
                                              glsl_get_type_name(element_type),
                                              mesa_scope_name((mesa_scope)desc.scope),
                                              desc.rows, desc.cols,
-                                             glsl_cmat_use_to_string((enum glsl_cmat_use)desc.use));
+                                             glsl_cmat_use_to_string((enum glsl_cmat_use)desc.use)));

    return t;
 }
@@ -3362,7 +3390,7 @@
    if (type->has_builtin_name) {
       return &glsl_type_builtin_names[type->name_id];
    } else {
-      return (const char *) type->name_id;
+      return filc_decode_type_name(type->name_id);
    }
 }

diff --git a/mesa/src/compiler/nir/nir.h b/mesa/src/compiler/nir/nir.h
--- a/mesa/src/compiler/nir/nir.h
+++ b/mesa/src/compiler/nir/nir.h
@@ -1036,10 +1036,15 @@
    /* Instruction or if-statement that consumes this value as a source. This
     * should only be accessed through nir_src_* helpers.
     *
-    * Internally, it is a tagged pointer to a nir_instr or nir_if.
+    * Fil-C: this used to be a tag-bit-carrying uintptr_t (pointer | flags),
+    * which loses pointer object metadata when cast back to a pointer.  Keep
+    * the parent as a real pointer and move the two tag bits into
+    * _parent_flags instead.
     */
-   uintptr_t _parent;
+   void *_parent;

+   uintptr_t _parent_flags;
+
    struct list_head use_link;
    nir_def *ssa;
 } nir_src;
@@ -1053,7 +1058,7 @@
 static inline bool
 nir_src_is_if(const nir_src *src)
 {
-   return src->_parent & NIR_SRC_PARENT_IS_IF;
+   return src->_parent_flags & NIR_SRC_PARENT_IS_IF;
 }

 static inline nir_instr *
@@ -1071,19 +1076,14 @@
    assert(nir_src_is_if(src));

    /* Because it is an if, the tag is 1, so we need to mask */
-   return (struct nir_if *)(src->_parent & NIR_SRC_PARENT_MASK);
+   return (struct nir_if *)(src->_parent);
 }

 static inline void
 _nir_src_set_parent(nir_src *src, void *parent, bool is_if)
 {
-    uintptr_t ptr = (uintptr_t) parent;
-    assert((ptr & ~NIR_SRC_PARENT_MASK) == 0 && "pointer must be aligned");
-
-    if (is_if)
-       ptr |= NIR_SRC_PARENT_IS_IF;
-
-    src->_parent = ptr;
+    src->_parent = parent;
+    src->_parent_flags = is_if ? NIR_SRC_PARENT_IS_IF : 0;
 }

 static inline void
diff --git a/mesa/src/compiler/nir/nir_validate.c b/mesa/src/compiler/nir/nir_validate.c
--- a/mesa/src/compiler/nir/nir_validate.c
+++ b/mesa/src/compiler/nir/nir_validate.c
@@ -138,8 +138,8 @@
    /* nir_src only appears once and only in one SSA def use list, since we
     * mark nir_src's as we go by tagging this pointer.
     */
-   if (validate_assert(state, (src->_parent & SRC_TAG_SEEN) == 0)) {
-      src->_parent |= SRC_TAG_SEEN;
+   if (validate_assert(state, (src->_parent_flags & SRC_TAG_SEEN) == 0)) {
+      src->_parent_flags |= SRC_TAG_SEEN;
       state->nr_tagged_srcs++;
    }
 }
@@ -150,9 +150,8 @@
 static nir_instr *
 src_parent_instr_safe(nir_src *src)
 {
-   uintptr_t untagged = (src->_parent & ~SRC_TAG_SEEN);
-   assert(!(untagged & NIR_SRC_PARENT_IS_IF) && "precondition");
-   return (nir_instr *)untagged;
+   assert(!(src->_parent_flags & NIR_SRC_PARENT_IS_IF) && "precondition");
+   return (nir_instr *)src->_parent;
 }

 /*
@@ -165,8 +164,8 @@
 static void
 validate_src_tag(nir_src *src, validate_state *state)
 {
-   if (validate_assert(state, src->_parent & SRC_TAG_SEEN)) {
-      src->_parent &= ~SRC_TAG_SEEN;
+   if (validate_assert(state, src->_parent_flags & SRC_TAG_SEEN)) {
+      src->_parent_flags &= ~SRC_TAG_SEEN;
       state->nr_tagged_srcs--;
    }
 }
diff --git a/mesa/src/egl/drivers/dri2/egl_dri2.c b/mesa/src/egl/drivers/dri2/egl_dri2.c
--- a/mesa/src/egl/drivers/dri2/egl_dri2.c
+++ b/mesa/src/egl/drivers/dri2/egl_dri2.c
@@ -1015,8 +1015,21 @@
    } else {
       render_fd = dri2_dpy->mesa->queryCompatibleRenderOnlyDeviceFd(
          dri2_dpy->fd_render_gpu);
-      if (render_fd < 0)
-         return EGL_FALSE;
+      if (render_fd < 0) {
+         /* Fil-C: display-only KMS devices without a render node (QEMU's
+          * bochs-drm does not set DRIVER_RENDER) have no EGLDevice of
+          * their own: the device list only carries render-capable DRM
+          * devices (_eglAddDRMDevice asserts DRM_NODE_RENDER, and the
+          * upstream TODO in egldevice.c already notes EGL_EXT_device_drm
+          * support for KMS + llvmpipe is missing).  The renderer behind
+          * this display is kms_swrast/llvmpipe -- the software device --
+          * so report that instead of failing eglInitialize. */
+         dev = _eglFindDevice(-1, true);
+         if (!dev)
+            return EGL_FALSE;
+         disp->Device = dev;
+         return EGL_TRUE;
+      }
    }

    dev = _eglFindDevice(render_fd, software);
diff --git a/mesa/src/egl/drivers/dri2/platform_drm.c b/mesa/src/egl/drivers/dri2/platform_drm.c
--- a/mesa/src/egl/drivers/dri2/platform_drm.c
