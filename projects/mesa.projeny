 void lp_build_coro_add_malloc_hooks(struct gallivm_state *gallivm)
 {
-   assert(gallivm->engine);
-
+   /* Fil-C: the coro hooks are declared unconditionally in every module
+    * (lp_build_coro_declare_malloc_hooks), and the JIT's mapping precheck
+    * requires every declaration to be mapped, used or not.  Instead of the
+    * engine's AddGlobalMapping, register them in the gallivm hook table;
+    * lp_build_jit_compile_for_module turns the table into
+    * FilLLVMJIT_SetGlobalMapping calls before the compile. */
    assert(gallivm->coro_malloc_hook);
    assert(gallivm->coro_free_hook);
-   LLVMAddGlobalMapping(gallivm->engine, gallivm->coro_malloc_hook, coro_malloc);
-   LLVMAddGlobalMapping(gallivm->engine, gallivm->coro_free_hook, coro_free);
+   lp_gallivm_add_hook(gallivm, "coro_malloc", coro_malloc);
+   lp_gallivm_add_hook(gallivm, "coro_free", coro_free);
 }

 void lp_build_coro_declare_malloc_hooks(struct gallivm_state *gallivm)
