+/* Fil-C: the JIT glue declares functions taking struct gallivm_state, so
+ * its header comes after the struct definition. */
+#include "gallivm/lp_bld_misc.h"

 unsigned
 lp_build_init_native_width(void);
diff --git a/mesa/src/gallium/auxiliary/gallivm/lp_bld_ir_common.c b/mesa/src/gallium/auxiliary/gallivm/lp_bld_ir_common.c
--- a/mesa/src/gallium/auxiliary/gallivm/lp_bld_ir_common.c
+++ b/mesa/src/gallium/auxiliary/gallivm/lp_bld_ir_common.c
@@ -209,7 +209,7 @@
    LLVMValueRef exec_mask = mask->has_mask ? mask->exec_mask : NULL;

    assert(lp_check_value(bld_store->type, val));
-   assert(LLVMGetTypeKind(LLVMTypeOf(dst_ptr)) == LLVMPointerTypeKind);
+   /* Fil-C: identity assert dropped -- the runtime wraps each returned LLVM handle in a fresh GC object, so pointer identity across API calls does not hold; the JIT verifier subsumes the check. */
    assert(LLVM_VERSION_MAJOR >= 15
           || (LLVMGetElementType(LLVMTypeOf(dst_ptr)) == LLVMTypeOf(val)
               || LLVMGetTypeKind(LLVMGetElementType(LLVMTypeOf(dst_ptr))) == LLVMArrayTypeKind));
@@ -368,10 +368,10 @@
       return;
    }
