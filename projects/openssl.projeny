diff --git a/openssl/crypto/sha/keccak1600_asm_forward.c b/openssl/crypto/sha/keccak1600_asm_forward.c
new file mode 100644
--- /dev/null
+++ b/openssl/crypto/sha/keccak1600_asm_forward.c
@@ -0,0 +1,44 @@
+#include <openssl/e_os2.h>
+#include <string.h>
+#include <assert.h>
+#include <stdfil.h>
+
+size_t SHA3_absorb(uint64_t A[5][5], const unsigned char *inp, size_t len,
+                   size_t r)
+{
+    ZSAFETY_CHECK(r < (25 * sizeof(A[0][0])));
+    ZSAFETY_CHECK((r % 8) == 0);
+    zcheck(A, 25 * sizeof(A[0][0]));
+    zcheck_readonly(inp, len);
+    return zunsafe_buf_call(len, "SHA3_absorb", A, inp, len, r);
+}
+
+#if defined(__aarch64__)
+/*
+ * Fil-C: on aarch64 the SHA3-extension accelerated absorb() lives in the raw
+ * assembler (SHA3_absorb_cext in keccak1600-armv8.pl) and is called from
+ * providers/implementations/digests/sha3_prov.c when the SHA3 extensions
+ * are available.  Provide a pizlonated forwarder with the same contract as
+ * SHA3_absorb above (returns the number of bytes not absorbed).
+ */
+size_t SHA3_absorb_cext(uint64_t A[5][5], const unsigned char *inp,
+                        size_t len, size_t r)
+{
+    ZSAFETY_CHECK(r < (25 * sizeof(A[0][0])));
+    ZSAFETY_CHECK((r % 8) == 0);
+    zcheck(A, 25 * sizeof(A[0][0]));
+    zcheck_readonly(inp, len);
+    return zunsafe_buf_call(len, "SHA3_absorb_cext", A, inp, len, r);
+}
+#endif
+
+void SHA3_squeeze(uint64_t A[5][5], unsigned char *out, size_t len, size_t r, int next)
+{
+    ZSAFETY_CHECK(r < (25 * sizeof(A[0][0])));
+    ZSAFETY_CHECK((r % 8) == 0);
+    zcheck(A, 25 * sizeof(A[0][0]));
+    zcheck(out, len);
+    zunsafe_buf_call(len, "SHA3_squeeze", A, out, len, r, next);
+}
+
+
diff --git a/openssl/crypto/sha/sha1dgst.c b/openssl/crypto/sha/sha1dgst.c
--- a/openssl/crypto/sha/sha1dgst.c
+++ b/openssl/crypto/sha/sha1dgst.c
@@ -25,6 +25,26 @@
 #include "sha_local.h"
 #include "crypto/sha.h"

+#if defined(SHA1_ASM) && defined(__aarch64__)
+/*
+ * Fil-C: on aarch64 the SHA1 block function is yolo assembler
+ * (sha1-armv8.S).  On x86_64 the equivalent wrapper lives in
+ * crypto/evp/e_aes_cbc_hmac_sha1.c (x86-only section); here we need our own
+ * so that every pizlonated caller resolves to this C forwarder instead of
+ * to the raw assembler symbol.
+ */
+# include <stdfil.h>
+
+void sha1_block_data_order(SHA_CTX *c, const void *p, size_t num)
+{
+    zcheck(c, sizeof(SHA_CTX));
+    zcheck_readonly(p, zchecked_mul(num, SHA_CBLOCK));
+    zunsafe_buf_call(zchecked_mul(num, SHA_CBLOCK), "sha1_block_data_order",
+                     c, p, num);
+}
+#endif
+
+
 int ossl_sha1_ctrl(SHA_CTX *sha1, int cmd, int mslen, void *ms)
