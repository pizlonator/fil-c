@@ -140,6 +215,43 @@
 /* Precomputed tables for the default generator */
 extern const PRECOMP256_ROW ecp_nistz256_precomputed[37];

+#if defined(__aarch64__) && defined(__FILC__)
+/*
+ * Fil-C: the hardcoded generator table (ecp_nistz256_table.c) is stored in
+ * the natural point-per-64-bytes layout, but the armv8 scatter/gather
+ * assembler expects the byte-smashed layout that the table-conversion step
+ * of ecp_nistz256-armv8.pl used to produce (that step was removed when the
+ * table became a C object).  The table holds public data (multiples of the
+ * standard generator), so convert it once, lazily, at run time.
+ */
+static PRECOMP256_ROW *ecp_nistz256_smashed_table;
+static CRYPTO_ONCE ecp_nistz256_smashed_once = CRYPTO_ONCE_STATIC_INIT;
+
+static void ecp_nistz256_convert_table(void)
+{
+    const unsigned char *nat = (const unsigned char *)ecp_nistz256_precomputed;
+    unsigned char *sm;
+    unsigned int row, pt, byte;
+
+    PRECOMP256_ROW *smashed = OPENSSL_malloc(sizeof(PRECOMP256_ROW) * 37);
+
+    if (smashed == NULL) {
+        ERR_raise(ERR_LIB_EC, ERR_R_MALLOC_FAILURE);
+        return;
+    }
+    sm = (unsigned char *)smashed;
+    for (row = 0; row < 37; row++) {
+        const unsigned char *r = nat + row * 64 * 64;
+        unsigned char *s = sm + row * 64 * 64;
+
+        for (byte = 0; byte < 64; byte++)
+            for (pt = 0; pt < 64; pt++)
+                s[byte * 64 + pt] = r[pt * 64 + byte];
+    }
+    ecp_nistz256_smashed_table = smashed;
+}
+#endif
+
