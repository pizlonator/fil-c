diff --git a/openssl/crypto/sm4/sm4_armv8_asm_forward.c b/openssl/crypto/sm4/sm4_armv8_asm_forward.c
new file mode 100644
--- /dev/null
+++ b/openssl/crypto/sm4/sm4_armv8_asm_forward.c
@@ -0,0 +1,78 @@
+#include <stdlib.h>
+#include <openssl/crypto.h>
+#include "crypto/sm4.h"
+#include <stdfil.h>
+
+/*
+ * Fil-C: the sm4_v8_* routines are yolo assembler (sm4-armv8.pl).  These
+ * wrappers provide pizlonated C entry points that hop into the raw
+ * assembler with zunsafe calls.  The signature and argument order of each
+ * wrapper mirror include/crypto/sm4_platform.h and the assembler entry
+ * exactly.  sm4_v8_ctr32_encrypt_blocks takes a block count, like the aes
+ * ctr32 entry points.
+ */
+
+int sm4_v8_set_encrypt_key(const unsigned char *userKey, SM4_KEY *key)
+{
+    zcheck_readonly(userKey, 16);
+    zcheck(key, sizeof(SM4_KEY));
+    return zunsafe_fast_call("sm4_v8_set_encrypt_key", userKey, key);
+}
+
+int sm4_v8_set_decrypt_key(const unsigned char *userKey, SM4_KEY *key)
+{
+    zcheck_readonly(userKey, 16);
+    zcheck(key, sizeof(SM4_KEY));
+    return zunsafe_fast_call("sm4_v8_set_decrypt_key", userKey, key);
+}
+
+void sm4_v8_encrypt(const unsigned char *in, unsigned char *out,
+                    const SM4_KEY *key)
+{
+    zcheck_readonly(in, 16);
+    zcheck(out, 16);
+    zcheck_readonly(key, sizeof(SM4_KEY));
+    zunsafe_fast_call("sm4_v8_encrypt", in, out, key);
+}
+
+void sm4_v8_decrypt(const unsigned char *in, unsigned char *out,
+                    const SM4_KEY *key)
+{
+    zcheck_readonly(in, 16);
+    zcheck(out, 16);
+    zcheck_readonly(key, sizeof(SM4_KEY));
+    zunsafe_fast_call("sm4_v8_decrypt", in, out, key);
+}
+
+void sm4_v8_ecb_encrypt(const unsigned char *in, unsigned char *out,
+                        size_t length, const SM4_KEY *key, const int enc)
+{
+    zcheck_readonly(in, length);
+    zcheck(out, length);
+    zcheck_readonly(key, sizeof(SM4_KEY));
+    zunsafe_buf_call(length, "sm4_v8_ecb_encrypt", in, out, length, key, enc);
+}
+
+void sm4_v8_cbc_encrypt(const unsigned char *in, unsigned char *out,
+                        size_t length, const SM4_KEY *key,
+                        unsigned char *ivec, const int enc)
+{
+    zcheck_readonly(in, length);
+    zcheck(out, length);
+    zcheck_readonly(key, sizeof(SM4_KEY));
+    zcheck(ivec, 16);
+    zunsafe_buf_call(length, "sm4_v8_cbc_encrypt", in, out, length, key, ivec,
+                     enc);
+}
+
+void sm4_v8_ctr32_encrypt_blocks(const unsigned char *in, unsigned char *out,
+                                 size_t blocks, const void *key,
+                                 const unsigned char ivec[16])
+{
+    zcheck_readonly(in, zchecked_mul(blocks, 16));
+    zcheck(out, zchecked_mul(blocks, 16));
+    zcheck_readonly(key, sizeof(SM4_KEY));
+    zcheck_readonly(ivec, 16);
+    zunsafe_buf_call(blocks, "sm4_v8_ctr32_encrypt_blocks", in, out, blocks,
+                     key, ivec);
+}
