diff --git a/openssl/crypto/modes/aesni_gcm_asm_forward.c b/openssl/crypto/modes/aesni_gcm_asm_forward.c
new file mode 100644
--- /dev/null
+++ b/openssl/crypto/modes/aesni_gcm_asm_forward.c
@@ -0,0 +1,34 @@
+#include "internal/deprecated.h"
+
+#include <assert.h>
+
+#include <stdlib.h>
+#include <openssl/crypto.h>
+#include <openssl/aes.h>
+#include "crypto/modes.h"
+#include "crypto/aes_platform.h"
+#include <stdfil.h>
+#include <stddef.h>
+
+size_t aesni_gcm_encrypt(const unsigned char *in, unsigned char *out, size_t len,
+                         const void *key, unsigned char ivec[16], u64 *Xi)
+{
+    zcheck_readonly(in, len);
+    zcheck(out, len);
+    zcheck_readonly(key, sizeof(AES_KEY));
+    zcheck(ivec, 16);
+    zcheck(Xi, sizeof(GCM128_CONTEXT) - offsetof(GCM128_CONTEXT, Xi));
+    return zunsafe_buf_call(len, "aesni_gcm_encrypt", in, out, len, key, ivec, Xi);
+}
+
+size_t aesni_gcm_decrypt(const unsigned char *in, unsigned char *out, size_t len,
+                         const void *key, unsigned char ivec[16], u64 *Xi)
+{
+    zcheck_readonly(in, len);
+    zcheck(out, len);
+    zcheck_readonly(key, sizeof(AES_KEY));
+    zcheck(ivec, 16);
+    zcheck(Xi, sizeof(GCM128_CONTEXT) - offsetof(GCM128_CONTEXT, Xi));
+    return zunsafe_buf_call(len, "aesni_gcm_decrypt", in, out, len, key, ivec, Xi);
+}
+
diff --git a/openssl/crypto/modes/armv8_gcm_asm_forward.c b/openssl/crypto/modes/armv8_gcm_asm_forward.c
new file mode 100644
--- /dev/null
+++ b/openssl/crypto/modes/armv8_gcm_asm_forward.c
@@ -0,0 +1,52 @@
+#include "internal/deprecated.h"
+
+#include <assert.h>
+
+#include <stdlib.h>
+#include <openssl/crypto.h>
+#include <openssl/aes.h>
+#include "crypto/modes.h"
+#include "crypto/aes_platform.h"
+#include <stdfil.h>
+#include <stddef.h>
+
+/*
+ * Fil-C: the aes_gcm_*_kernel and unroll8_eor3_aes_gcm_*_kernel routines are
+ * yolo assembler (aes-gcm-armv8_64.pl and aes-gcm-armv8-unroll8_64.pl).
+ * These wrappers provide pizlonated C entry points that hop into the raw
+ * assembler with zunsafe calls.  The kernels take the input length in BITS
+ * and return the number of BYTES processed.
+ *
+ * Xi is passed as a pointer into a GCM128_CONTEXT: the kernels read H, Htable
+ * (and beyond) relative to Xi, relying on the relative layout documented in
+ * include/crypto/modes.h, so the whole tail of the context behind Xi is
+ * checked (mirroring the x86_64 aesni_gcm_asm_forward.c treatment).  The
+ * kernels also update the counter in ivec, so ivec is checked as writable.
+ */
+#define WRAP_KERNEL(name)                                                     \
+    size_t name(const uint8_t *in, uint64_t len_bits, uint8_t *out,           \
+                uint64_t *Xi, unsigned char ivec[16], const void *key)        \
+    {                                                                         \
+        size_t len = (size_t)(len_bits / 8);                                  \
+                                                                              \
+        zcheck_readonly(in, len);                                             \
+        zcheck(out, len);                                                     \
+        zcheck(Xi, sizeof(GCM128_CONTEXT) - offsetof(GCM128_CONTEXT, Xi));    \
+        zcheck(ivec, 16);                                                     \
+        zcheck_readonly(key, sizeof(AES_KEY));                                \
+        return zunsafe_buf_call(len, #name, in, len_bits, out, Xi, ivec,      \
+                                key);                                         \
+    }
+
+WRAP_KERNEL(aes_gcm_enc_128_kernel)
+WRAP_KERNEL(aes_gcm_enc_192_kernel)
+WRAP_KERNEL(aes_gcm_enc_256_kernel)
+WRAP_KERNEL(aes_gcm_dec_128_kernel)
+WRAP_KERNEL(aes_gcm_dec_192_kernel)
+WRAP_KERNEL(aes_gcm_dec_256_kernel)
+WRAP_KERNEL(unroll8_eor3_aes_gcm_enc_128_kernel)
+WRAP_KERNEL(unroll8_eor3_aes_gcm_enc_192_kernel)
+WRAP_KERNEL(unroll8_eor3_aes_gcm_enc_256_kernel)
+WRAP_KERNEL(unroll8_eor3_aes_gcm_dec_128_kernel)
+WRAP_KERNEL(unroll8_eor3_aes_gcm_dec_192_kernel)
+WRAP_KERNEL(unroll8_eor3_aes_gcm_dec_256_kernel)
