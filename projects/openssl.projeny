 /*
+ * Fil-C: the SIGILL-based probing fallback below does not work in pizlonated
+ * code (it takes function pointers to raw assembler probe routines and
+ * relies on catching SIGILL).  Every libc that Fil-C supports has
+ * getauxval(), so always use that path instead.
+ */
+#if defined(__FILC__) && !defined(OSSL_IMPLEMENT_GETAUXVAL)
+#include <sys/auxv.h>
+#define OSSL_IMPLEMENT_GETAUXVAL
+#endif
+
+/*
  * ARM puts the feature bits for Crypto Extensions in AT_HWCAP2, whereas
  * AArch64 used AT_HWCAP.
  */
@@ -145,22 +167,87 @@
 #define OSSL_HWCAP2_RNG (1 << 16)
 #endif

+#if defined(__FILC__) && defined(__aarch64__)
+/*
+ * Fil-C: the pizlonated libc's getauxval() currently reports 0 for
+ * AT_HWCAP and AT_HWCAP2 even though the kernel provides both entries
+ * (they show up in /proc/self/auxv).  Runtime CPU feature detection on
+ * aarch64 depends on exactly these two entries, so read them from
+ * /proc/self/auxv as a fallback.  Once the Fil-C libc populates AT_HWCAP/
+ * AT_HWCAP2 properly, getauxval() will return non-zero and this fallback
+ * stops being exercised.
+ *
+ * Note: the getauxval() call below refers to the real libc function
+ * because the #define comes after this function definition.
+ */
+static unsigned long filc_getauxval(unsigned long type)
+{
+    unsigned long val = getauxval(type);
+    FILE *f;
+    unsigned long entry_type, entry_value;
+
+    if (val != 0 || (type != OSSL_HWCAP && type != OSSL_HWCAP2))
+        return val;
+
+    f = fopen("/proc/self/auxv", "rb");
+    if (f == NULL)
+        return 0;
+    while (fread(&entry_type, sizeof(entry_type), 1, f) == 1
+           && fread(&entry_value, sizeof(entry_value), 1, f) == 1) {
+        if (entry_type == type) {
+            val = entry_value;
+            break;
+        }
+    }
+    fclose(f);
+    return val;
+}
+#define getauxval filc_getauxval
+#endif
+
+#if defined(__aarch64__)
+/*
+ * Fil-C: pizlonated C cannot call the raw "_armv7_tick" assembler helper
+ * directly, so route through zunsafe_fast_call.
+ */
+static uint32_t armv7_tick(void)
+{
+    return (uint32_t)zunsafe_fast_call("_armv7_tick");
+}
+#else
 uint32_t _armv7_tick(void);
+#endif

 uint32_t OPENSSL_rdtsc(void)
 {
     if (OPENSSL_armcap_P & ARMV7_TICK)
+#if defined(__aarch64__)
+        return armv7_tick();
+#else
         return _armv7_tick();
+#endif
     else
         return 0;
 }

 #ifdef __aarch64__
-size_t OPENSSL_rndr_asm(unsigned char *buf, size_t len);
-size_t OPENSSL_rndrrs_asm(unsigned char *buf, size_t len);
+/*
+ * Fil-C: OPENSSL_rndr_asm and OPENSSL_rndrrs_asm are raw assembler routines
+ * (they live in arm64cpuid.S); wrap them with zunsafe calls.  Note that
+ * zunsafe_call always exits and re-enters Fil-C around the raw call, which
+ * is fine here since the wrapper is only handed to OPENSSL_rndr_wrapper.
+ */
+static size_t rndr_asm(unsigned char *buf, size_t len)
+{
+    zcheck(buf, len);
+    return zunsafe_buf_call(len, "OPENSSL_rndr_asm", buf, len);
+}

-size_t OPENSSL_rndr_bytes(unsigned char *buf, size_t len);
-size_t OPENSSL_rndrrs_bytes(unsigned char *buf, size_t len);
+static size_t rndrrs_asm(unsigned char *buf, size_t len)
+{
+    zcheck(buf, len);
+    return zunsafe_buf_call(len, "OPENSSL_rndrrs_asm", buf, len);
+}

 static size_t OPENSSL_rndr_wrapper(size_t (*func)(unsigned char *, size_t), unsigned char *buf, size_t len)
 {
@@ -178,15 +265,38 @@

 size_t OPENSSL_rndr_bytes(unsigned char *buf, size_t len)
 {
-    return OPENSSL_rndr_wrapper(OPENSSL_rndr_asm, buf, len);
+    return OPENSSL_rndr_wrapper(rndr_asm, buf, len);
 }

 size_t OPENSSL_rndrrs_bytes(unsigned char *buf, size_t len)
 {
-    return OPENSSL_rndr_wrapper(OPENSSL_rndrrs_asm, buf, len);
+    return OPENSSL_rndr_wrapper(rndrrs_asm, buf, len);
 }
 #endif

+#if defined(__aarch64__) && defined(OPENSSL_CPUID_OBJ)
+/*
+ * Fil-C: with $CPUIDASM_aarch64 active, arm64cpuid.S replaces mem_clr.c as
+ * the provider of OPENSSL_cleanse and CRYPTO_memcmp.  Of the two, only the
+ * OPENSSL_cleanse assembler was dropped from arm64cpuid.pl (see the FIXME
+ * there): cleanse is implemented here with zmemset, while CRYPTO_memcmp is
+ * forwarded to the raw assembler routine that is deliberately kept in
+ * arm64cpuid.S as the zunsafe target.
+ */
+void OPENSSL_cleanse(void *ptr, size_t len)
+{
+    zmemset(ptr, 0, len);
+}
+
+#undef CRYPTO_memcmp /* in case FUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION */
+int CRYPTO_memcmp(const void *a, const void *b, size_t len)
+{
+    zcheck_readonly(a, len);
+    zcheck_readonly(b, len);
+    return zunsafe_buf_call(len, "CRYPTO_memcmp", a, b, len);
+}
+#endif
+
 #if !defined(__APPLE__) && !defined(OSSL_IMPLEMENT_GETAUXVAL)
