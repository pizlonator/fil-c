+void whirlpool_block(WHIRLPOOL_CTX *ctx, const void *inp, size_t n)
+{
+    zcheck(ctx, sizeof(WHIRLPOOL_CTX));
+    zcheck_readonly(inp, zchecked_mul(n, WHIRLPOOL_BBLOCK / 8));
