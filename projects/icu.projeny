Archive: icu4c-78.3-sources.tgz
Origname: icu
Name: icu

    icu 78.3 with the Fil-C port (capability-safe converter clone,
    compiler-fence aliasing barrier, no assembly data objects,
    pointer-TOC data length fix). The archive is the pristine official
    ICU4C source distribution icu4c-78.3-sources.tgz (sha256
    3a2e7a47604ba702f345878308e6fefeca612ee895cf4a5f222e7955fabfe0c0;
    md5 matches the release's icu4c-78.3-sources.md5). It carries no
    symlinks and no .git* entries, so unlike the previous codeload-based
    repack it needs no LICENSE symlink workaround. It is the icu4c
    release dist rather than the whole monorepo: the workdir now holds
    source/ at the top level (build_icu.sh and the optfil/pizlix
    pizlonated-icu consumers follow it there), and ICU's own prebuilt
    source/data/in/icudt78l.dat stands in for the data .txt sources the
    monorepo carries. Every Fil-C change lives in the patch below,
    none in the tarball.

    GENCCODE_ASSEMBLY note: the configure/configure.ac hunks clear
    GENCCODE_ASSEMBLY unconditionally (not behind __PIZLONATOR_WAS_HERE__),
    so Yolo-C builds get C data objects too. Deliberate: assembly data
    objects cannot link under Fil-C capabilities, and the C fallback is
    still correct for Yolo-C.

    Fil-C builtins audit: rg -nw "zmkptr|zcompiler_fence|zcap|stdfil" over
    the workdir shows only common/ucnv.cpp (zmkptr) uses Fil-C builtins.
diff --git a/icu/source/common/putil.cpp b/icu/source/common/putil.cpp
--- a/icu/source/common/putil.cpp
+++ b/icu/source/common/putil.cpp
@@ -641,9 +641,27 @@
 U_CAPI int32_t U_EXPORT2
 uprv_timezone()
 {
+#ifdef __PIZLONATOR_WAS_HERE__
+    /* Fil-C only (the upstream fallback below stays live for Yolo-C in the
+       #else branch): return the libc's timezone global directly instead of
+       exercising the localtime/mktime/gmtime fallback, which is fragile
+       under Fil-C. Where the platform defines U_TIMEZONE, prefer it: on
+       glibc it expands to __timezone, the only correct name there, while a
+       bare `timezone` would not compile. On this target (musl-derived
+       pizfix) U_TIMEZONE is not defined for Linux-based platforms (see
+       putilimp.h: only glibc/NewLIB/Android/Windows define it), so use the
+       plain `timezone` global -- exactly what the U_TIMEZONE path would have
+       returned on platforms where it exists. */
 #ifdef U_TIMEZONE
     return U_TIMEZONE;
 #else
+    return timezone;
+#endif
+#else
+    /* Upstream path (Yolo-C and all non-Fil-C builds). */
+#ifdef U_TIMEZONE
+    return U_TIMEZONE;
+#else
     time_t t, t1, t2;
     struct tm tmrec;
     int32_t tdiff = 0;
@@ -672,6 +690,7 @@
 #endif
     return tdiff;
 #endif
+#endif  /* Fil-C/Yolo-C split above: __PIZLONATOR_WAS_HERE__ vs upstream. */
 }

 /* Note that U_TZNAME does *not* have to be tzname, but if it is,
diff --git a/icu/source/common/ucnv.cpp b/icu/source/common/ucnv.cpp
--- a/icu/source/common/ucnv.cpp
+++ b/icu/source/common/ucnv.cpp
@@ -43,6 +43,14 @@
 #include "ucnv_cnv.h"
 #include "ucnv_bld.h"

+#ifdef __PIZLONATOR_WAS_HERE__
+/* Fil-C: ucnv_clone() below uses zmkptr() to re-derive an aligned pointer
+   without stripping its capability. Include stdfil.h directly rather than
+   relying on the transitive unicode/uset.h -> unicode/char16ptr.h -> stdfil.h
+   chain, so this TU keeps building if those headers ever drop the include. */
+#include <stdfil.h>
+#endif
+
 /* size of intermediate and preflighting buffers in ucnv_convert() */
 #define CHUNK_SIZE 1024

@@ -233,7 +241,10 @@
         uintptr_t aligned_p = (p + alignof(UConverter) - 1) & ~(alignof(UConverter) - 1);
         ptrdiff_t pointerAdjustment = aligned_p - p;
         if (bufferSizeNeeded + pointerAdjustment <= stackBufferSize) {
-            stackBuffer = reinterpret_cast<void *>(aligned_p);
+            /* Fil-C: cast to unsigned long, zmkptr()'s parameter type in
+               stdfil.h, so the address is not truncated on LLP64 targets
+               where unsigned long is 32 bits but pointers are 64. */
+            stackBuffer = zmkptr(stackBuffer, static_cast<unsigned long>(aligned_p));
             stackBufferSize -= static_cast<int32_t>(pointerAdjustment);
         } else {
             /* prevent using the stack buffer but keep the size > 0 so that we do not just preflight */
diff --git a/icu/source/common/ucnv_io.cpp b/icu/source/common/ucnv_io.cpp
--- a/icu/source/common/ucnv_io.cpp
+++ b/icu/source/common/ucnv_io.cpp
@@ -249,14 +249,39 @@

     sectionSizes = static_cast<const uint32_t*>(udata_getMemory(data));
     int32_t dataLength = udata_getLength(data); // This is the length minus the UDataInfo size
-    if (dataLength <= int32_t(sizeof(sectionSizes[0]))) {
+    /* Fil-C: udata_getLength() (see udatamem.cpp) returns -1 if and only if the
+       length is unknown, which happens exactly when the data uses a pointer
+       table of contents (compiled-in static data) rather than a memory-mapped
+       file or a common data archive. In that case there is no byte count to
+       validate against, so the length-vs-size checks below are skipped.
+       This cannot mask a corrupt TOC: tableStart is range-checked against
+       [minTocLength, normalizedStringTableIndex] unconditionally (see below),
+       and pointer-TOC data is built into the binary (not attacker-controlled
+       input), while every file/archive path yields dataLength >= 0 and keeps
+       the full truncation checks. */
+    UBool isDataLengthKnown = dataLength >= 0;
+    if (isDataLengthKnown && dataLength <= int32_t(sizeof(sectionSizes[0]))) {
         // We don't even have a TOC!
         goto invalidFormat;
     }
     table = reinterpret_cast<const uint16_t*>(sectionSizes);
     tableStart = sectionSizes[0];
+    /* Fil-C: bound tableStart above as well as below. The only valid values
+       are minTocLength (8, no normalized string table) and
+       normalizedStringTableIndex (9, with one); the TOC layout for this data
+       format (pinned to formatVersion 3 by isAcceptable() above) is fixed.
+       When the data length is unknown there is no byte count to validate
+       against, so without this upper bound a corrupt tableStart would drive
+       the sectionSizes[section] loop below out of bounds -- do not rely on a
+       Fil-C capability trap to catch that, fail closed here instead.
+       Bounding first also keeps the (tableStart + 1) * sizeof sizeOfTOC
+       computation from wrapping on a huge tableStart. */
+    if (tableStart < minTocLength || tableStart > normalizedStringTableIndex) {
+        // We don't have a whole TOC!
+        goto invalidFormat;
+    }
     sizeOfTOC = int32_t((tableStart + 1) * sizeof(sectionSizes[0]));
-    if (tableStart < minTocLength || dataLength <= sizeOfTOC) {
+    if (isDataLengthKnown && dataLength <= sizeOfTOC) {
         // We don't have a whole TOC!
         goto invalidFormat;
     }
@@ -277,9 +302,15 @@

     sizeOfData = sizeOfTOC;
     for (uint32_t section = 1; section <= tableStart; section++) {
+        /* Fil-C: guard the accumulation against overflow. sectionSizes[]
+           entries are untrusted 32-bit values on the file/archive path; a
+           wrapped sizeOfData would defeat the truncation check below. */
+        if (sectionSizes[section] > uint32_t(INT32_MAX - sizeOfData) / uint32_t(sizeof(table[0]))) {
+            goto invalidFormat;
+        }
         sizeOfData += sectionSizes[section] * sizeof(table[0]);
     }
-    if (dataLength < sizeOfData) {
+    if (isDataLengthKnown && dataLength < sizeOfData) {
         // Truncated file!
         goto invalidFormat;
     }
