URL: https://github.com/openssl/openssl/releases/download/openssl-3.6.5/openssl-3.6.5.tar.gz 1f7fe0f6b2d9c46f70eee94d4e8700cf754623e9764af424e3eb9a9127d77999
URL: https://www.openssl.org/source/openssl-3.6.5.tar.gz 1f7fe0f6b2d9c46f70eee94d4e8700cf754623e9764af424e3eb9a9127d77999
Origname: openssl-3.6.5
Name: sarcastic-openssl

    openssl with the Fil-C port (constant-time crypto and assembly handled by the sarcasm assembler, so it is completely memory safe; does not rely on any zunsafe API).
diff --git a/sarcastic-openssl/Configurations/shared-info.pl b/sarcastic-openssl/Configurations/shared-info.pl
--- a/sarcastic-openssl/Configurations/shared-info.pl
+++ b/sarcastic-openssl/Configurations/shared-info.pl
@@ -31,7 +31,11 @@
     'linux-shared' => sub {
         return {
             %{$shared_info{'gnu-shared'}},
-            shared_defflag    => '-Wl,--version-script=',
+            # Fil-C's clang only pizlonates (translates) version scripts that
+            # are passed as a direct --version-script= option; the -Wl, form
+            # bypasses that handling and produces shared libraries that export
+            # none of the pizlonated API symbols.
+            shared_defflag    => '--version-script=',
             dso_ldflags       =>
                 (grep /(?:^|\s)-fsanitize/,
                  @{$config{CFLAGS}}, @{$config{cflags}})
@@ -40,10 +44,11 @@
         };
     },
     'bsd-gcc-shared' => sub { return $shared_info{'linux-shared'}; },
-    'bsd-gcc-nodef-shared' => sub { 
+    'bsd-gcc-nodef-shared' => sub {
         return {
             %{$shared_info{'gnu-shared'}},
-            shared_defflags     => '-Wl,--version-script=',
+            # See the comment above about Fil-C and --version-script=.
+            shared_defflags     => '--version-script=',
         };
     },
     'darwin-shared' => {
