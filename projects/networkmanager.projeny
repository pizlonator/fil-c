  */

 static inline void *c_rbnode_raw(CRBNode *n) {
-        return (void *)(n->__parent_and_flags & ~C_RBNODE_FLAG_MASK);
+        /* Fil-C: return the raw pointer through the real pointer members
+         * (see the CRBNode comment in c-rbtree.h) -- when C_RBNODE_ROOT is
+         * set the union holds the CRBTree back-pointer, otherwise the
+         * parent node. */
+        return (n->__flags & C_RBNODE_ROOT) ? (void *)n->__tree
+                                            : (void *)n->__parent;
 }

 static inline unsigned long c_rbnode_flags(CRBNode *n) {
-        return n->__parent_and_flags & C_RBNODE_FLAG_MASK;
+        return n->__flags & C_RBNODE_FLAG_MASK;
 }

 static inline _Bool c_rbnode_is_red(CRBNode *n) {
diff --git a/networkmanager/src/c-rbtree/src/c-rbtree.c b/networkmanager/src/c-rbtree/src/c-rbtree.c
--- a/networkmanager/src/c-rbtree/src/c-rbtree.c
+++ b/networkmanager/src/c-rbtree/src/c-rbtree.c
@@ -407,7 +407,9 @@
  * function is provided.
  */
 static inline void c_rbnode_set_parent_and_flags(CRBNode *n, CRBNode *p, unsigned long flags) {
-        n->__parent_and_flags = (unsigned long)p | flags;
+        /* Fil-C: split parent pointer + flags (see c-rbtree.h). */
+        n->__parent = p;
+        n->__flags = flags;
 }

 /*
@@ -435,8 +437,13 @@
         CRBTree *t = NULL;

         if (c_rbnode_is_root(n)) {
-                t = c_rbnode_raw(n);
-                n->__parent_and_flags = c_rbnode_flags(n) & ~C_RBNODE_ROOT;
+                /* Fil-C: fetch the tree back-pointer from the real pointer
+                 * member, then clear both the flag and the pointer (the
+                 * parent slot goes stale during rotation, exactly like
+                 * upstream where the raw pointer bits were dropped). */
+                t = n->__tree;
+                n->__parent = NULL;
+                n->__flags &= ~C_RBNODE_ROOT;
         }

         return t;
@@ -445,10 +452,10 @@
 /* counter-part to c_rbnode_pop_root() */
 static inline CRBTree *c_rbnode_push_root(CRBNode *n, CRBTree *t) {
         if (t) {
-                if (n)
-                        n->__parent_and_flags = (unsigned long)t
-                                                | c_rbnode_flags(n)
-                                                | C_RBNODE_ROOT;
+                if (n) {
+                        n->__tree = t;
+                        n->__flags |= C_RBNODE_ROOT;
+                }
                 c_rbtree_store(&t->root, n);
         }

diff --git a/networkmanager/src/c-rbtree/src/c-rbtree.h b/networkmanager/src/c-rbtree/src/c-rbtree.h
--- a/networkmanager/src/c-rbtree/src/c-rbtree.h
+++ b/networkmanager/src/c-rbtree/src/c-rbtree.h
@@ -73,11 +73,24 @@
 struct CRBNode {
         /** Anonymous union for alignment guarantees */
         union {
-                /** Internal state encoding the parent pointer and state */
-                unsigned long __parent_and_flags;
-                /* enforce >=4-byte alignment for @__parent_and_flags */
-                alignas(4) unsigned char __align_dummy;
+                /** Fil-C: upstream stores the parent pointer (or, when
+                 * C_RBNODE_ROOT is set, the CRBTree back-pointer) plus the
+                 * two flag bits packed into a single unsigned long
+                 * (__parent_and_flags), and round-trips that through
+                 * integer->pointer casts on every access.  Under fil-C an
+                 * integer->pointer cast yields a pointer with null
+                 * metadata, so every parent dereference panics ("cannot
+                 * read pointer with null object" -- observed in
+                 * c_rbnode_unlink_stale on n-acd's timer path right after
+                 * a DHCP lease is acquired).  Keep the pointers in real
+                 * pointer members and the flags in their own word: same
+                 * information, same semantics, provenance preserved. */
+                /** Parent node, or the CRBTree when C_RBNODE_ROOT is set */
+                CRBNode *__parent;
+                CRBTree *__tree;
         };
+        /** Color (C_RBNODE_RED) and root (C_RBNODE_ROOT) flags */
+        unsigned long __flags;
         /** Left child, or NULL */
         CRBNode *left;
         /** Right child, or NULL */
@@ -93,7 +106,10 @@
  *
  * Return: Evaluates to the initializer for `_var`.
  */
-#define C_RBNODE_INIT(_var) { .__parent_and_flags = (unsigned long)&(_var) }
+/* Fil-C: parent = self (unlinked state), no flags (upstream packed the
+ * self-pointer into __parent_and_flags with no flag bits -- identical
+ * semantics with the split members). */
+#define C_RBNODE_INIT(_var) { .__parent = &(_var), .__flags = 0 }

 CRBNode *c_rbnode_leftmost(CRBNode *n);
 CRBNode *c_rbnode_rightmost(CRBNode *n);
@@ -204,9 +220,9 @@
  * Return: Pointer to parent.
  */
 static inline CRBNode *c_rbnode_parent(CRBNode *n) {
-        return (n->__parent_and_flags & C_RBNODE_ROOT) ?
+        return (n->__flags & C_RBNODE_ROOT) ?
                         NULL :
-                        (void *)(n->__parent_and_flags & ~C_RBNODE_FLAG_MASK);
+                        n->__parent;
 }

