diff --git a/networkmanager/meson.build b/networkmanager/meson.build
--- a/networkmanager/meson.build
+++ b/networkmanager/meson.build
@@ -290,7 +290,17 @@
   ],
   compile_args: [
     '-DGLIB_VERSION_MIN_REQUIRED=GLIB_VERSION_2_42',
-    '-DGLIB_VERSION_MAX_ALLOWED=GLIB_VERSION_2_42',
+    # Fil-C: the pizlonated glib's gtype.h routes the G_DEFINE_TYPE /
+    # G_DEFINE_INTERFACE once-init boilerplate through the pointer-based
+    # _g_type_once_init_* forms only when GLIB_VERSION_MAX_ALLOWED >=
+    # 2.80; with the upstream 2.42 pin the macros fall back to gsize
+    # statics + plain g_once_init_enter/leave, and under fil-C GType is
+    # a pointer (struct _GTypeOpaque *), so every gdbus-codegen-generated
+    # type definition fails with int-to-pointer conversions.  Raise only
+    # the MAX_ALLOWED pin (the libportal house pattern: MIN_REQUIRED
+    # keeps upstream's 2.42 deprecation semantics; MAX_ALLOWED just
+    # selects the pointer-based boilerplate forms).
+    '-DGLIB_VERSION_MAX_ALLOWED=GLIB_VERSION_2_80',
   ]
 )

diff --git a/networkmanager/src/c-rbtree/src/c-rbtree-private.h b/networkmanager/src/c-rbtree/src/c-rbtree-private.h
--- a/networkmanager/src/c-rbtree/src/c-rbtree-private.h
+++ b/networkmanager/src/c-rbtree/src/c-rbtree-private.h
