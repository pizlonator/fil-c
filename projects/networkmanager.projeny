 get_symbols_missing() {
+    # Fil-C: with ppp=false and ifcfg_rh=false (the Pizlix chroot has no
+    # pppd and no Fedora ifcfg), NO plugin .so files are built at all, so
+    # the pipeline below feeds empty input to the two greps -- and a grep
+    # that selects zero lines exits 1, which under `set -e` +
+    # `set -o pipefail` kills this script silently.  The daemon of a
+    # plugin-less build exports nothing to plugins anyway, so an empty
+    # result is the correct answer: tolerate it with || true.
     (for f in $(find ./src/core/settings/plugins/*/${libs} \
                      ./src/core/devices/*/${libs} \
                      ./src/core/ppp/${libs} -name '*.so' 2>/dev/null); do
@@ -68,7 +75,7 @@
     done) |
         _sort |
         grep -Fx -f <(get_symbols_explicit) -v |
-        grep -Fx -f <(get_symbols_nm)
+        grep -Fx -f <(get_symbols_nm) || true
 }

 pretty() {
@@ -105,6 +112,14 @@
 # this file is generated by $0
 {
 global:
+	# Fil-C: the device plugins (libnm-device-plugin-wifi.so etc. in
+	# NMPLUGINDIR) are fil-C objects referencing the daemon's functions
+	# through pizlonated_-prefixed forwarders -- without this glob their
+	# dlopen() fails with undefined pizlonated_nm_* symbols and the
+	# manager logs "'wifi' plugin not available; creating generic
+	# device".  Same house fix as the libnl *.sym / libnm.ver files.
+	pizlonated_*;
+
 $SYMBOLS_MISSING

 $SYMBOLS_EXPLICIT
