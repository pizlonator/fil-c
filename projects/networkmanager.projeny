diff --git a/networkmanager/src/libnm-client-impl/libnm.ver b/networkmanager/src/libnm-client-impl/libnm.ver
--- a/networkmanager/src/libnm-client-impl/libnm.ver
+++ b/networkmanager/src/libnm-client-impl/libnm.ver
@@ -8,6 +8,15 @@
 # version, at the bottom of the file.
 libnm_1_0_0 {
 global:
+	# Fil-C: the pizlonated_ function-object forwarders (one per exported
+	# function, emitted by the fil-C compiler) must be exported too --
+	# clients (nmcli, the introspection examples, gjs via the typelib's
+	# C symbols) reference libnm's functions through the pizlonated_
+	# names, and with `local: *` they were hidden, leaving those
+	# references undefined at executable link time.  glib, which has no
+	# version script, exports its forwarders by default -- the working
+	# pattern this matches (same fix as the libnl *.sym files).
+	pizlonated_*;
 	nm_802_11_ap_flags_get_type;
 	nm_802_11_ap_security_flags_get_type;
 	nm_802_11_mode_get_type;
diff --git a/networkmanager/src/libnm-client-public/nm-enum-types.c.template b/networkmanager/src/libnm-client-public/nm-enum-types.c.template
--- a/networkmanager/src/libnm-client-public/nm-enum-types.c.template
+++ b/networkmanager/src/libnm-client-public/nm-enum-types.c.template
@@ -14,9 +14,14 @@
 GType
 @enum_name@_get_type (void)
 {
-  static volatile gsize g_define_type_id__volatile = 0;
+  /* Fil-C: GType is a pointer in the pizlonated glib, so the once-init
+   * static must be pointer-typed and the g_once_init_enter_pointer /
+   * g_once_init_leave_pointer variants must be used (the plain functions
+   * access the location through a gsize view, which fil-C rejects as a
+   * type confusion).  Same conversion as the libportal enum template. */
+  static gpointer g_define_type_id__volatile = 0;

-  if (g_once_init_enter (&g_define_type_id__volatile))
+  if (g_once_init_enter_pointer (&g_define_type_id__volatile))
     {
       static const G@Type@Value values[] = {
 /*** END value-header ***/
@@ -30,10 +35,10 @@
       };
       GType g_define_type_id =
         g_@type@_register_static (g_intern_static_string ("@EnumName@"), values);
-      g_once_init_leave (&g_define_type_id__volatile, g_define_type_id);
+      g_once_init_leave_pointer (&g_define_type_id__volatile, g_define_type_id);
     }

-  return g_define_type_id__volatile;
+  return (GType) g_define_type_id__volatile;
 }

 /*** END value-tail ***/
diff --git a/networkmanager/src/libnm-glib-aux/nm-hash-utils.h b/networkmanager/src/libnm-glib-aux/nm-hash-utils.h
--- a/networkmanager/src/libnm-glib-aux/nm-hash-utils.h
+++ b/networkmanager/src/libnm-glib-aux/nm-hash-utils.h
@@ -138,7 +138,16 @@
 /* NM_HASH_COMBINE_VALS() is faster then nm_hash_update_val() as it combines multiple
  * calls to nm_hash_update() using a packed structure. */
 #define NM_HASH_COMBINE_VALS(var, ...)                                         \
-    const struct _nm_packed {                                                  \
+    /* Fil-C: upstream packs this combine-struct so that sizeof() covers the   \
+     * fields densely; under fil-C that creates unaligned 8-byte fields        \
+     * (e.g. guint8 + guint64 in a _nm_packed struct puts the guint64 at       \
+     * offset 1), and the initializer's 8-byte store then trips fil-C's        \
+     * alignment check ("expected 9 writable bytes with ptr aligned to 8       \
+     * bytes at offset 1").  Drop the packing: the struct only feeds a         \
+     * per-run randomized siphash via nm_hash_update(state, &_val,             \
+     * sizeof(_val)), so nothing depends on the byte layout or the hash        \
+     * values being stable across builds. */                                   \
+    const struct {                                                             \
         NM_VA_ARGS_FOREACH(, , , _NM_HASH_COMBINE_VALS_TYPE_OP, , __VA_ARGS__) \
     } var _nm_alignas(max_align_t) = {                                         \
         NM_VA_ARGS_FOREACH(, , , _NM_HASH_COMBINE_VALS_INIT_OP, , __VA_ARGS__)}
diff --git a/networkmanager/src/libnm-glib-aux/nm-random-utils.c b/networkmanager/src/libnm-glib-aux/nm-random-utils.c
--- a/networkmanager/src/libnm-glib-aux/nm-random-utils.c
+++ b/networkmanager/src/libnm-glib-aux/nm-random-utils.c
@@ -183,9 +183,8 @@
 static void
 _bad_random_init_seed(BadRandSeed *seed)
 {
-    const guint8 *p_at_random;
-    int           seed_idx;
-    GRand        *rand;
