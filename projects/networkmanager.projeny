diff --git a/networkmanager/src/core/nm-config-data.c b/networkmanager/src/core/nm-config-data.c
--- a/networkmanager/src/core/nm-config-data.c
+++ b/networkmanager/src/core/nm-config-data.c
@@ -16,6 +16,31 @@

 /*****************************************************************************/

+/* Fil-C: the NM_CON_DEFAULT() table (see nm-config-data.h).  Upstream
+ * populates it via pointer globals placed in the "connection_defaults"
+ * section and iterates the linker-provided __start/__stop boundaries;
+ * fil-C discards custom sections for pointer globals and renames
+ * cross-TU references, so the section cannot work.  Only the tests (not
+ * built) populate the table, so production runs with an empty table --
+ * exactly what this real fil-C global provides (begin == end). */
+static const char *const nm_connection_defaults_table[] = {
+    NULL,
+};
+
+const char *const *
+nm_connection_defaults_begin(void)
+{
+    return nm_connection_defaults_table;
+}
+
+const char *const *
+nm_connection_defaults_end(void)
+{
+    return nm_connection_defaults_table;
+}
+
+/*****************************************************************************/
+
 typedef struct {
     char    *group_name;
     gboolean stop_match;
@@ -1765,14 +1790,14 @@

 #if NM_MORE_ASSERTS > 10
     {
-        const char **ptr;
+        const char *const *ptr;

-        for (ptr = __start_connection_defaults; ptr < __stop_connection_defaults; ptr++) {
+        for (ptr = nm_connection_defaults_begin(); ptr < nm_connection_defaults_end(); ptr++) {
             if (nm_streq(property, *ptr))
                 break;
         }

-        nm_assert(ptr < __stop_connection_defaults);
+        nm_assert(ptr < nm_connection_defaults_end());
     }
 #endif

diff --git a/networkmanager/src/core/nm-config-data.h b/networkmanager/src/core/nm-config-data.h
--- a/networkmanager/src/core/nm-config-data.h
+++ b/networkmanager/src/core/nm-config-data.h
@@ -197,8 +197,21 @@

 const char *nm_config_data_get_iwd_config_path(const NMConfigData *self);

-extern const char *__start_connection_defaults[];
-extern const char *__stop_connection_defaults[];
+/* Fil-C: upstream declares the linker-provided section boundaries
+ * (__start_connection_defaults/__stop_connection_defaults, auto-created by
+ * ld for the orphan "connection_defaults" section that NM_CON_DEFAULT()
+ * populates) as extern arrays of pointers.  Two fil-C problems: (1) every
+ * cross-TU data reference goes through pizlonated_-prefixed metadata
+ * symbols, which the linker's auto-provisioning never creates, so the
+ * references stay undefined at link time; and (2) fil-C discards custom
+ * section placement for pointer-typed globals entirely (they become
+ * fil-C-managed globals with lazily-initialized metadata), so the section
+ * is empty anyway.  Production builds populate the table only via
+ * NM_CON_DEFAULT() in the tests (not built here), so the table is always
+ * empty: expose it as accessor functions over a real (empty) fil-C global
+ * table instead of linker-provided boundaries. */
+const char *const *nm_connection_defaults_begin(void);
+const char *const *nm_connection_defaults_end(void);

 #define NM_CON_DEFAULT_NOP(name)                               \
     static const char  *NM_UNIQ_T(connection_default, NM_UNIQ) \
