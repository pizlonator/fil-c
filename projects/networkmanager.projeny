URL: https://download.gnome.org/sources/NetworkManager/1.48/NetworkManager-1.48.4.tar.xz 80c1d0a2cd44da8f35f0c488c0c6ecd8c16badd88a24209711c62ca5da70351a
Origname: NetworkManager-1.48.4
Name: networkmanager

    NetworkManager 1.48.4 (the network daemon behind the GNOME network
    indicator; the GNOME 46-era release matching the chroot's stack).
    Meson build with every optional dependency pinned to the chroot:
    session_tracking/suspend_resume=elogind, polkit=true,
    crypto=gnutls, dhcp=internal (vendored nettools, no external DHCP
    client), dns rc-manager=auto (writes /etc/resolv.conf directly),
    wifi=true wext=false iwd=false, ppp/ovs/modem_manager/teamdctl/
    nmtui/nm_cloud_setup/ebpf/ifupdown/qt/bluez5_dun off, selinux/
    libaudit/systemd_journal off, systemdsystemunitdir=no (sysvinit),
    introspection=true (NM-1.0.gir/typelib for gjs), vapi/docs/tests
    off, more_asserts=0, ld_gc=false (house pattern: no gc-sections
    under fil-C).  jansson is probed required:false (absent OK).  NM
    does NOT need libnl (own netlink stack in src/libnm-platform).
    Fil-C changes: see the committed patch (vendored c-list/c-rbtree/
    c-siphash/c-stdaux + the libnm-platform netlink parsers are the
    first-time-compiled risk spots).
diff --git a/networkmanager/linker-script-devices.ver b/networkmanager/linker-script-devices.ver
--- a/networkmanager/linker-script-devices.ver
+++ b/networkmanager/linker-script-devices.ver
@@ -1,5 +1,13 @@
 {
 global:
+	# Fil-C: the fil-C dlsym/g_module_symbol wrapper looks functions up
+	# under their pizlonated_ forwarder names, and fil-C objects
+	# reference the daemon/plugin's functions the same way -- with only
+	# `local: *;` the forwarders were hidden and the plugin failed to
+	# load (g_module_symbol("nm_device_factory_create") could not find
+	# pizlonated_nm_device_factory_create).  Export them (same house fix
+	# as the libnl *.sym files and libnm.ver).
+	pizlonated_*;
 	nm_device_factory_create;
 local:
 	*;
