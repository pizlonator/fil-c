URL: https://duktape.org/duktape-2.7.0.tar.xz b0a17da888847bc9c73624ae3ba7f858ec327a9bbce9d287aee6a2489e518448
Origname: duktape-2.7.0
Name: duktape

    duktape 2.7.0 (embeddable JS engine) — required by polkit 126 for its JS rule authority (polkit 126 uses a system duktape; 0.116 bundled its own).
diff --git a/duktape/src/duktape.c b/duktape/src/duktape.c
--- a/duktape/src/duktape.c
+++ b/duktape/src/duktape.c
@@ -19422,7 +19422,6 @@
 	duk_tval *pre_top;
 	duk_tval *pre_end;
 	duk_tval *pre_alloc_end;
-	duk_ptrdiff_t ptr_diff;
 	duk_tval *new_valstack;
 	duk_size_t new_alloc_size;
 	duk_tval *tv_prev_alloc_end;
@@ -19520,13 +19519,29 @@
 	/* Write new pointers.  Most pointers can be handled as a pointer
 	 * difference.
 	 */
-	ptr_diff = (duk_ptrdiff_t) ((duk_uint8_t *) new_valstack - (duk_uint8_t *) thr->valstack);
-	tv_prev_alloc_end = (duk_tval *) (void *) ((duk_uint8_t *) thr->valstack_alloc_end + ptr_diff);
-	thr->valstack = new_valstack;
-	thr->valstack_bottom = (duk_tval *) (void *) ((duk_uint8_t *) thr->valstack_bottom + ptr_diff);
-	thr->valstack_top = (duk_tval *) (void *) ((duk_uint8_t *) thr->valstack_top + ptr_diff);
-	thr->valstack_end = (duk_tval *) (void *) ((duk_uint8_t *) thr->valstack_end + ptr_diff);
-	thr->valstack_alloc_end = (duk_tval *) (void *) ((duk_uint8_t *) new_valstack + new_alloc_size);
+	/* Fil-C: rebase bottom/top/end/alloc_end against the NEW base pointer
+	 * (with offsets computed from old-vs-old differences, taken BEFORE
+	 * thr->valstack is replaced) instead of the upstream
+	 * old_ptr + (new_base - old_base) trick.  Under Fil-C every pointer
+	 * carries the provenance of the object it came from, so
+	 * "old_ptr + (new - old)" would keep the OLD (now realloc'ed-away)
+	 * object's provenance while its address lands inside the new
+	 * allocation; any later store through such a rebased pointer
+	 * ("cannot write pointer to free object" in duk__resize_valstack)
+	 * trips the Fil-C safety check.  New base + plain-integer-offset keeps
+	 * the new object's provenance, which is what we want. */
+	{
+		duk_ptrdiff_t off_bottom = (duk_ptrdiff_t) (thr->valstack_bottom - thr->valstack);
+		duk_ptrdiff_t off_top = (duk_ptrdiff_t) (thr->valstack_top - thr->valstack);
+		duk_ptrdiff_t off_end = (duk_ptrdiff_t) (thr->valstack_end - thr->valstack);
+		duk_ptrdiff_t off_alloc_end = (duk_ptrdiff_t) (thr->valstack_alloc_end - thr->valstack);
+		tv_prev_alloc_end = new_valstack + off_alloc_end;
+		thr->valstack = new_valstack;
+		thr->valstack_bottom = new_valstack + off_bottom;
+		thr->valstack_top = new_valstack + off_top;
+		thr->valstack_end = new_valstack + off_end;
+		thr->valstack_alloc_end = (duk_tval *) (void *) ((duk_uint8_t *) new_valstack + new_alloc_size);
+	}

 	/* Assertions: pointer sanity after pointer updates. */
 	DUK_ASSERT(thr->valstack_bottom >= thr->valstack);
