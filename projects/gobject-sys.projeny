+// Fil-C port: GType is a pointer (see the glib-sys patch -- glib 2.80
+// declares it in C as `typedef struct _GTypeOpaque *GType;`).  The
+// fundamental type IDs are integer-cast pointers, exactly like C's
+// G_TYPE_MAKE_FUNDAMENTAL(x) macro: ((GType) ((x) <<
+// G_TYPE_FUNDAMENTAL_SHIFT)).  Fundamentals are never dereferenced through
+// their GType (glib resolves them through static_fundamental_type_nodes),
+// so like in C the cast yields a capability-less pointer that is only ever
+// compared or re-expanded by address.
+pub const G_TYPE_INVALID: GType = GType((0 << G_TYPE_FUNDAMENTAL_SHIFT) as *const GTypeOpaque);
+pub const G_TYPE_NONE: GType = GType((1 << G_TYPE_FUNDAMENTAL_SHIFT) as *const GTypeOpaque);
+pub const G_TYPE_INTERFACE: GType = GType((2 << G_TYPE_FUNDAMENTAL_SHIFT) as *const GTypeOpaque);
+pub const G_TYPE_CHAR: GType = GType((3 << G_TYPE_FUNDAMENTAL_SHIFT) as *const GTypeOpaque);
+pub const G_TYPE_UCHAR: GType = GType((4 << G_TYPE_FUNDAMENTAL_SHIFT) as *const GTypeOpaque);
+pub const G_TYPE_BOOLEAN: GType = GType((5 << G_TYPE_FUNDAMENTAL_SHIFT) as *const GTypeOpaque);
+pub const G_TYPE_INT: GType = GType((6 << G_TYPE_FUNDAMENTAL_SHIFT) as *const GTypeOpaque);
+pub const G_TYPE_UINT: GType = GType((7 << G_TYPE_FUNDAMENTAL_SHIFT) as *const GTypeOpaque);
+pub const G_TYPE_LONG: GType = GType((8 << G_TYPE_FUNDAMENTAL_SHIFT) as *const GTypeOpaque);
+pub const G_TYPE_ULONG: GType = GType((9 << G_TYPE_FUNDAMENTAL_SHIFT) as *const GTypeOpaque);
+pub const G_TYPE_INT64: GType = GType((10 << G_TYPE_FUNDAMENTAL_SHIFT) as *const GTypeOpaque);
+pub const G_TYPE_UINT64: GType = GType((11 << G_TYPE_FUNDAMENTAL_SHIFT) as *const GTypeOpaque);
+pub const G_TYPE_ENUM: GType = GType((12 << G_TYPE_FUNDAMENTAL_SHIFT) as *const GTypeOpaque);
+pub const G_TYPE_FLAGS: GType = GType((13 << G_TYPE_FUNDAMENTAL_SHIFT) as *const GTypeOpaque);
+pub const G_TYPE_FLOAT: GType = GType((14 << G_TYPE_FUNDAMENTAL_SHIFT) as *const GTypeOpaque);
+pub const G_TYPE_DOUBLE: GType = GType((15 << G_TYPE_FUNDAMENTAL_SHIFT) as *const GTypeOpaque);
+pub const G_TYPE_STRING: GType = GType((16 << G_TYPE_FUNDAMENTAL_SHIFT) as *const GTypeOpaque);
+pub const G_TYPE_POINTER: GType = GType((17 << G_TYPE_FUNDAMENTAL_SHIFT) as *const GTypeOpaque);
+pub const G_TYPE_BOXED: GType = GType((18 << G_TYPE_FUNDAMENTAL_SHIFT) as *const GTypeOpaque);
+pub const G_TYPE_PARAM: GType = GType((19 << G_TYPE_FUNDAMENTAL_SHIFT) as *const GTypeOpaque);
+pub const G_TYPE_OBJECT: GType = GType((20 << G_TYPE_FUNDAMENTAL_SHIFT) as *const GTypeOpaque);
+pub const G_TYPE_VARIANT: GType = GType((21 << G_TYPE_FUNDAMENTAL_SHIFT) as *const GTypeOpaque);

