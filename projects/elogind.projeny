URL: https://github.com/elogind/elogind/archive/v255.27/elogind-255.27.tar.gz ad3579ff065a5b8d9ab79dcc33a64f681c256c52692994e9c2a942c0073c5d39
Origname: elogind-255.27
Name: elogind

    Fil-C patch for elogind
diff --git a/elogind/src/basic/memfd-util.c b/elogind/src/basic/memfd-util.c
--- a/elogind/src/basic/memfd-util.c
+++ b/elogind/src/basic/memfd-util.c
@@ -46,7 +46,11 @@
                  * a hint indicating our library implementation, and
                  * add the thread name to it */

-                assert_se(prctl(PR_GET_NAME, (unsigned long) pr) >= 0);
+                /* Fil-C: never cast a pointer to an integer when passing it through a
+                 * variadic function - the pointer must keep its object identity or the
+                 * Fil-C runtime correctly panics when the kernel writes the thread name
+                 * through it.  See filc_native_zsys_prctl. */
+                assert_se(prctl(PR_GET_NAME, pr) >= 0);

                 if (isempty(pr))
                         name = "sd";
diff --git a/elogind/src/basic/process-util.c b/elogind/src/basic/process-util.c
--- a/elogind/src/basic/process-util.c
+++ b/elogind/src/basic/process-util.c
@@ -1938,7 +1938,11 @@
         if (getpid_cached() == 1)
                 return true;

-        if (prctl(PR_GET_CHILD_SUBREAPER, (unsigned long) &b, 0UL, 0UL, 0UL) < 0)
+        /* Fil-C: never cast a pointer to an integer when passing it through a variadic
+         * function - the pointer must keep its object identity or the Fil-C runtime
+         * correctly panics when the kernel writes the subreaper flag through it.  See
+         * filc_native_zsys_prctl. */
+        if (prctl(PR_GET_CHILD_SUBREAPER, &b, 0UL, 0UL, 0UL) < 0)
                 return -errno;

         return b != 0;
diff --git a/elogind/src/basic/sigbus.c b/elogind/src/basic/sigbus.c
--- a/elogind/src/basic/sigbus.c
+++ b/elogind/src/basic/sigbus.c
@@ -12,6 +12,14 @@
 #include "sigbus.h"
 #include "signal-util.h"

+/* Fil-C: the pizlonator runtime owns SIGBUS handling (it relies on the signal
+ * internally, and a program re-registering a SIGBUS handler trips a runtime
+ * assertion - loginctl aborted exactly that way).  elogind's SIGBUS workaround
+ * (remap a faulting mmap page so execution can continue) must therefore not
+ * run under Fil-C, so the whole mechanism below is compiled out and
+ * sigbus_install()/sigbus_pop() are empty functions with unchanged
+ * signatures. */
+#if 0
 #define SIGBUS_QUEUE_MAX 64

 static struct sigaction old_sigaction;
@@ -122,35 +130,15 @@
         assert_se(mmap(aligned, page_size(), PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED, -1, 0) == aligned);
 }

-void sigbus_install(void) {
-        struct sigaction sa = {
-                .sa_sigaction = sigbus_handler,
-                .sa_flags = SA_SIGINFO,
-        };
+#endif // Fil-C: the SIGBUS mechanism above is compiled out

-        /* make sure that sysconf() is not called from a signal handler because
-        * it is not guaranteed to be async-signal-safe since POSIX.1-2008 */
-        (void) page_size();
-
-        n_installed++;
-
-        if (n_installed == 1)
-                assert_se(sigaction(SIGBUS, &sa, &old_sigaction) == 0);
-
-        return;
+void sigbus_install(void) {
+        /* Fil-C owns SIGBUS handling; there is nothing to install. */
 }

 #if 0 /// UNNEEDED by elogind
-void sigbus_reset(void) {
-
-        if (n_installed <= 0)
-                return;
-
-        n_installed--;
-
-        if (n_installed == 0)
-                assert_se(sigaction(SIGBUS, &old_sigaction, NULL) == 0);
-
-        return;
+int sigbus_pop(void **ret) {
+        (void) ret;
+        return 0;
 }
 #endif // 0
diff --git a/elogind/src/libelogind/libelogind.sym b/elogind/src/libelogind/libelogind.sym
--- a/elogind/src/libelogind/libelogind.sym
+++ b/elogind/src/libelogind/libelogind.sym
@@ -9,6 +9,8 @@

 LIBSYSTEMD_209 {
 global:
+        /* Fil-C: the pizlonator renames symbols with a pizlonated_ prefix. */
+        pizlonated*;
         /* sd-journal */
         sd_journal_print;
         sd_journal_printv;
diff --git a/elogind/src/libelogind/sd-bus/bus-error.c b/elogind/src/libelogind/sd-bus/bus-error.c
--- a/elogind/src/libelogind/sd-bus/bus-error.c
+++ b/elogind/src/libelogind/sd-bus/bus-error.c
@@ -53,10 +53,22 @@
         SD_BUS_ERROR_MAP_END
 };

-/* GCC maps this magically to the beginning and end of the BUS_ERROR_MAP section */
-extern const sd_bus_error_map __start_SYSTEMD_BUS_ERROR_MAP[];
-extern const sd_bus_error_map __stop_SYSTEMD_BUS_ERROR_MAP[];
+/// elogind-FilC-begin
+/* Fil-C: GCC maps these magically to the beginning and end of the
+   BUS_ERROR_MAP section, but the pizlonator rewrites symbol references, so
+   the linker-provided __start_/__stop_ boundary symbols never match.  Walk
+   the built-in maps through an ordinary pointer list instead.  Each map is
+   NULL-terminated (SD_BUS_ERROR_MAP_END), which the additional_error_maps
+   scanner below already understands. */
+extern const sd_bus_error_map bus_common_errors[];

+static const sd_bus_error_map *const builtin_error_maps[] = {
+        bus_standard_errors,
+        bus_common_errors,
+        NULL,
+};
+/// elogind-FilC-end
+
 /* Additional maps registered with sd_bus_error_add_map() are in this
  * NULL terminated array */
 static const sd_bus_error_map **additional_error_maps = NULL;
@@ -91,26 +103,22 @@
                                 }
                         }

-        m = ALIGN_PTR(__start_SYSTEMD_BUS_ERROR_MAP);
-        while (m < __stop_SYSTEMD_BUS_ERROR_MAP) {
-                /* For magic ELF error maps, the end marker might
-                 * appear in the middle of things, since multiple maps
-                 * might appear in the same section. Hence, let's skip
-                 * over it, but realign the pointer to the next 8 byte
-                 * boundary, which is the selected alignment for the
-                 * arrays. */
-                if (m->code == BUS_ERROR_MAP_END_MARKER) {
-                        m = ALIGN_PTR(m + 1);
-                        continue;
-                }
+/// elogind-FilC-begin
+        {
+                const sd_bus_error_map *const *bmap;

-                if (streq(m->name, name)) {
-                        assert(m->code > 0);
-                        return m->code;
-                }
+                for (bmap = builtin_error_maps; *bmap; bmap++)
+                        for (m = *bmap;; m++) {
+                                if (m->code == BUS_ERROR_MAP_END_MARKER)
+                                        break;

-                m++;
+                                if (streq(m->name, name)) {
+                                        assert(m->code > 0);
+                                        return m->code;
+                                }
+                        }
         }
+/// elogind-FilC-end

         return EIO;
 }
diff --git a/elogind/src/libelogind/sd-bus/bus-error.h b/elogind/src/libelogind/sd-bus/bus-error.h
--- a/elogind/src/libelogind/sd-bus/bus-error.h
+++ b/elogind/src/libelogind/sd-bus/bus-error.h
@@ -37,13 +37,18 @@
  * warn for the unknown attribute, so just disable -Wattributes.
  */

+/// elogind-FilC-begin
+/* Fil-C: do not place the maps in a magic ELF section.  The section
+   approach relies on the linker synthesizing __start_/__stop_ boundary
+   symbols for the section, but the pizlonator rewrites symbol references
+   to pizlonated-prefixed names, which never match those linker symbols.
+   Plain arrays are used instead and bus-error.c walks them through an
+   ordinary pointer list. */
 #define BUS_ERROR_MAP_ELF_REGISTER                                      \
         _Pragma("GCC diagnostic ignored \"-Wattributes\"")              \
-        _section_("SYSTEMD_BUS_ERROR_MAP")                              \
         _used_                                                          \
-        _retain_                                                        \
-        _alignptr_                                                      \
         _variable_no_sanitize_address_
+/// elogind-FilC-end

 #define BUS_ERROR_MAP_ELF_USE(errors)                                   \
         extern const sd_bus_error_map errors[];                         \
diff --git a/elogind/src/login/pam_elogind.sym b/elogind/src/login/pam_elogind.sym
--- a/elogind/src/login/pam_elogind.sym
+++ b/elogind/src/login/pam_elogind.sym
@@ -4,5 +4,9 @@
 global:
         pam_sm_close_session;
         pam_sm_open_session;
+        /* Fil-C pizlonation exports pizlonated_<name> aliases and libpam's
+         * dlsym looks those up; they must not be caught by "local: *". */
+        pizlonated_pam_sm_close_session;
+        pizlonated_pam_sm_open_session;
 local: *;
 };
diff --git a/elogind/src/shared/async.c b/elogind/src/shared/async.c
--- a/elogind/src/shared/async.c
+++ b/elogind/src/shared/async.c
@@ -1,6 +1,7 @@
 /* SPDX-License-Identifier: LGPL-2.1-or-later */

 #include <errno.h>
+#include <pthread.h>
 #include <stddef.h>
 #include <sys/prctl.h>
 #include <sys/wait.h>
@@ -59,79 +60,51 @@
         return 0;
 }

-/* We encode the fd to close in the userdata pointer as an unsigned value. The highest bit indicates whether
- * we need to fork again */
-#define NEED_DOUBLE_FORK (1U << (sizeof(unsigned) * 8 - 1))
+/* Fil-C: the close job below must not use the raw clone() machinery upstream
+ * relies on.  Upstream spawns it via clone_with_nested_stack(), i.e. glibc's
+ * clone() wrapper with CLONE_FILES so that the child shares our fd table and
+ * closes our descriptor, but the Fil-C user libc stubs that wrapper out with
+ * "clone not implemented." (raw clone() with a nested stack cannot be made
+ * safe by the pizlonator), so asynchronous_close() would panic there - exactly
+ * as seen at shutdown (button_free() -> asynchronous_close()).  The close job
+ * is a trivial close(fd)+exit worker: it needs no mount namespace (elogind's
+ * session management gains nothing from one), and a plain fork() would not do
+ * the job either, since a fork()ed child only closes its own copy of the
+ * descriptor - without CLONE_FILES the parent's fd would stay open.  Hence the
+ * close job runs in a detached thread instead: a thread shares our fd table
+ * exactly like a CLONE_FILES child, it needs no reaping (no double fork, no
+ * zombies, no __WCLONE wait), and the Fil-C runtime implements pthreads
+ * natively (and makes fork() in a process that has threads safe).  If thread
+ * creation fails, we fall back to a synchronous close, which is what upstream
+ * does when its clone fails, too. */

-static int close_func(void *p) {
+static void *close_thread_func(void *p) {
         unsigned v = PTR_TO_UINT(p);

         (void) prctl(PR_SET_NAME, (unsigned long*) "(sd-close)");

-        /* Note: 💣 This function is invoked in a child process created via glibc's clone() wrapper. In such
-         *       children memory allocation is not allowed, since glibc does not release malloc mutexes in
-         *       clone() 💣 */
-
-        if (v & NEED_DOUBLE_FORK) {
-                pid_t pid;
-
-                v &= ~NEED_DOUBLE_FORK;
-
-                /* This inner child will be reparented to the subreaper/PID 1. Here we turn on SIGCHLD, so
-                 * that the reaper knows when it's time to reap. */
-                pid = clone_with_nested_stack(close_func, SIGCHLD|CLONE_FILES, UINT_TO_PTR(v));
-                if (pid >= 0)
-                        return 0;
-        }
-
-        close((int) v); /* no assert() here, we are in the child and the result would be eaten up anyway */
-        return 0;
+        close((int) v); /* no assert() here, we are in a helper thread and the result would be eaten up anyway */
+        return NULL;
 }

 int asynchronous_close(int fd) {
-        unsigned v;
-        pid_t pid;
+        pthread_t thread;
         int r;

         /* This is supposed to behave similar to safe_close(), but actually invoke close() asynchronously, so
          * that it will never block. Ideally the kernel would have an API for this, but it doesn't, so we
-         * work around it, and hide this as a far away as we can.
-         *
-         * It is important to us that we don't use threads (via glibc pthread) in PID 1, hence we'll do a
-         * minimal subprocess instead which shares our fd table via CLONE_FILES. */
+         * work around it, and hide this as a far away as we can. */

         if (fd < 0)
                 return -EBADF; /* already invalid */

         PROTECT_ERRNO;

-        v = (unsigned) fd;
-
-        /* We want to fork off a process that is automatically reaped. For that we'd usually double-fork. But
-         * we can optimize this a bit: if we are PID 1 or a subreaper anyway (the elogind service manager
-         * process qualifies as this), we can avoid the double forking, since the double forked process would
-         * be reparented back to us anyway. */
-        r = is_reaper_process();
-        if (r < 0)
-                log_debug_errno(r, "Cannot determine if we are a reaper process, assuming we are not: %m");
-        if (r <= 0)
-                v |= NEED_DOUBLE_FORK;
-
-        pid = clone_with_nested_stack(close_func, CLONE_FILES | ((v & NEED_DOUBLE_FORK) ? 0 : SIGCHLD), UINT_TO_PTR(v));
-        if (pid < 0)
+        r = pthread_create(&thread, NULL, close_thread_func, UINT_TO_PTR((unsigned) fd));
+        if (r != 0)
                 assert_se(close_nointr(fd) != -EBADF); /* local fallback */
-        else if (v & NEED_DOUBLE_FORK) {
-
-                /* Reap the intermediate child. Key here is that we specify __WCLONE, since we didn't ask for
-                 * any signal to be sent to us on process exit, and otherwise waitid() would refuse waiting
-                 * then.
-                 *
-                 * We usually prefer calling waitid(), but before kernel 4.7 it didn't support __WCLONE while
-                 * waitpid() did. Hence let's use waitpid() here, it's good enough for our purposes here. */
-                for (;;)
-                        if (waitpid(pid, NULL, __WCLONE) >= 0 || errno != EINTR)
-                                break;
-        }
+        else
+                (void) pthread_detach(thread);

         return -EBADF; /* return an invalidated fd */
 }
