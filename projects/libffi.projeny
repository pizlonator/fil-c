+#ifdef __FILC__
+
+/* Fil-C passes arguments through the zcall blob, a byte array that the
+   callee's generic entrypoint decodes.  The blob is laid out like a
+   struct whose fields are the arguments: *slot_size and *slot_align give
+   the size and alignment of the argument's slot.  This mirrors what the
+   Fil-C compiler does on x86-64: integer arguments narrower than a word
+   are promoted to 64-bit slots; __int128 arguments travel as a register
+   pair, so zcall packs them into two 8-byte slots; and other scalars,
+   vectors, and aggregates take a slot of their natural size at their
+   natural alignment.  The natural alignment of an aggregate is the ABI
+   alignment that the compiler computes for the aggregate's type, which
+   it derives from the types of the aggregate's elements.  Over-alignment
+   declared on the C type only affects where the compiler places the
+   argument copy, not the blob layout, so recompute the alignment from
+   the elements rather than trusting ffi_type's alignment field, which
+   records the declared alignment.  Fall back to the recorded alignment
+   if the elements are not available.  */
+
+static void
+filc_arg_slot (ffi_type *ty, long *slot_size, long *slot_align)
+{
+  *slot_size = ty->size;
+  *slot_align = ty->alignment;
+  if (*slot_align < 8)
+    *slot_align = 8;
+
+  switch (ty->type)
+    {
+    case FFI_TYPE_SINT8:
+    case FFI_TYPE_UINT8:
+    case FFI_TYPE_SINT16:
+    case FFI_TYPE_UINT16:
+    case FFI_TYPE_INT:
+    case FFI_TYPE_SINT32:
+    case FFI_TYPE_UINT32:
+      /* Sub-word integer arguments travel in 64-bit slots.  */
+      *slot_size = 8;
+      break;
+    case FFI_TYPE_SINT128:
+    case FFI_TYPE_UINT128:
+      /* __int128 arguments travel as a register pair, and zcall packs
+	 them into 8-byte slots.  */
+      *slot_align = 8;
+      *slot_size = 16;
+      break;
+    case FFI_TYPE_STRUCT:
+    case FFI_TYPE_COMPLEX:
+      if (ty->elements != NULL)
+	{
+	  ffi_type **elem;
+	  size_t natural = 8;
+
+	  for (elem = ty->elements; *elem != NULL; elem++)
+	    {
+	      long elem_size, elem_align;
+
+	      filc_arg_slot (*elem, &elem_size, &elem_align);
+	      if ((size_t) elem_align > natural)
