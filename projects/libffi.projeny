+	 pointing avalue at the slot start hands the wrapped function the
+	 argument at its own type, exactly as if it had been called
+	 directly.  */
+      argp = (char *) FFI_ALIGN (argp, slot_align);
+      avalue[i] = argp;
+      argp += slot_size;
+    }
