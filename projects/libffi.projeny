diff --git a/libffi/configure.host b/libffi/configure.host
--- a/libffi/configure.host
+++ b/libffi/configure.host
@@ -336,6 +336,19 @@
 	;;
 esac

+case "${TARGET}" in
+    X86_64)
+	# Fil-C passes arguments through the zcall blob, so the x86-64
+	# assembly is not needed.
+	SOURCES=ffi64.c
+	;;
+    AARCH64)
+	# Fil-C passes arguments through the zcall blob, so the aarch64
+	# assembly is not needed.
+	SOURCES=ffi.c
+	;;
+esac
+
 # If we failed to configure SOURCES, we can't do anything.
 if test -z "${SOURCES}"; then
   UNSUPPORTED=1
diff --git a/libffi/ffitest.c b/libffi/ffitest.c
new file mode 100644
--- /dev/null
+++ b/libffi/ffitest.c
@@ -0,0 +1,34 @@
+#include <stdio.h>
+#include <ffi.h>
+
+int main()
+{
+    ffi_cif cif;
+    ffi_type *args[1];
+    void *values[1];
+    char *s;
+    ffi_arg rc;
+
+    /* Initialize the argument info vectors */
+    args[0] = &ffi_type_pointer;
+    values[0] = &s;
+
+    /* Initialize the cif */
+    if (ffi_prep_cif(&cif, FFI_DEFAULT_ABI, 1,
+                     &ffi_type_sint, args) == FFI_OK) 
+    {
+        s = "Hello World!";
+        ffi_call(&cif, puts, &rc, values);
+        /* rc now holds the result of the call to puts */
+
+        /* values holds a pointer to the function's arg, so to
+           call puts() again all we need to do is change the
+           value of s */
+        s = "This is cool!";
+        ffi_call(&cif, puts, &rc, values);
+    }
+
+    return 0;
+}
+
+
diff --git a/libffi/ffitest.expected b/libffi/ffitest.expected
