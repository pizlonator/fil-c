diff --git a/util-linux/configure b/util-linux/configure
--- a/util-linux/configure
+++ b/util-linux/configure
@@ -16123,7 +16123,7 @@
           archive_expsym_cmds='echo "{ global:" > $output_objdir/$libname.ver~
             cat $export_symbols | $SED -e "s/\(.*\)/\1;/" >> $output_objdir/$libname.ver~
             echo "local: *; };" >> $output_objdir/$libname.ver~
-            $CC '"$tmp_sharedflag""$tmp_addflag"' $libobjs $deplibs $compiler_flags $wl-soname $wl$soname $wl-version-script $wl$output_objdir/$libname.ver -o $lib'
+            $CC '"$tmp_sharedflag""$tmp_addflag"' $libobjs $deplibs $compiler_flags $wl-soname $wl$soname --version-script=$output_objdir/$libname.ver -o $lib'
         fi

 	case $cc_basename in
@@ -20754,7 +20754,7 @@
 	      archive_expsym_cmds_CXX='echo "{ global:" > $output_objdir/$libname.ver~
                 cat $export_symbols | $SED -e "s/\(.*\)/\1;/" >> $output_objdir/$libname.ver~
                 echo "local: *; };" >> $output_objdir/$libname.ver~
-                $CC -qmkshrobj $libobjs $deplibs $compiler_flags $wl-soname $wl$soname $wl-version-script $wl$output_objdir/$libname.ver -o $lib'
+                $CC -qmkshrobj $libobjs $deplibs $compiler_flags $wl-soname $wl$soname --version-script=$output_objdir/$libname.ver -o $lib'
 	    fi
 	    ;;
 	  *)
@@ -23557,7 +23557,7 @@
     echo "{" >> conftest.map

 fi
-  LDFLAGS="$LDFLAGS -Wl,--version-script,conftest.map"
+  LDFLAGS="$LDFLAGS --version-script=conftest.map"
