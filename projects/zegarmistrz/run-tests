#!/bin/bash
# Copyright (c) 2026 Filip Pizlo. All Rights Reserved.
# zegarmistrz test runner: builds the emulator, compiles guest programs,
# runs them in parallel (xargs -P, JOBS= to tune), checks output/exit codes.
#
# Suites: basic guests (filc hello, static, threads, args), AVX512/AES
# differentials (native vs emulated output), poisoning client requests
# (faults + taint laundering + clear-on-store; faults expect core dumps),
# var-time mode tests (--var-time-op=known/plausible/everything gating for
# the CANNOT_VAR_TIME_OP dimension, incl. exemptions and the EVEX/opmask
# sidecar), the cannot-index check battery for memory-address sites
# (poison-index-addr), the cannot-branch check battery for control-flow
# sites (poison-branch-ctrl), the cannot-index/cannot-branch orthogonality
# battery (poison-ortho; wrong-dimension uses must run clean), the LEA /
# multi-byte-NOP cannot-index exemption guests and the test.c/test2.c
# mirror combos, core-dump gdb check, crash-time stack traces
# (default, --no-stack-trace, -O2 guests, dump-fault policy), --no-core flag,
# and the --history poison-provenance tests (--history trail symbolication on
# a math-derived index fault in every flag spelling -- bare --history, =yes,
# =1, =no, =0, =N, =full -- the dump numbers every displayed line gdb-style
# (inline frames consume numbers and repeat their recorded PC), numbering
# restarting per step under step N: headers -- default-mode invariance without
# the flag, clean-run + syscall-fault semantics unchanged in history mode,
# and the bad-value rejection), plus the kernel-write extent modeling tests
# (syscall-unpoison: kernel-written bytes inside a poisoned buffer must come
# back clean, plain and under --history=full, now covering recvfrom and
# timerfd_settime; syscall-unpoison-ctl: the kernel-untouched timerfd_settime
# new_value input must STAY poisoned and branching on it must fault).
# Does not touch filc/tests or filc/run-tests.
set -u
cd "$(dirname "$0")"

JOBS="${JOBS:-$(nproc 2>/dev/null || echo 8)}"
OUTDIR="test-output"

log() { echo "[run-tests] $*"; }

mkdir -p "$OUTDIR"
# Build emulator.
log "building zegarmistrz..."
if ! make -j"$JOBS" >"$OUTDIR/build.log" 2>&1; then
    log "build FAILED (see $OUTDIR/build.log)"
    tail -20 "$OUTDIR/build.log"
    exit 1
fi

# Compile guests (basic).
log "compiling guests..."
gcc -O2 -o "$OUTDIR/args" tests/args.c || { log "guest compile failed: args"; exit 1; }
gcc -O2 -o "$OUTDIR/threads" tests/threads.c -pthread || { log "guest compile failed: threads"; exit 1; }
gcc -O2 -static -o "$OUTDIR/static_hi" tests/static_hi.c || { log "guest compile failed: static_hi"; exit 1; }
for t in poison_load poison_store poison_branch poison_index poison_unpoison poison_clear poison_syscall poison_launder_branch poison_launder_index poison_launder_clear \
         poison_vt_div poison_vt_clear poison_vt_plausible poison_vt_cmps poison_vt_cpuid poison_vt_rep \
         poison_index_lea poison_index_nop poison_index_lea_prop poison_combo \
         poison_branch_ctrl poison_ortho; do
    gcc -O2 -o "$OUTDIR/$t" "tests/$t.c" 2>/dev/null || { log "guest compile failed: $t"; exit 1; }
done
# LEA/NOP cannot-index exemption guests + the cannot-index address battery
# (vector-load/gather/scatter need AVX/AVX512F+AVX512VL at compile time for
# the inline asm and the 256-bit VSIB gather/scatter intrinsics).
gcc -O2 -mavx -mavx512f -mavx512vl -o "$OUTDIR/poison_index_addr" tests/poison_index_addr.c 2>/dev/null \
    || { log "guest compile failed: poison_index_addr"; exit 1; }
# Var-time special-flag guests: the VPERMILPS (mode-3) guest needs AVX, the
# exemption chain needs RDRAND/RDSEED, and the EVEX masked-load guest needs
# AVX512F (KMOVW + {k}-masked load).
gcc -O2 -mavx -o "$OUTDIR/poison_vt_mode3" tests/poison_vt_mode3.c \
    || { log "guest compile failed: poison_vt_mode3"; exit 1; }
gcc -O2 -mavx -mrdrnd -mrdseed -o "$OUTDIR/poison_vt_exempt" tests/poison_vt_exempt.c \
    || { log "guest compile failed: poison_vt_exempt"; exit 1; }
gcc -O2 -mavx512f -o "$OUTDIR/poison_vt_kmask" tests/poison_vt_kmask.c \
    || { log "guest compile failed: poison_vt_kmask"; exit 1; }
# CPUID presence + header-only client library tests.
gcc -O2 -o "$OUTDIR/cpuid_vendor" tests/cpuid_vendor.c || { log "guest compile failed: cpuid_vendor"; exit 1; }
gcc -O2 -Iinclude -o "$OUTDIR/zegarmistrz_lib" tests/zegarmistrz_lib.c || { log "guest compile failed: zegarmistrz_lib"; exit 1; }
gcc -O2 -Iinclude -o "$OUTDIR/poison_header" tests/poison_header.c || { log "guest compile failed: poison_header"; exit 1; }
# Masked/compress poisoning tests use AVX512 intrinsics (run only under the
# emulator, expecting core dumps like the other poison-* fault tests).
for t in poison_masked_load poison_masked_store poison_compress_expand; do
    gcc -O2 -mavx512f -mavx512bw -mavx512vl -mavx512dq -mavx512vbmi -mavx512vbmi2 \
        -o "$OUTDIR/$t" "tests/$t.c" 2>/dev/null \
        || { log "guest compile failed: $t"; exit 1; }
done
# Instruction-semantics regression guests for the emulator fixes (BSR/BSF,
# PUSHFQ/POPFQ, VEX VPSLL{W,D,Q}/VPSRL{W,D,Q} 3-operand forms, VPSLLDQ,
# VPERMD/VPERMPS, VBROADCASTI128, VPINSR/VPEXTR, VINSERTPS, EVEX
# VPSLLDQ/VPSRLDQ, VSHUFI64X2, VPXORQ k-masks, VPMADD52, VEX VMOVQ/VMOVD
# upper-YMM zeroing) and the decode-cache
# (self-modifying code) guest.  They are self-checking against hardware-
# verified expected values and gate every instruction group on runtime CPUID,
# so they run everywhere (skipping groups the CPU lacks) both natively and
# under the emulator.
gcc -O2 -mavx2 -o "$OUTDIR/insn_fixes" tests/insn_fixes.c \
    || { log "guest compile failed: insn_fixes"; exit 1; }
gcc -O2 -mavx512f -mavx512dq -mavx512vl -mavx512ifma -o "$OUTDIR/insn_fixes_avx512" \
    tests/insn_fixes_avx512.c \
    || { log "guest compile failed: insn_fixes_avx512"; exit 1; }
# Poly1305 chunked-update KAT ([12, 65536, 100] EVP_MAC via libcrypto, the
# test_chacha20_poly1305_large trigger) + VEX VMOVQ/VMOVD upper-YMM zeroing
# regression guest.  Needs AVX at runtime for the instruction groups (gated
# inside the guest) and -mavx at compile time for the inline asm.  Unlike the
# other guests it also needs the OpenSSL dev headers and libcrypto, so a
# compile failure here is an environment gap rather than a regression: leave
# the guest unbuilt and let the test register as SKIPPED below instead of
# aborting the whole run (the compile log lands in $OUTDIR for diagnosis).
HAVE_POLY1305_KAT=""
if gcc -O2 -mavx -o "$OUTDIR/poly1305_kat" tests/poly1305_kat.c -lcrypto \
        2>"$OUTDIR/poly1305_kat.compile.log"; then
    HAVE_POLY1305_KAT=1
else
    log "poly1305_kat compile failed (SKIPPING poly1305-kat; see $OUTDIR/poly1305_kat.compile.log)"
fi
gcc -O2 -o "$OUTDIR/dec_cache" tests/dec_cache.c \
    || { log "guest compile failed: dec_cache"; exit 1; }
# BZHI + glibc-memset-churn regression guest (64-multiple memsets hit
# BZHI index 0 in glibc's evex memset; the old emulator's broken mask
# destroyed glibc's heap top chunk).  Needs BMI2 at runtime (CPUID-gated
# inside the guest) and at compile time for the intrinsics.
gcc -O2 -mbmi2 -o "$OUTDIR/malloc_churn" tests/malloc_churn.c \
    || { log "guest compile failed: malloc_churn"; exit 1; }
# Crash guest for core-dump tests.
cat > "$OUTDIR/crash.c" <<'EOF'
#include <stdio.h>
void boom(void) { volatile int* p = (int*)0x1234; *p = 42; }
int main(void) { printf("before\n"); boom(); return 0; }
EOF
gcc -O0 -g -o "$OUTDIR/crash" "$OUTDIR/crash.c" || { log "guest compile failed: crash"; exit 1; }
gcc -O2 -g -o "$OUTDIR/crash_o2" "$OUTDIR/crash.c" || { log "guest compile failed: crash_o2"; exit 1; }

# Stack-trace guests: shlib symbolication + inline frame expansion.
# NOTE: the guest binary's RUNPATH must be absolute, not '$ORIGIN' -- the
# guest ld.so resolves ORIGIN from /proc/self/exe, which under the emulator
# is the zegarmistrz binary itself, so $ORIGIN would point at the emulator's
# directory and the .so would never be found.
gcc -O2 -g -fPIC -shared -Wl,-soname,stack_trace_shlib.so \
    -o "$OUTDIR/stack_trace_shlib.so" tests/stack_trace_shlib_helper.c \
    || { log "guest compile failed: stack_trace_shlib.so"; exit 1; }
gcc -O2 -g -o "$OUTDIR/stack_trace_shlib" tests/stack_trace_shlib.c \
    "$OUTDIR/stack_trace_shlib.so" -Wl,-rpath,"$(pwd)/$OUTDIR" \
    || { log "guest compile failed: stack_trace_shlib"; exit 1; }
gcc -O2 -g -o "$OUTDIR/stack_trace_inline" tests/stack_trace_inline.c \
    || { log "guest compile failed: stack_trace_inline"; exit 1; }
# --history poison-provenance guest: poison a value, load it, derive an
# address from it with arithmetic, then index memory with it -> fault. The
# -g matters: the recorded trail PCs must BFD-symbolicate to source lines.
gcc -O2 -g -o "$OUTDIR/history_math" tests/history_math.c \
    || { log "guest compile failed: history_math"; exit 1; }
# --history store-recording guest: poison a value, load it through an xmm
# register, store it back from the xmm (the durable store-note path), copy
# the value to a GPR and index memory with it -> fault.
gcc -O2 -g -o "$OUTDIR/history_store" tests/history_store.c \
    || { log "guest compile failed: history_store"; exit 1; }
# --history memory-side provenance guest: poison a buffer, copy it to a
# second buffer byte by byte (load+store round trips), reload from the
# copy, then index memory with the reloaded value -> fault. The -g matters:
# the recorded trail PCs must BFD-symbolicate to source lines.
gcc -O2 -g -o "$OUTDIR/history_memcopy" tests/history_memcopy.c \
    || { log "guest compile failed: history_memcopy"; exit 1; }
# Kernel-write extent modeling guests: poison a static buffer with
# cannot-branch poison, then let the kernel write into it (fstat struct
# stat, ioctl FIONREAD, read, getrandom, recvfrom data bytes + sockaddr +
# socklen word, timerfd_settime old-value itimerspec) and branch on the
# kernel-written bytes. The ctl guest is the soundness half: the
# kernel-untouched timerfd_settime new_value INPUT must STAY poisoned, so
# branching on it must fault (core + cannot-branch reason). The -g is not
# needed here (only the ctl guest faults, and its trail is not checked)
# but keeps the suite uniform.
gcc -O2 -g -o "$OUTDIR/syscall_unpoison" tests/syscall_unpoison.c \
    || { log "guest compile failed: syscall_unpoison"; exit 1; }
gcc -O2 -g -o "$OUTDIR/syscall_unpoison_ctl" tests/syscall_unpoison_ctl.c \
    || { log "guest compile failed: syscall_unpoison_ctl"; exit 1; }

# AVX512/AES differentials: compile only if the host supports them.
HAVE_AVX512=""
if gcc -O2 -mavx2 -mbmi -mbmi2 -msse4.2 -c -o /dev/null -x c /dev/null 2>/dev/null; then
    gcc -O2 -mavx512f -mavx512bw -mavx512vl -mavx512dq -mbmi -mbmi2 -msse4.2 \
        -o "$OUTDIR/vex_smoke" tests/vex_smoke.c \
        || { log "guest compile failed: vex_smoke"; exit 1; }
    HAVE_VEX=1
fi
if gcc -O2 -mavx512f -mavx512bw -mavx512vl -mavx512dq -c -o /dev/null -x c /dev/null 2>/dev/null \
   && grep -q avx512f /proc/cpuinfo; then
    HAVE_AVX512=1
    gcc -O2 -mavx512f -mavx512bw -mavx512vl -mavx512dq -o "$OUTDIR/avx512_smoke" tests/avx512_smoke.c \
        || { log "guest compile failed: avx512_smoke"; exit 1; }
fi
HAVE_AES=""
if grep -qE '\baes\b' /proc/cpuinfo && gcc -O2 -maes -mpclmul -msha -mfma -o "$OUTDIR/aes_smoke" tests/aes_smoke.c 2>/dev/null; then
    HAVE_AES=1
fi

export HAVE_AVX512 HAVE_AES HAVE_VEX HAVE_POLY1305_KAT

# Test list runs in parallel via xargs -P.
{
echo "filc-hello"
echo "static-hi"
echo "threads"
echo "args-exit"
echo "avx512-smoke"
echo "aes-smoke"
echo "vex-smoke"
echo "insn-fixes"
echo "insn-fixes-avx512"
echo "poly1305-kat"
echo "dec-cache"
echo "malloc-churn"
echo "poison-load"
echo "poison-store"
echo "poison-branch"
echo "poison-index"
echo "poison-syscall"
echo "poison-masked-load"
echo "poison-masked-store"
echo "poison-compress-expand"
echo "poison-unpoison"
echo "poison-clear"
echo "poison-launder-branch"
echo "poison-launder-index"
echo "poison-launder-clear"
echo "poison-vt-div"
echo "poison-vt-clear"
echo "poison-vt-plausible"
echo "poison-vt-mode3"
echo "poison-vt-exempt"
echo "poison-vt-kmask"
echo "poison-vt-cmps"
echo "poison-vt-cpuid"
echo "poison-vt-rep"
echo "poison-index-lea"
echo "poison-index-nop"
echo "poison-index-lea-prop"
echo "poison-index-addr"
echo "poison-branch-ctrl"
echo "poison-ortho"
echo "poison-combo"
echo "cpuid-emulated"
echo "cpuid-native"
echo "zeglib-emulated"
echo "zeglib-native"
echo "poison-header"
echo "core-gdb"
echo "stack-trace"
echo "stack-trace-off"
echo "stack-trace-o2"
echo "stack-trace-fault"
echo "stack-trace-shlib"
echo "stack-trace-inline"
echo "history-math"
echo "syscall-unpoison"
echo "syscall-unpoison-ctl"
echo "history-store"
echo "history-memcopy"
echo "history-off"
echo "history-clean"
echo "history-syscall"
echo "history-yes"
echo "history-one"
echo "history-no"
echo "history-zero"
echo "history-2"
echo "history-full"
echo "history-bad"
echo "no-core"
} | xargs -P "$JOBS" -I{} bash -c '
set -u
t="{}"
case "$t" in
  filc-hello)
    # Environment gate (like avx512/aes/core-gdb below): this test needs
    # the repo-root Fil-C hello (an ELF PIE that prints "Hello!"). If
    # ./hello is not an ELF file — e.g. it is a Cosmopolitan APE image,
    # which starts with an MZ header — the loader rejects it before any
    # instruction runs, so skip rather than report a bogus failure.
    if [ "$(dd if=../../hello bs=1 count=4 2>/dev/null | od -An -tx1 | tr -d " \n")" != "7f454c46" ]; then
      echo "SKIP filc-hello (repo-root ./hello is not a Fil-C ELF)"
      exit 0
    fi
    out=$(timeout 120 ./zegarmistrz ../../hello 2>/dev/null); ec=$?
    [ "$ec" = 0 ] && [ "$out" = "Hello!" ] && echo "PASS filc-hello" || echo "FAIL filc-hello: exit=$ec out=[$out]"
    ;;
  static-hi)
    out=$(timeout 60 ./zegarmistrz test-output/static_hi 2>/dev/null); ec=$?
    [ "$ec" = 0 ] && [ "$out" = "static-hi" ] && echo "PASS static-hi" || echo "FAIL static-hi: exit=$ec out=[$out]"
    ;;
  threads)
    out=$(timeout 120 ./zegarmistrz test-output/threads 2>/dev/null); ec=$?
    [ "$ec" = 0 ] && [ "$out" = "counter=20" ] && echo "PASS threads" || echo "FAIL threads: exit=$ec out=[$out]"
    ;;
  args-exit)
    out=$(timeout 60 ./zegarmistrz test-output/args foo bar 2>/dev/null); ec=$?
    tail=$(echo "$out" | tail -2)
    [ "$ec" = 42 ] && [ "$tail" = "argv[1]=foo
argv[2]=bar" ] && echo "PASS args-exit" || echo "FAIL args-exit: exit=$ec out=[$out]"
    ;;
  avx512-smoke)
    if [ -z "${HAVE_AVX512:-}" ]; then echo "SKIP avx512-smoke (no host AVX512)"; exit 0; fi
    test-output/avx512_smoke > test-output/avx512.native 2>/dev/null
    (cd test-output && timeout 300 ../zegarmistrz ./avx512_smoke > avx512.emu 2>/dev/null); ec=$?
    if [ "$ec" = 0 ] && cmp -s test-output/avx512.native test-output/avx512.emu; then
      echo "PASS avx512-smoke"
    else
      echo "FAIL avx512-smoke: exit=$ec"
      diff test-output/avx512.native test-output/avx512.emu | head -5
    fi
    ;;
  vex-smoke)
    if [ -z "${HAVE_VEX:-}" ]; then echo "SKIP vex-smoke"; exit 0; fi
    test-output/vex_smoke > test-output/vex.native 2>/dev/null
    (cd test-output && timeout 300 ../zegarmistrz ./vex_smoke > vex.emu 2>/dev/null); ec=$?
    if [ "$ec" = 0 ] && cmp -s test-output/vex.native test-output/vex.emu; then
      echo "PASS vex-smoke"
    else
      echo "FAIL vex-smoke: exit=$ec"
      diff test-output/vex.native test-output/vex.emu | head -5
    fi
    ;;
  aes-smoke)
    if [ -z "${HAVE_AES:-}" ]; then echo "SKIP aes-smoke (no host AES)"; exit 0; fi
    test-output/aes_smoke > test-output/aes.native 2>/dev/null
    (cd test-output && timeout 300 ../zegarmistrz ./aes_smoke > aes.emu 2>/dev/null); ec=$?
    if [ "$ec" = 0 ] && cmp -s test-output/aes.native test-output/aes.emu; then
      echo "PASS aes-smoke"
    else
      echo "FAIL aes-smoke: exit=$ec"
      diff test-output/aes.native test-output/aes.emu | head -5
    fi
    ;;
  insn-fixes|insn-fixes-avx512)
    # Self-checking instruction-semantics regression guests (see the comment
    # at their compile lines).  Must pass natively AND under the emulator,
    # with byte-identical output ending in the ok line.
    bin=$(echo "$t" | tr "-" "_")
    test-output/$bin > test-output/$bin.native 2>/dev/null; nec=$?
    (cd test-output && timeout 300 ../zegarmistrz ./$bin > $bin.emu 2>/dev/null); ec=$?
    if [ "$nec" = 0 ] && [ "$ec" = 0 ] \
       && cmp -s test-output/$bin.native test-output/$bin.emu \
       && grep -q "^$t-ok$" test-output/$bin.emu; then
      echo "PASS $t"
    else
      echo "FAIL $t: native-exit=$nec emu-exit=$ec"
      diff test-output/$bin.native test-output/$bin.emu | head -10
    fi
    ;;
  poly1305-kat)
    # Poly1305 [12,65536,100] EVP_MAC KAT + VEX VMOVQ/VMOVD upper-YMM
    # zeroing regression (the exec_movd fix).  Self-checking; must pass
    # natively AND under the emulator with byte-identical output.  On the
    # pre-fix emulator the VEX vmovq checks FAIL and the KAT tag diverges.
    # The compile is best-effort (needs OpenSSL dev headers + libcrypto);
    # when it failed, skip instead of failing on a missing binary.
    if [ -z "${HAVE_POLY1305_KAT:-}" ]; then
      echo "SKIP poly1305-kat (poly1305_kat compile failed: OpenSSL dev headers/libcrypto missing)"
      exit 0
    fi
    test-output/poly1305_kat > test-output/poly1305_kat.native 2>/dev/null; nec=$?
    (cd test-output && timeout 300 ../zegarmistrz ./poly1305_kat > poly1305_kat.emu 2>/dev/null); ec=$?
    if [ "$nec" = 0 ] && [ "$ec" = 0 ] \
       && cmp -s test-output/poly1305_kat.native test-output/poly1305_kat.emu \
       && grep -q "^poly1305-kat-ok$" test-output/poly1305_kat.emu; then
      echo "PASS poly1305-kat"
    else
      echo "FAIL poly1305-kat: native-exit=$nec emu-exit=$ec"
      diff test-output/poly1305_kat.native test-output/poly1305_kat.emu | head -10
    fi
    ;;
  dec-cache)
    # The thread-local decode cache must not be instruction-visible: this
    # guest rewrites code at a fixed RIP between calls and requires the new
    # bytes to take effect.
    test-output/dec_cache > test-output/dec_cache.native 2>/dev/null; nec=$?
    (cd test-output && timeout 300 ../zegarmistrz ./dec_cache > dec_cache.emu 2>/dev/null); ec=$?
    if [ "$nec" = 0 ] && [ "$ec" = 0 ] \
       && cmp -s test-output/dec_cache.native test-output/dec_cache.emu \
       && grep -q "^dec-cache-ok$" test-output/dec_cache.emu; then
      echo "PASS dec-cache"
    else
      echo "FAIL dec-cache: native-exit=$nec emu-exit=$ec"
      diff test-output/dec_cache.native test-output/dec_cache.emu | head -10
    fi
    ;;
  malloc-churn)
    # BZHI (index 0) + glibc evex-memset malloc churn: self-checking, must
    # pass natively AND under the emulator with byte-identical output.
    # On the pre-fix emulator the BZHI checks FAIL and the churn aborts
    # inside glibc (malloc.c sysmalloc assertion).
    test-output/malloc_churn > test-output/malloc_churn.native 2>/dev/null; nec=$?
    (cd test-output && timeout 300 ../zegarmistrz ./malloc_churn > malloc_churn.emu 2>/dev/null); ec=$?
    if [ "$nec" = 0 ] && [ "$ec" = 0 ] \
       && cmp -s test-output/malloc_churn.native test-output/malloc_churn.emu \
       && grep -q "^malloc-churn-ok$" test-output/malloc_churn.emu; then
      echo "PASS malloc-churn"
    else
      echo "FAIL malloc-churn: native-exit=$nec emu-exit=$ec"
      diff test-output/malloc_churn.native test-output/malloc_churn.emu | head -10
    fi
    ;;
  poison-load|poison-store|poison-branch|poison-index|poison-syscall|poison-masked-load|poison-masked-store|poison-compress-expand)
    name="$t"
    bin=$(echo "$t" | tr "-" "_")
    rm -f "test-output/zegarmistrz.core.$bin."*
    (cd test-output && timeout 120 ../zegarmistrz ./$bin >/dev/null 2>$bin.err.txt); ec=$?
    core=$(ls test-output/zegarmistrz.core.$bin.* 2>/dev/null | head -1)
    if [ "$ec" = 139 ] && [ -n "$core" ] && [ -f "$core" ]; then
      echo "PASS $name"
    else
      echo "FAIL $name: exit=$ec core=[$core]"
    fi
    rm -f "test-output/zegarmistrz.core.$bin."* "test-output/$bin.err.txt"
    ;;
  poison-unpoison)
    out=$(cd test-output && timeout 60 ../zegarmistrz ./poison_unpoison 2>/dev/null); ec=$?
    [ "$ec" = 0 ] && [ "$out" = "unpoison-ok" ] && echo "PASS poison-unpoison" || echo "FAIL poison-unpoison: exit=$ec out=[$out]"
    ;;
  poison-clear)
    out=$(cd test-output && timeout 60 ../zegarmistrz ./poison_clear 2>/dev/null); ec=$?
    [ "$ec" = 0 ] && [ "$out" = "clear-ok" ] && echo "PASS poison-clear" || echo "FAIL poison-clear: exit=$ec out=[$out]"
    ;;
  poison-launder-branch)
    # Laundering: poison CANNOT_BRANCH without clear-branch-on-store; a
    # clean store must NOT sanitize it, so the loaded value is tainted
    # and branching on it faults with the cannot-branch reason. (If the
    # emulator wrongly sanitized or wrongly blocked the store/load, the
    # exit code or the reason grep catches it.)
    name=poison_launder_branch
    rm -f "test-output/zegarmistrz.core.$name."*
    (cd test-output && timeout 60 ../zegarmistrz ./$name >/dev/null 2>$name.err.txt); ec=$?
    core=$(ls test-output/zegarmistrz.core.$name.* 2>/dev/null | head -1)
    if [ "$ec" = 139 ] && [ -n "$core" ] && [ -f "$core" ] \
       && grep -q "cannot-branch" "test-output/$name.err.txt"; then
      echo "PASS poison-launder-branch"
    else
      echo "FAIL poison-launder-branch: exit=$ec core=[$core]"
      head -5 "test-output/$name.err.txt" 2>/dev/null
    fi
    rm -f "test-output/zegarmistrz.core.$name."* "test-output/$name.err.txt"
    ;;

  poison-launder-index)
