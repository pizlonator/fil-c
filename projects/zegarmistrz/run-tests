    err=test-output/history-full/trace.err
    hist=$(sed -n "/poison history/,/zegarmistrz: \[core/p" "$err" 2>/dev/null)
    mains=$(echo "$hist" | grep -c "in main ()" || true)
    srcs=$(echo "$hist" | grep -c "history_math\.c" || true)
    libc=$(echo "$hist" | grep -c "libc_start" || true)
    steps=$(echo "$hist" | grep -cE "^step [0-9]+:" || true)
    flines=$(echo "$hist" | grep -cE "#[0-9]+ +0x[0-9a-f]{16}" || true)
    if [ "$ec" = 139 ] && [ -n "$core" ] && [ -f "$core" ] \
       && echo "$hist" | grep -q "poison history of the offending value" \
       && [ "${mains:-0}" -ge 2 ] && [ "${srcs:-0}" -ge 1 ] \
       && [ "${libc:-0}" -ge 1 ] && [ "${flines:-0}" -ge $((4 * steps)) ]; then
      echo "PASS history-full"
    else
      echo "FAIL history-full: ec=$ec core=[$core] mains=$mains srcs=$srcs libc=$libc steps=$steps flines=$flines"
      head -20 "$err"
    fi
    rm -f test-output/history-full/zegarmistrz.core.history_math.* test-output/history-full/trace.err
    ;;

  history-bad)
    # A value that is neither a keyword nor an integer (--history=wat) is a
    # usage error: exit 1 before any guest runs, the message names the flag,
    # and no core is produced.
    mkdir -p test-output/history-bad
    rm -f test-output/history-bad/zegarmistrz.core.history_math.*
    out=$(cd test-output/history-bad && timeout 60 ../../zegarmistrz --history=wat ../history_math 2>&1 >/dev/null); ec=$?
    core=$(ls test-output/history-bad/zegarmistrz.core.history_math.* 2>/dev/null | head -1)
    if [ "$ec" = 1 ] && echo "$out" | grep -q "bad --history" && [ -z "$core" ]; then
      echo "PASS history-bad"
    else
      echo "FAIL history-bad: ec=$ec core=[$core] out=[$out]"
    fi
    rm -f test-output/history-bad/zegarmistrz.core.history_math.*
    ;;

  no-core)
    # --no-core disables core dumps; use a poisoning guest (GuestError path
    # without host signal): expect the "disabled" message, no core file.
    mkdir -p test-output/no-core
    rm -f test-output/no-core/zegarmistrz.core.poison_load.*
    (cd test-output/no-core && timeout 60 ../../zegarmistrz --no-core ../poison_load >/dev/null 2>nocore.err); ec=$?
    core=$(ls test-output/no-core/zegarmistrz.core.poison_load.* 2>/dev/null | head -1)
    if [ -z "$core" ] && grep -q "disabled" test-output/no-core/nocore.err; then
      echo "PASS no-core"
    else
      echo "FAIL no-core: exit=$ec core=[$core]"
    fi
    rm -f test-output/no-core/zegarmistrz.core.poison_load.* test-output/no-core/nocore.err
    ;;
esac
' | tee "$OUTDIR/results.txt"

NPASS=$(grep -c "^PASS" "$OUTDIR/results.txt" || true)
NFAIL=$(grep -c "^FAIL" "$OUTDIR/results.txt" || true)
NSKIP=$(grep -c "^SKIP" "$OUTDIR/results.txt" || true)
log "done: $NPASS passed, $NFAIL failed, $NSKIP skipped"
[ "$NFAIL" = 0 ]
