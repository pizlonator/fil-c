# supercop-tests per-dir build flags (read by run-supercop-tests).
# The vendored decode.c/encode.c are crypto_{decode,encode}_761xint16/ref,
# renamed via -D so mult.c (via params.h) can call them.
src decode.c: -Dcrypto_decode=crypto_decode_761xint16
src encode.c: -Dcrypto_encode=crypto_encode_761xint16
