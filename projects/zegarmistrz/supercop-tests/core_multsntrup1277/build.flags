# supercop-tests per-dir build flags (read by run-supercop-tests).
# The vendored decode.c/encode.c are crypto_{decode,encode}_1277xint16/ref,
# renamed via -D so mult.c (via params.h) can call them.
src decode.c: -Dcrypto_decode=crypto_decode_1277xint16
src encode.c: -Dcrypto_encode=crypto_encode_1277xint16
