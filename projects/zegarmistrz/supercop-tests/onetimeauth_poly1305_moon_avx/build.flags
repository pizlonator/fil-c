# supercop-tests per-dir build flags (read by run-supercop-tests).
# moon poly1305.S is PIC-clean, but the checksum campaign linked every
# poly1305 target -no-pie; we keep that here so both legs run the same
# statically-placed binary.
# verify16.c is crypto_verify/16/ref/verify.c, renamed via -D.
src verify16.c: -Dcrypto_verify=crypto_verify_16
link: -no-pie
