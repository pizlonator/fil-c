# run-x86sem-tests -- the x86sem differential suite's sub-runner.
#
# Auto-collects every <dir>/test.s in this directory (new corpus dirs
# are picked up automatically), generates testmakefile following the
# filc/run-tests generated-Makefile idiom (per-test targets, make -k -j
# $JOBS), and runs it. Per-test pipeline, all under test-output/x86sem/
# <dir>/:
#   test.s -> as + ld -> ./test (static freestanding _start guest)
#   ./test -> native trace (hardware oracle: native-trace by default,
#             gdb-state-trace.gdb with ZEG_X86SEM_NATIVE=gdb)
#   ./test + ../zegarmistrz --state-trace= -> emu trace
#   native.strace + emu.strace -> compare-traces.py -> cmp stamp
# A test PASSES iff compare-traces.py exits 0. Output: one line per
# test, "PASS x86/<dir>" / "FAIL x86/<dir>: <first divergence>" /
# "SKIP x86/<dir>: <assembler error>", then the tally
# "x86sem: N passed, M failed, K skipped". Exits nonzero iff M > 0.
#
# Caching: native traces are make targets depending on the guest binary
# and the oracle (they survive emulator rebuilds); emu traces depend on
# the guest binary AND ../zegarmistrz (re-traced whenever the emulator
# changes); cmp stamps depend on both traces and the comparator. So a
# no-change run-tests invocation re-runs nothing.

set -u
cd "$(dirname "$0")" || exit 1
JOBS=${JOBS:-$(nproc)}
ORACLE=${ZEG_X86SEM_NATIVE:-self}
case "$ORACLE" in
self|gdb) ;;
*)
    echo "run-x86sem-tests: bad ZEG_X86SEM_NATIVE '$ORACLE' (self or gdb)" >&2
    exit 2
    ;;
esac
mkdir -p test-output/x86sem

# Auto-collect the corpus.
tests=()
for s in */test.s; do
    d=${s%/test.s}
    tests+=("$d")
done
if [ "${#tests[@]}" -eq 0 ]; then
    echo "run-x86sem-tests: no corpus dirs found" >&2
    exit 2
fi

# Generate the makefile. Targets (all paths relative to this directory):
#   native-trace                          the ptrace-free oracle binary
#   test-output/x86sem/<d>/test           as+ld of <d>/test.s
#   test-output/x86sem/<d>/native.strace  hardware whole-state trace
#   test-output/x86sem/<d>/emu.strace     emulator whole-state trace
#   test-output/x86sem/<d>/cmp            comparator stamp (the verdict)
# The per-test phony wrappers print the single PASS/FAIL/SKIP line.
# Rules are emitted with printf so the recipe text (makefile $$-escapes
# and all) never undergoes a second round of shell expansion here.
{
    echo "# GENERATED by run-x86sem-tests -- do not edit."
    echo "# Oracle: $ORACLE   Jobs: $JOBS"
    printf 'all:'
    for d in "${tests[@]}"; do
        printf ' \\\n t-%s' "$d"
    done
    printf '\n\n'
    if [ "$ORACLE" = self ]; then
        printf 'native-trace: native-trace.c\n'
        printf '\tgcc -O2 -o $@ $<\n\n'
    fi
    for d in "${tests[@]}"; do
        out="test-output/x86sem/$d"
        bin="$out/test"
        nat="$out/native.strace"
        emu="$out/emu.strace"
        cmp="$out/cmp"
        printf '%s: %s/test.s\n' "$bin" "$d"
        printf '\t@mkdir -p %s\n' "$out"
        printf '\t@as %s/test.s -o %s/x.o 2>%s/as.err || { sed "s/^/SKIP x86\/%s: as: /" %s/as.err | head -2; exit 1; }\n' "$d" "$out" "$out" "$d" "$out"
        printf '\t@ld %s/x.o -o %s 2>>%s/as.err || { sed "s/^/SKIP x86\/%s: ld: /" %s/as.err | head -2; exit 1; }\n' "$out" "$bin" "$out" "$d" "$out"
        if [ "$ORACLE" = self ]; then
            printf '\n%s: %s native-trace\n' "$nat" "$bin"
            # timeout 120, same bound as the emu recipe: a runaway guest
            # (or a dumper wedge) must not hang the whole make run.
            printf '\t@timeout 120 ./native-trace %s %s.tmp 2>%s/native.stderr; status=$$?; if [ $$status -eq 0 ] || [ -s %s.tmp ]; then mv %s.tmp %s; else { echo "FAIL x86/%s: native oracle died early (status $$status; see %s/native.stderr)"; exit 1; }; fi\n' "$bin" "$nat" "$out" "$nat" "$nat" "$nat" "$d" "$out"
        else
            printf '\n%s: %s gdb-state-trace.gdb\n' "$nat" "$bin"
            printf '\t@timeout 300 gdb --batch -nx -command=gdb-state-trace.gdb %s >%s.tmp 2>%s/native.stderr || true; if [ -s %s.tmp ]; then mv %s.tmp %s; else { echo "FAIL x86/%s: gdb oracle produced no trace (needs ptrace; see %s/native.stderr)"; exit 1; }; fi\n' "$bin" "$nat" "$out" "$nat" "$nat" "$nat" "$d" "$out"
        fi
        printf '\n%s: %s ../zegarmistrz\n' "$emu" "$bin"
        printf '\t@timeout 120 ../zegarmistrz --no-core --state-trace=%s.tmp %s >%s/emu.stdout 2>%s/emu.stderr || true; if [ -s %s.tmp ]; then mv %s.tmp %s; else { echo "FAIL x86/%s: emulator produced no trace (see %s/emu.stderr)"; exit 1; }; fi\n' "$emu" "$bin" "$out" "$out" "$emu" "$emu" "$emu" "$d" "$out"
        printf '\n%s: %s %s compare-traces.py %s\n' "$cmp" "$nat" "$emu" "$bin"
        # The reason is grepped from cmp.out AND cmp.err (tracebacks /
        # oracle banners live in .err) with -h so the echoed FAIL reason
        # does not double the file prefix ("FAIL x86/<dir>:
        # <dir>/cmp.out:FAIL: ..." reads as two paths in a row).
        # compare-traces.py's ONE-LINE: summary (slot + native + emu
        # values + rip + instruction) is preferred so a remote FAIL
        # report is actionable on its own; the older reason greps are
        # the fallback for the record-count / early-death shapes that
        # have no slot detail. The 600-char cut keeps one full ymm
        # summary line intact (128-hex values x2 + metadata).
        printf '\t@if python3 compare-traces.py %s %s %s >%s.out 2>%s.err; then cat %s.out; touch %s; else { cat %s.out; head -6 %s.err; reason=$$(grep -m1 -h "ONE-LINE:" %s.out 2>/dev/null | sed "s/^ONE-LINE: //" | cut -c1-600); if [ -z "$$reason" ]; then reason=$$(grep -m1 -h -E "first divergence|record count mismatch|produced no record|ended early" %s.out %s.err 2>/dev/null | head -1 | cut -c1-200); fi; echo "FAIL x86/%s: $$reason"; rm -f %s; exit 1; }; fi\n' "$nat" "$emu" "$bin" "$cmp" "$cmp" "$cmp" "$cmp" "$cmp" "$cmp" "$cmp" "$cmp" "$cmp" "$d" "$cmp"
        # The PASS verdict echoes from the phony wrapper so cached runs
        # (cmp stamp already up to date) still count every sub-test in
        # the tally; FAIL/SKIP echo from the failing recipes above.
        printf 't-%s: %s\n\t@echo "PASS x86/%s"\n\n' "$d" "$cmp" "$d"
    done
} > testmakefile

# Run it. -k keeps going past failures; the exit status plus the
# PASS/FAIL/SKIP lines drive the tally.
status=0
make -f testmakefile -k -j "$JOBS" all >test-output/make.log 2>&1 || status=$?
if [ -n "${ZEG_X86SEM_QUIET:-}" ]; then
    # Quiet mode (used by run-tests): only the per-test verdict lines and
    # the tally; the comparator details stay in test-output/ and make.log.
    grep -E '^(PASS|FAIL|SKIP) x86/' test-output/make.log || true
else
    cat test-output/make.log
fi
grep -E '^(PASS|FAIL|SKIP) x86/' test-output/make.log >/dev/null || {
    echo "run-x86sem-tests: no per-test lines produced; see test-output/make.log" >&2
    exit 2
}
passed=$(grep -c '^PASS x86/' test-output/make.log || true)
failed=$(grep -c '^FAIL x86/' test-output/make.log || true)
skipped=$(grep -c '^SKIP x86/' test-output/make.log || true)
echo "x86sem: $passed passed, $failed failed, $skipped skipped (oracle: $ORACLE)"
if [ "$failed" -gt 0 ]; then
    exit 1
fi
if [ "$status" -ne 0 ]; then
    # make failed without any FAIL line (recipe noise); surface it.
    exit 1
fi
exit 0
