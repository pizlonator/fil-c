diff --git a/m4/tests/test-memset_explicit.c b/m4/tests/test-memset_explicit.c
--- a/m4/tests/test-memset_explicit.c
+++ b/m4/tests/test-memset_explicit.c
@@ -155,6 +155,10 @@
   memcpy (heapbuf, SECRET, SECRET_SIZE);
   memset_explicit (heapbuf, 0, SECRET_SIZE);
   free (heapbuf);
+#ifndef __FILC__
+  /* Fil-C frees do not unmap the range, and rebuilding the pointer from
+     its integer address would read a free object; skip the after-free
+     check.  */
   heapbuf = (char *) addr;
   if (is_range_mapped (addr, addr + SECRET_SIZE))
     {
@@ -164,6 +168,7 @@
       printf ("test_heap: address range is still mapped after free().\n");
     }
   else
+#endif
     printf ("test_heap: address range is unmapped after free().\n");
 }

