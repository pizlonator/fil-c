return:
  failure
output-includes:
  - "filc safety error"
  - "cannot write pointer to special object"

# COSMO: cosmo's pselect() reads the fd_set arguments (so that it can restore them after EINTR) before the kernel writes them, so the safety error fires with 'cannot read ...' instead of the expected 'cannot write ...' wording; the check itself is still enforced.
unsupportedOnCOSMO: true
