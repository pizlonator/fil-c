return:
  success
output-includes:
  - "spawnmt2 ok"
slow:
  true
extraLinkerArgs:
  "-lm"

# COSMO: fork()+posix_spawn()+GC+threads stress: like mtforkgctest and spawnmt, the child's
# filc runtime state does not hold up under the cosmo flavor, and this test additionally
# hammers posix_spawn with live threads in a recursively spawned process tree while other
# threads sit inside the zgc_* GC request natives.
unsupportedOnCOSMO: true

# I saw this test deadlock. It's more likely that the test is broken than that there's a Fil-C
# runtime bug.
# FIXME: https://github.com/pizlonator/fil-c/issues/346
skip: true
