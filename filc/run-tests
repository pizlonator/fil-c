# Check if we have FEAT_FRINTTS (frint32z/frint32x/frint64z/frint64x)
raise unless system("clang -O3 -g -o filc/tests/has_frintts filc/tests/has_frintts.c")
system("filc/tests/has_frintts > filc/tests/has_frintts.log 2>&1")
raise unless $?.exited?
raise unless $?.exitstatus == 0 or $?.exitstatus == 1
