# Check if we're using glibc
$hasGLIBC = (Pathname.new($pizfix) + "lib" + "libc.so.6666").exist?

# Check if we're using cosmopolitan libc (cosmo).  The cosmo build leaves a
# marker artifact in pizfix/lib.
$hasCOSMO = (Pathname.new($pizfix) + "lib" + "libyolocosmo.a").exist?

raise unless system("#{$compilerPrefix}#{$pizfix}/../build/bin/clang -O3 -c -o filc/tests/utils.o filc/tests/utils.c -g")

$testDirectory = Pathname.new("filc/tests")
$testOutputDirectory = Pathname.new("filc/test-output")
FileUtils.rm_rf($testOutputDirectory)
if Pathname.new("filc/run-tests-docker-hack").exist?
    realOutputDirectory = Pathname.new("/filc-test-output")
    realOutputDirectory.mkpath
    realOutputDirectory.rmtree
    realOutputDirectory.mkpath
    $testOutputDirectory.make_symlink(realOutputDirectory)
    $dockerHack = true
else
    $testOutputDirectory.mkpath
    $dockerHack = false
end

$tests = []

def handleArray(thing)
    return [] unless thing
    return thing if thing.is_a? Array
    [thing]
end

# Returns true if the given directory entry (a Pathname) is a source file that
# the test runner knows how to compile.  This is the single source of truth for
# what counts as a source file; both the compiler invocations and the cosmo
# skips below use it so that they cannot diverge.
def isSourceEntry(entry)
    return (entry.extname == ".c" or entry.extname == ".ll" or entry.extname == ".cpp" or entry.extname == ".s")
end

# Returns true if the given source entry (a Pathname or a String) is a C++
# source file, i.e. the thing that decides clang++ versus clang.
def isCppEntry(entry)
    return Pathname.new(entry).extname == ".cpp"
end

$testDirectory.each_entry {
    | testName |
    next if testName == Pathname.new(".")
    next if testName == Pathname.new("..")
    next unless testName.to_s =~ $filter
    if $specificTest
        next unless testName.to_s == $specificTest
    end
    fullPath = $testDirectory + testName
    next unless fullPath.directory?
    unless (fullPath + "manifest").exist?
        puts "Skipping #{testName}, no manifest."
        next
    end
    outputPath = $testOutputDirectory + testName
    outputPath.mkpath
    manifest = YAML.load_file(fullPath + "manifest")
    onlyOnPlatform = manifest["only-on-platform"]
    if onlyOnPlatform and RUBY_PLATFORM !~ Regexp.new(onlyOnPlatform)
        if $verbose
            puts "Skipping #{testName}, requires #{onlyOnPlatform}"
        end
        next
    end
    if manifest["needsAVX512"] and not $hasAVX512
        if $verbose
            puts "Skipping #{testName}, requires AVX512"
        end
        next
    end
    if manifest["needsSHANI"] and not $hasSHANI
        if $verbose
            puts "Skipping #{testName}, requires SHA-NI"
        end
        next
    end
    if manifest["needsARMCrypto"] and not $hasARMCrypto
        if $verbose
            puts "Skipping #{testName}, requires ARM crypto"
        end
        next
    end
    if manifest["needsLSE"] and not $hasLSE
        if $verbose
            puts "Skipping #{testName}, requires ARM LSE"
        end
        next
    end
    if manifest["needsJSCVT"] and not $hasJSCVT
        if $verbose
            puts "Skipping #{testName}, requires ARM JSCVT"
        end
        next
    end
    if manifest["needsFP16"] and not $hasFP16
        if $verbose
            puts "Skipping #{testName}, requires ARMv8.2 FP16"
        end
        next
    end
    if manifest["needsASIMDHP"] and not $hasASIMDHP
        if $verbose
            puts "Skipping #{testName}, requires ARMv8.2 vector FP16"
        end
        next
    end
    if manifest["needsBF16"] and not $hasBF16
        if $verbose
            puts "Skipping #{testName}, requires BFloat16"
        end
        next
    end
    if manifest["needsI8MM"] and not $hasI8MM
        if $verbose
            puts "Skipping #{testName}, requires ARM i8mm"
        end
        next
    end
    if manifest["needsCRC32"] and not $hasCRC32
        if $verbose
            puts "Skipping #{testName}, requires ARM CRC32"
        end
        next
    end
    if manifest["needsFLAGM"] and not $hasFLAGM
        if $verbose
            puts "Skipping #{testName}, requires ARMv8.4 flag manipulation"
        end
        next
    end
    if manifest["needsFLAGM2"] and not $hasFLAGM2
        if $verbose
            puts "Skipping #{testName}, requires ARMv8.4.2 flag manipulation"
        end
        next
    end
    if manifest["needsSHA3"] and not $hasSHA3
        if $verbose
            puts "Skipping #{testName}, requires ARM SHA3"
        end
        next
    end
    if manifest["needsSHA512"] and not $hasSHA512
        if $verbose
            puts "Skipping #{testName}, requires ARM SHA512"
        end
        next
    end
    if manifest["needsPACA"] and not $hasPACA
        if $verbose
            puts "Skipping #{testName}, requires ARM pointer authentication"
        end
        next
    end
    if manifest["needsSVE"] and not $hasSVE
        if $verbose
            puts "Skipping #{testName}, requires ARM SVE"
        end
        next
    end
    if manifest["needsRNG"] and not $hasRNG
        if $verbose
            puts "Skipping #{testName}, requires ARM random number generator"
        end
        next
    end
    if manifest["needsFRINTTS"] and not $hasFRINTTS
        if $verbose
            puts "Skipping #{testName}, requires FEAT_FRINTTS"
        end
        next
    end
    if manifest["needsGLIBC"] and not $hasGLIBC
        if $verbose
            puts "Skipping #{testName}, requires GLIBC"
        end
        next
    end
    # needsCOSMO is symmetric with needsGLIBC: the test simply cannot run without
    # cosmo, so --test NAME does not override this skip.
    if manifest["needsCOSMO"] and not $hasCOSMO
        if $verbose
            puts "Skipping #{testName}, requires COSMO"
        end
        next
    end
    # unsupportedOnCOSMO is symmetric with skip: an explicit --test NAME overrides
    # it, so that a developer can force-run a test to see how it fails.
    if manifest["unsupportedOnCOSMO"] and $hasCOSMO and not $specificTest
        puts "Skipping #{testName}, unsupported on COSMO"
        next
    end
    # Structural cosmo limitations: cosmo builds are static-only.  Unlike
    # unsupportedOnCOSMO, --test NAME does not override this skip, because such
    # tests cannot even compile or link, rather than merely failing at run
    # time.  C++ (libc++ / libc++abi) works on COSMO now, so it is not gated
    # here.  Hand written assembly cannot be pizlonated by the compiler, so it
    # always goes through the sarcasm assembler, which is optional in the
    # cosmo flavor: the .s tests run there only if sarcasm was built.
    if $hasCOSMO
        hasSharedLibrary = false
        cosmoLibraries = manifest["libraries"]
        if cosmoLibraries
            cosmoLibraries.each_pair {
                | libname, data |
                hasSharedLibrary = true unless data["isStatic"]
            }
        end
        if hasSharedLibrary
            puts "Skipping #{testName}, shared libraries not supported on COSMO"
            next
        end
    end
    if manifest["skip"] and not $specificTest
        puts "Skipping #{testName}"
        next
    end
    if manifest["neverInDocker"] and $dockerHack
        puts "Skipping #{testName} because of Docker"
        next
    end
    expectedReturn = manifest["return"]
    raise unless expectedReturn == "success" or expectedReturn == "failure" or
        expectedReturn == "crash" or expectedReturn == "compileFailure" or
        expectedReturn == "dontCrash" or expectedReturn == "exit13" or
        expectedReturn == "compileOnly" or expectedReturn == "linkFailure"
    expectedOutputs = handleArray(manifest["output-includes"])
    forbiddenOutputs = handleArray(manifest["output-excludes"])
    optFlags = manifest["optFlags"]
    unless optFlags
        optFlags = "-O2"
    end
    handleArray(manifest["mkdirs"]).each {
        | dirToMake |
        (outputPath + dirToMake).mkpath
    }
    runScript = outputPath + "run.sh"
    compileScript = outputPath + "compile.sh"
    justRunScript = outputPath + "justRun.sh"
    justRunReleaseScript = outputPath + "justRunRelease.sh"
    subRunScript = outputPath + "subRun.sh"
    subRunScribbleScript = outputPath + "subRunScribble.sh"
    subRunSTWScript = outputPath + "subRunSTW.sh"
    subRunReleaseScript = outputPath + "subRunRelease.sh"
    binary = outputPath + testName
    compilerOutput = outputPath + "compilerOutput.txt"
    output = outputPath + "output.txt"
    outputScribble = outputPath + "outputScribble.txt"
    outputSTW = outputPath + "outputSTW.txt"
    outputRelease = outputPath + "outputRelease.txt"
    File.open(compileScript, "w") {
        | outp |
        outp.puts "#!/bin/sh"
        libraries = manifest["libraries"]
        libraryFiles = {}
        outp.puts "rm -f #{Shellwords.shellescape(compilerOutput)}"
        outp.puts "touch #{Shellwords.shellescape(compilerOutput)}"
        fullPath.each_entry {
            | entry |
            next unless isSourceEntry(entry)
            isCpp = isCppEntry(entry)
            if isCpp
                clang = "clang++"
                extraOpts = "-std=c++20"
            else
                clang = "clang"
                extraOpts = ""
            end
            outp.puts "#{$compilerPrefix}#{$pizfix}/../build/bin/#{clang} -c -o #{Shellwords.shellescape(outputPath + entry)}.o #{Shellwords.shellescape(fullPath + entry)} -Ifilc/tests #{optFlags} -g #{extraOpts} >> #{Shellwords.shellescape(compilerOutput)} 2>&1"
            if expectedReturn == "compileFailure"
                outp.puts "if [ $? -eq 0 ]"
                outp.puts "then"
                outp.puts("    echo " + Shellwords.shellescape(runScript.to_s + ": FAIL: compiled #{entry} but shouldn't have"))
                outp.puts "    cat #{Shellwords.shellescape(compilerOutput)}"
                outp.puts "    exit 1"
                outp.puts "fi"
            else
                outp.puts "if [ $? -ne 0 ]"
                outp.puts "then"
                outp.puts("    echo " + Shellwords.shellescape(runScript.to_s + ": FAIL: couldn't compile #{entry}"))
                outp.puts "    cat #{Shellwords.shellescape(compilerOutput)}"
                outp.puts "    exit 1"
                outp.puts "fi"
            end
        }
        if expectedReturn == "compileFailure"
            expectedOutputs.each {
                | expectedOutput |
                outp.puts "grep -F -- #{Shellwords.shellescape(expectedOutput)} #{Shellwords.shellescape(compilerOutput)} > /dev/null || {"
                outp.puts "    echo " + Shellwords.shellescape("FAIL: expected compiler output to contain #{expectedOutput}")
                outp.puts "    cat #{Shellwords.shellescape(compilerOutput)}"
                outp.puts "    exit 1"
                outp.puts "}"
            }
            forbiddenOutputs.each {
                | forbiddenOutput |
                outp.puts "grep -F -- #{Shellwords.shellescape(forbiddenOutput)} #{Shellwords.shellescape(compilerOutput)} > /dev/null && {"
                outp.puts "    echo " + Shellwords.shellescape("FAIL: expected compiler output to NOT contain #{forbiddenOutput}")
                outp.puts "    cat #{Shellwords.shellescape(compilerOutput)}"
                outp.puts "    exit 1"
                outp.puts "}"
            }
            outp.puts ":"
        end
        break if expectedReturn == "compileFailure" or expectedReturn == "compileOnly"
        if libraries
            libraries.each_pair {
                | libname, data |
                isStatic = false
                if data["isStatic"]
                    libname += ".a"
                    outp.print "ar cr #{Shellwords.shellescape(outputPath + libname)}"
                else
                    if data["isBundle"]
                        libraryOpt = $bundleOpt
                    else
                        libraryOpt = $dylibOpt
                        libname += $dylibExt
                    end
                    linkerIsCpp = false
                    data["files"].each {
                        | entry |
                        linkerIsCpp = true if isCppEntry(entry)
                    }
                    if linkerIsCpp
                        clangLinker = "clang++"
                    else
                        clangLinker = "clang"
                    end
                    outp.print "#{$compilerPrefix}#{$pizfix}/../build/bin/#{clangLinker} #{libraryOpt} -o #{Shellwords.shellescape(outputPath + libname)}"
                end
                data["files"].each {
                    | file |
                    libraryFiles[file] = true
                    outp.print " #{Shellwords.shellescape(outputPath + file)}.o"
                }
                if data["extraLinkerArgs"]
                    outp.print " "
                    outp.print data["extraLinkerArgs"]
                end
                outp.puts " >> #{Shellwords.shellescape(compilerOutput)} 2>&1"
                outp.puts "if [ $? -ne 0 ]"
                outp.puts "then"
                outp.puts("    echo " + Shellwords.shellescape(runScript.to_s + ": FAIL: couldn't link #{libname}"))
                outp.puts "    cat #{Shellwords.shellescape(compilerOutput)}"
                outp.puts "    exit 1"
                outp.puts "fi"
                if $hasCOSMO and data["isStatic"] and not data["files"].empty?
                    # Cosmo links produce fat APEs: the driver looks for the
                    # aarch64 counterpart of an archive in the .aarch64
                    # subdirectory of the archive's directory, and it searches
                    # the .aarch64 subdirectory of each -L path first.  The
                    # compile steps above had the driver write aarch64 shadow
                    # objects next to the primary ones, so archive them into
                    # such a subarchive.  The guard is checked at compile time,
                    # since that is when the shadow objects exist: if any
                    # member has no shadow (like a sarcasm-assembled .s file),
                    # this is a no-op and the link just degrades to an
                    # x86_64-only APE.
                    shadowObjects = data["files"].map {
                        | file |
                        objectPath = (outputPath + file).to_s + ".o"
                        File.join(File.dirname(objectPath), ".aarch64", File.basename(objectPath))
                    }
                    outp.puts "if " + shadowObjects.map {
                        | shadowObject |
                        "[ -f #{Shellwords.shellescape(shadowObject)} ]"
                    }.join(" && ")
                    outp.puts "then"
                    archivePath = (outputPath + libname).to_s
                    shadowArchiveDir = File.join(File.dirname(archivePath), ".aarch64")
                    outp.print "    mkdir -p #{Shellwords.shellescape(shadowArchiveDir)} && ar cr #{Shellwords.shellescape(File.join(shadowArchiveDir, File.basename(archivePath)))}"
                    shadowObjects.each {
                        | shadowObject |
                        outp.print " #{Shellwords.shellescape(shadowObject)}"
                    }
                    outp.puts " >> #{Shellwords.shellescape(compilerOutput)} 2>&1"
                    outp.puts "    if [ $? -ne 0 ]"
                    outp.puts "    then"
                    outp.puts("        echo " + Shellwords.shellescape(runScript.to_s + ": FAIL: couldn't link #{libname}"))
                    outp.puts "        cat #{Shellwords.shellescape(compilerOutput)}"
                    outp.puts "        exit 1"
                    outp.puts "    fi"
                    outp.puts "fi"
                end
            }
        end
        linkerIsCpp = false
        fullPath.each_entry {
            | entry |
            next unless isSourceEntry(entry)
            next if libraryFiles[entry.to_s]
            linkerIsCpp = true if isCppEntry(entry)
        }
        if linkerIsCpp
            clangLinker = "clang++"
        else
            clangLinker = "clang"
        end
        outp.print "#{$compilerPrefix}#{$pizfix}/../build/bin/#{clangLinker} -o #{Shellwords.shellescape(binary)}"
        fullPath.each_entry {
            | entry |
            next unless isSourceEntry(entry)
            next if libraryFiles[entry.to_s]
            outp.print " #{Shellwords.shellescape(outputPath + entry)}.o"
        }
        if manifest["extraLinkerArgs"]
            outp.print " #{manifest["extraLinkerArgs"]}"
        end
        if $hasGLIBC
            # The glibc flavor keeps the fenv API and the math routines in
            # libm, a separate library, which the driver already links into
            # C++ tests.  Link it into the C tests, too.  The other flavors
            # either have no separate libm or have an empty one.
            outp.print " -lm"
        end
        outp.puts " filc/tests/utils.o >> #{Shellwords.shellescape(compilerOutput)} 2>&1"
        if expectedReturn == "linkFailure"
            outp.puts "if [ $? -eq 0 ]"
            outp.puts "then"
            outp.puts("    echo " + Shellwords.shellescape(runScript.to_s + ": FAIL: linked but shouldn't have"))
            outp.puts "    cat #{Shellwords.shellescape(compilerOutput)}"
            outp.puts "    exit 1"
            outp.puts "fi"
        else
            outp.puts "if [ $? -ne 0 ]"
            outp.puts "then"
            outp.puts("    echo " + Shellwords.shellescape(runScript.to_s + ": FAIL: couldn't link"))
            outp.puts "    cat #{Shellwords.shellescape(compilerOutput)}"
            outp.puts "    exit 1"
            outp.puts "fi"
        end
    }
    if expectedReturn != "compileFailure" and expectedReturn != "compileOnly" and
      expectedReturn != "linkFailure"
        extraArgs = handleArray(manifest["extraArgs"]).map {
            | arg |
            Shellwords.shellescape(arg)
        }.join(" ")
        File.open(justRunScript, "w") {
            | outp |
            outp.puts "#!/bin/sh"
            outp.puts "set -e"
            outp.print "#{$libraryPathEnv}=#{$pizfix}/lib_test"
            if manifest["extraLDPath"]
                outp.print ":#{manifest["extraLDPath"]}"
            end
            outp.print " "
            handleArray(manifest["extra-env"]).each {
                | entry |
                outp.print "#{entry} "
            }
            outp.puts "#{Shellwords.shellescape(binary)} #{extraArgs}"
        }
        File.open(justRunReleaseScript, "w") {
            | outp |
            outp.puts "#!/bin/sh"
            outp.puts "set -e"
            if manifest["extraLDPath"]
                outp.print "#{$libraryPathEnv}=#{manifest["extraLDPath"]} "
            end
            handleArray(manifest["extra-env"]).each {
                | entry |
                outp.print "#{entry} "
            }
            outp.puts "#{Shellwords.shellescape(binary)} #{extraArgs}"
        }
        [{:script => subRunScript,
          :cmdPrefix => "FUGC_RAGE_MODE=1",
          :justRunScript => justRunScript,
          :output => output},
         {:script => subRunScribbleScript,
          :cmdPrefix => "FUGC_RAGE_MODE=1 FUGC_SCRIBBLE=1 FUGC_VERIFY=1",
          :justRunScript => justRunScript,
          :output => outputScribble},
         {:script => subRunSTWScript,
          :cmdPrefix => "FUGC_MIN_THRESHOLD=0 FUGC_STW=1",
          :justRunScript => justRunScript,
          :output => outputSTW},
         {:script => subRunReleaseScript,
          :cmdPrefix => "",
          :justRunScript => justRunReleaseScript,
          :output => outputRelease}].each {
            | params |
            File.open(params[:script], "w") {
                | outp |
                outp.puts "#!/bin/sh"
                if expectedReturn == "crash"
                    outp.puts "ulimit -c 0"
                end
                outp.puts "#{params[:cmdPrefix]} FILC_EXIT_ON_PANIC=1 FILC_DUMP_SETUP=1 #{Shellwords.shellescape(params[:justRunScript])} > #{Shellwords.shellescape(params[:output])} 2>&1"
                case expectedReturn
                when "failure"
                    outp.puts "if [ $? -ne 42 ]"
                when "crash"
                    outp.puts "if [ $? -eq 0 ]"
                when "success"
                    outp.puts "if [ $? -ne 0 ]"
                when "exit13"
                    outp.puts "if [ $? -ne 13 ]"
                when "dontCrash"
                    outp.puts "if [ $? -ne 0 -a $? -ne 42 ]"
                else
                    raise
                end
                outp.puts "then"
                case expectedReturn
                when "failure"
                    outp.puts("    echo " + Shellwords.shellescape(params[:script].to_s + ": FAIL: expected program to return failure"))
                when "crash"
                    outp.puts("    echo " + Shellwords.shellescape(params[:script].to_s + ": FAIL: expected program to crash"))
                when "success"
                    outp.puts("    echo " + Shellwords.shellescape(params[:script].to_s + ": FAIL: expected program to return success"))
                when "exit13"
                    outp.puts("    echo " + Shellwords.shellescape(params[:script].to_s + ": FAIL: expected program to return 13"))
                when "dontCrash"
                    outp.puts("    echo " + Shellwords.shellescape(params[:script].to_s + ": FAIL: expected program to return success or failure, but not crash"))
                else
                    raise
                end
                outp.puts "    cat #{Shellwords.shellescape(params[:output])}"
                outp.puts "    exit 1"
                outp.puts "fi"
                expectedOutputs.each {
                    | expectedOutput |
                    outp.puts "grep -F -- #{Shellwords.shellescape(expectedOutput)} #{Shellwords.shellescape(params[:output])} > /dev/null || {"
                    outp.puts("    echo " + Shellwords.shellescape(params[:script].to_s + ": FAIL: expected output to contain #{expectedOutput}"))
                    outp.puts "    cat #{Shellwords.shellescape(params[:output])}"
                    outp.puts "    exit 1"
                    outp.puts "}"
                }
                forbiddenOutputs.each {
                    | forbiddenOutput |
                    outp.puts "grep -F -- #{Shellwords.shellescape(forbiddenOutput)} #{Shellwords.shellescape(params[:output])} > /dev/null && {"
                    outp.puts("    echo " + Shellwords.shellescape(params[:script].to_s + ": FAIL: expected output to NOT contain #{forbiddenOutput}"))
                    outp.puts "    cat #{Shellwords.shellescape(params[:output])}"
                    outp.puts "    exit 1"
                    outp.puts "}"
                }
                outp.puts ":"
            }
        }
    end
    File.open(runScript, "w") {
        | outp |
        outp.puts "#!/bin/sh"
        outp.puts "set -e"
        outp.puts "#{Shellwords.shellescape(compileScript)}"
        if expectedReturn != "compileFailure" and expectedReturn != "compileOnly" and
          expectedReturn != "linkFailure"
            subRuns = manifest["subRuns"]
            if not subRuns or subRuns["default"]
                outp.puts "#{Shellwords.shellescape(subRunScript)}"
            end
            if not subRuns or subRuns["scribble"]
                outp.puts "#{Shellwords.shellescape(subRunScribbleScript)}"
            end
            if not subRuns or subRuns["stw"]
                outp.puts "#{Shellwords.shellescape(subRunSTWScript)}"
            end
            if not subRuns or subRuns["release"]
                outp.puts "#{Shellwords.shellescape(subRunReleaseScript)}"
            end
        end
    }
    compileScript.chmod(0755)
    if expectedReturn != "compileFailure" and expectedReturn != "compileOnly" and
      expectedReturn != "linkFailure"
        justRunScript.chmod(0755)
        justRunReleaseScript.chmod(0755)
        subRunScript.chmod(0755)
        subRunScribbleScript.chmod(0755)
        subRunSTWScript.chmod(0755)
        subRunReleaseScript.chmod(0755)
    end
    runScript.chmod(0755)
    if manifest["slow"]
        $tests.unshift runScript
    else
        $tests << runScript
    end
}

File.open("filc/tests/testmakefile", "w") {
    | outp |
    outp.print "all:"
    $tests.each_with_index {
        | test, index |
        outp.print " .t#{index}"
    }
    outp.puts
    $tests.each_with_index {
        | test, index |
        outp.puts ".t#{index}:"
        if $verbose
            outp.puts "\t@#{Shellwords.shellescape(test)}"
            outp.puts "\t@echo #{test}: success"
        else
            outp.puts "\t@#{Shellwords.shellescape(test)}"
            outp.puts "\t@echo -n ."
        end
    }
}

if $runTests
    raise unless system("#{$make} -k -f filc/tests/testmakefile -j #{Etc.nprocessors}")
    puts "SUCCESS"
end


