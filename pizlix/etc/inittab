# Begin /etc/inittab

# The text-boot inittab: boots to a text login prompt on tty1 in runlevel 3.
#
# This is the inittab that every pizlix build stage through postlc11 gets.
# build_copy_stuff.sh stages it into /sources/etc (so it is part of every
# stage tarball) and build_postlc_sub2_chroot_part2.sh installs it into /etc
# in the postlc chroot.  Because every build stage must produce a bootable
# snapshot, this file must not reference anything that does not exist yet:
# the display-manager pieces (/etc/rc.d/init.d/xdm, /etc/sysconfig/xdm, and
# gdm itself) are only installed in postlc12, and an x:5:respawn entry
# pointing at /etc/rc.d/init.d/xdm makes init log
#   INIT: cannot execute "/etc/rc.d/init.d/xdm"
# forever and the stage never reaches a login prompt.
#
# postlc12 (the login-manager stage) switches the system to graphical boot:
# build_postlc12.sh stages etc/inittab-gdm over /sources/etc/inittab and
# build_postlc12_chroot_setup_scripts_for_gdm.sh installs it, replacing this
# file with the runlevel-5 (GDM) configuration.  Runlevel 3 stays the full
# text-mode path (six gettys, no display manager) in both configurations,
# and `init 3` / `init 5` switch between them.
id:3:initdefault:
si::sysinit:/etc/rc.d/init.d/rc S
l0:0:wait:/etc/rc.d/init.d/rc 0
l1:S1:wait:/etc/rc.d/init.d/rc 1
l2:2:wait:/etc/rc.d/init.d/rc 2
l3:3:wait:/etc/rc.d/init.d/rc 3
l4:4:wait:/etc/rc.d/init.d/rc 4
l5:5:wait:/etc/rc.d/init.d/rc 5
l6:6:wait:/etc/rc.d/init.d/rc 6
ca:12345:ctrlaltdel:/sbin/shutdown -t1 -a -r now
su:S06:once:/sbin/sulogin
s1:1:respawn:/sbin/sulogin
1:2345:respawn:/sbin/agetty --noclear tty1 9600
2:2345:respawn:/sbin/agetty tty2 9600
3:2345:respawn:/sbin/agetty tty3 9600
4:2345:respawn:/sbin/agetty tty4 9600
5:2345:respawn:/sbin/agetty tty5 9600
6:2345:respawn:/sbin/agetty tty6 9600
# End /etc/inittab
