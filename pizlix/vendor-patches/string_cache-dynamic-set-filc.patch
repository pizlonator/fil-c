+// Fil-C port: the dynamic-atom set used parking_lot::Mutex, whose blocking
+// slow path (parking_lot_core's WordLock) packs the waiter-queue head into
+// the lock word as a plain usize and casts it back with `as *const
+// ThreadData` on every unlock-with-waiters.  Under Fil-C an
+// integer-to-pointer cast has no pointer capability, so the first queue
+// walk with waiters queued panics ("cannot read pointer with null object").
+// First seen in GNOME Shell: its icon-load thread pool contends on the
+// DYNAMIC_SET buckets while SVG icons parse, and the queue-walk dereference
+// in WordLock::unlock_slow trapped inside librsvg.  std::sync::Mutex is the
+// pizlonated glibc pthread mutex -- plain C, no integer-to-pointer round
+// trips.  Poisoning is recovered from: the set's critical sections are
+// short and its linked-list invariants hold even when a guard's scope
+// unwinds.
+use std::sync::Mutex;
+
 const NB_BUCKETS: usize = 1 << 12; // 4096
 const BUCKET_MASK: u32 = (1 << 12) - 1;
 
