return:
  success
optFlags: -O
extraArgs:
  - "--edition"
  - "2021"
output-includes:
  - "vv total = 6 mid = e"
  - "clone paths = ab/C/def"
  - "0 = node0 leaf0 0"
  - "2 = none"
  - "3 = node3 leaf3 33"
  - "branch clone same = true"
  - "branch = L2 9"
  - "grown = L1,L2,L3 107 3"
  - "opt none = true prev leaves = 3"
