# A safe Rust panic now unwinds out of main on the Fil-C runtime's unwinder:
# the message is printed, then lang_start_internal's catch_unwind catches it
# and std exits with the Rust panic exit code 101.  No abort, no
# "filc panic: user thwarted themselves." (that's the -C panic=abort path,
# covered by safe_panic_abort).
return:
  exit101
output-includes:
  - "panicked at"
  - "index out of bounds: the len is 3 but the index is 10"
output-excludes:
  - "Not implemented"
  - "user thwarted"
