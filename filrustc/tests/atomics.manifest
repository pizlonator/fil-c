- 'AtomicI16: uniform = true add_old = 10 sub_old = 13 cas = true weak = true update = true'
- 'AtomicU16: uniform = true add_old = 10 sub_old = 13 cas = true weak = true update = true'
- 'AtomicI32: uniform = true add_old = 10 sub_old = 13 cas = true weak = true update = true'
- 'AtomicU32: uniform = true add_old = 10 sub_old = 13 cas = true weak = true update = true'
- 'AtomicI64: uniform = true add_old = 10 sub_old = 13 cas = true weak = true update = true'
- 'AtomicU64: uniform = true add_old = 10 sub_old = 13 cas = true weak = true update = true'
- 'AtomicIsize: uniform = true add_old = 10 sub_old = 13 cas = true weak = true update = true'
