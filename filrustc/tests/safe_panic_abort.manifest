# -C panic=abort still works with the unwind std: the message is printed and
# then the abort runs through Fil-C's normal user-error abort path ("filc
# user error: abort(3) called" + "filc panic: user thwarted themselves."),
# which is the "failure" exit code (42 under the harness's
# FILC_EXIT_ON_PANIC=1).
return:
  failure
output-includes:
  - "panicked at"
  - "index out of bounds: the len is 3 but the index is 10"
  - "filc panic: user thwarted themselves."
output-excludes:
  - "Not implemented"
extraArgs:
  - "-C"
  - "panic=abort"
