return:
  success
optFlags: -O
extraArgs:
  - "--edition"
  - "2021"
output-includes:
  - "taken empty = Empty taken = true"
  - "prev pair = L R"
  - "now = true"
  - "eq = true neq = true"
  - "text plain"
  - "list x+y+z"
  - "pair pq"
  - "words w1|w2|w3"
  - "empty"
  - "ok = list deep"
  - "err = bad input"
