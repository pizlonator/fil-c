  - "recs = n0 n0 n1 n10 n11 n12 n13 n14 n15 n16 n17 n18 n19 n2 n20 n21 n22 n23 n24 n25 n26 n27 n28 n3 n4 n5 n6 n7 n8 n9"
  - "stable-ish = true"
