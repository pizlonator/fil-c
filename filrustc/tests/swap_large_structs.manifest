return:
  success
optFlags: -O
extraArgs:
  - "--edition"
  - "2021"
output-includes:
  - "size = 72"
  - "pair: bb#2*2[2,3,4,5] aa#1*1[1,2,3,4]"
  - "array0: ee#5*5[5,6,7,8]"
  - "array2: cc#3*3[3,4,5,6]"
  - "vec: hh#8*8[8,9,10,11] | gg#7*7[7,8,9,10] | ff#6*6[6,7,8,9]"
  - "shuffled: ii#9*9[9,10,11,12] | jj#10*10[10,11,12,13] | kk#11*11[11,12,13,14] | ll#12*12[12,13,14,15]"
